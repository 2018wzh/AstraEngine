// Settings category card and row components for the settings center - M3 Styled.

import { Theme } from "../theme.slint";
import { Icon } from "./icons.slint";

// A settings category item in the left panel
export component SettingsCategoryItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> description;
    in property <bool> active: false;
    callback clicked();

    height: 60px;
    border-radius: Theme.shape-md;
    background: active
        ? Theme.primary-container
        : (cat-area.pressed
            ? Theme.surface-container-highest
            : (cat-area.has-hover ? Theme.surface-container-high : transparent));
    border-width: active ? 1px : 0px;
    border-color: Theme.primary;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        Icon {
            glyph: icon;
            font-size: 20px;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 28px;
            color: active
                ? Theme.on-primary-container
                : (cat-area.has-hover ? Theme.on-surface : Theme.on-surface-variant);
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: label;
                color: active
                    ? Theme.on-primary-container
                    : (cat-area.has-hover ? Theme.on-surface : Theme.on-surface);
                font-size: Theme.font-body-md;
                font-weight: active ? 600 : 500;
            }
            Text {
                text: description;
                color: active ? Theme.on-primary-container : Theme.on-surface-variant;
                font-size: Theme.font-label-md;
                overflow: elide;
            }
        }
    }

    cat-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A settings section header within a sub-page
export component SettingsSectionHeader inherits Rectangle {
    in property <string> title;

    height: 36px;

    Text {
        text: title;
        color: Theme.on-surface;
        font-size: Theme.font-title-md;
        font-weight: 700;
        vertical-alignment: center;
    }
}

// A labeled settings row with a control area
export component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;

    min-height: hint != "" ? 56px : 44px;

    VerticalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;
        alignment: center;

        Text {
            text: label;
            color: Theme.on-surface-variant;
            font-size: Theme.font-body-sm;
        }

        @children
    }
}

// A divider line between settings sections
export component SettingsDivider inherits Rectangle {
    height: 1px;
    background: Theme.outline-variant;
}
