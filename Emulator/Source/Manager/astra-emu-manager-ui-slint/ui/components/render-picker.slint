import { MaterialPalette, MaterialText, MaterialTypography, TextField } from "@material";
import { Choice } from "../globals.slint";
import { ChoiceSelect } from "./select.slint";

component ExtentField inherits TextField {
    in property <int> stored;
    callback commit(value: int);

    property <bool> focused: self.has-focus;

    input-type: InputType.number;
    text: root.stored > 0 ? root.stored : "";

    function submit() {
        if self.text.is-float() {
            let v = round(self.text.to-float());
            if v != root.stored {
                root.commit(v);
            }
        }
        self.text = root.stored > 0 ? root.stored : "";
    }

    accepted(text) => { root.submit(); }
    changed focused => {
        if !self.focused {
            root.submit();
        }
    }
    changed stored => {
        if !self.has-focus {
            self.text = root.stored > 0 ? root.stored : "";
        }
    }
}

export component RenderPicker {
    in property <bool> supported;
    in property <[Choice]> options;
    in property <string> mode: "default";
    in property <int> custom-width;
    in property <int> custom-height;
    in property <string> min;
    in property <string> max;
    in property <string> note;
    in property <string> error;
    in property <bool> enabled: true;
    in property <string> unsupported-text: "此模拟器不支持调整渲染分辨率，可在 设置→画面滤镜 使用显示滤镜";
    callback set-render(mode: string, width: int, height: int);

    property <bool> picking-custom;
    property <bool> show-custom: root.mode == "custom" || root.picking-custom;
    property <int> draft-width: root.custom-width;
    property <int> draft-height: root.custom-height;

    changed mode => { root.picking-custom = false; }
    changed custom-width => { root.draft-width = root.custom-width; }
    changed custom-height => { root.draft-height = root.custom-height; }

    function submit-custom() {
        if root.draft-width > 0 && root.draft-height > 0 && (root.mode != "custom" || root.draft-width != root.custom-width || root.draft-height != root.custom-height) {
            root.set-render("custom", root.draft-width, root.draft-height);
        }
    }

    VerticalLayout {
        spacing: 8px;

        if !root.supported : MaterialText {
            text: root.unsupported-text;
            style: MaterialTypography.body-medium;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
        }

        if root.supported : ChoiceSelect {
            label: "渲染分辨率";
            choices: root.options;
            value: root.show-custom ? "custom" : root.mode;
            enabled: root.enabled;
            has-error: root.error != "" && !root.show-custom;
            supporting-text: !root.show-custom ? root.error : "";
            selected(id) => {
                if id == "custom" {
                    root.picking-custom = true;
                    root.submit-custom();
                } else {
                    root.picking-custom = false;
                    root.set-render(id, 0, 0);
                }
            }
        }

        if root.supported && root.show-custom : HorizontalLayout {
            spacing: 12px;
            ExtentField {
                horizontal-stretch: 1;
                label: "宽";
                stored: root.draft-width;
                enabled: root.enabled;
                has-error: root.error != "";
                commit(value) => {
                    root.draft-width = value;
                    root.submit-custom();
                }
            }
            MaterialText {
                horizontal-stretch: 0;
                text: "×";
                style: MaterialTypography.title-medium;
                color: MaterialPalette.on-surface-variant;
                vertical-alignment: center;
            }
            ExtentField {
                horizontal-stretch: 1;
                label: "高";
                stored: root.draft-height;
                enabled: root.enabled;
                has-error: root.error != "";
                commit(value) => {
                    root.draft-height = value;
                    root.submit-custom();
                }
            }
        }

        if root.supported && root.show-custom : MaterialText {
            text: root.error != "" ? root.error : root.min != "" ? "支持范围 " + root.min + " – " + root.max : "";
            style: MaterialTypography.body-small;
            color: root.error != "" ? MaterialPalette.error : MaterialPalette.on-surface-variant;
            wrap: word-wrap;
        }

        if root.supported && root.note != "" : MaterialText {
            text: root.note;
            style: MaterialTypography.body-small;
            color: MaterialPalette.on-surface-variant;
            wrap: word-wrap;
        }
    }
}
