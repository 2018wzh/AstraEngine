// Sidebar grouped navigation component.
// Desktop: M3 Navigation Drawer with stadium active indicator.
// Mobile: M3 Navigation Bar with active pill container.

import { Theme } from "../theme.slint";
import { Icon, Icons } from "./icons.slint";

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    callback clicked();

    height: 44px;
    border-radius: 22px;
    background: active
        ? Theme.primary-container
        : (item-area.pressed
            ? Theme.surface-container-highest
            : (item-area.has-hover ? Theme.surface-container-high : transparent));
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: start;

        Icon {
            glyph: icon;
            font-size: 16px;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 22px;
            color: active
                ? Theme.on-primary-container
                : (item-area.has-hover ? Theme.on-surface : Theme.on-surface-variant);
            animate color { duration: 150ms; }
        }

        Text {
            text: label;
            color: active
                ? Theme.on-primary-container
                : (item-area.has-hover ? Theme.on-surface : Theme.on-surface-variant);
            font-size: Theme.font-label-lg;
            font-weight: active ? 600 : 500;
            vertical-alignment: center;
            animate color { duration: 150ms; }
        }
    }

    item-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    in property <string> current-page: "library";
    in property <bool> dark-mode: true;
    callback navigate(string);
    callback toggle-theme();

    background: Theme.surface-container-low;
    border-width: 0px;
    width: Theme.sidebar-width;

    VerticalLayout {
        padding-top: 24px;
        padding-bottom: 20px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;

        // App title & badge
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            alignment: start;

            Text {
                text: "AstraEMU";
                color: Theme.on-surface;
                font-size: Theme.font-title-lg;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                width: 44px;
                height: 20px;
                border-radius: Theme.shape-xs;
                background: Theme.primary-container;
                y: (parent.height - self.height) / 2;

                Text {
                    text: "CORE";
                    color: Theme.on-primary-container;
                    font-size: Theme.font-label-sm;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 16px; }

        // Group: 游戏
        HorizontalLayout {
            height: 20px;
            padding-left: 14px;
            Text {
                text: "游戏管理";
                color: Theme.on-surface-variant;
                font-size: Theme.font-label-md;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        SidebarItem {
            label: "游戏库";
            icon: Icons.gamepad;
            active: current-page == "library";
            clicked => { root.navigate("library"); }
        }


        Rectangle { height: 12px; }

        // Group: 系统
        HorizontalLayout {
            height: 20px;
            padding-left: 14px;
            Text {
                text: "系统与设置";
                color: Theme.on-surface-variant;
                font-size: Theme.font-label-md;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        SidebarItem {
            label: "设置中心";
            icon: Icons.gear;
            active: current-page == "settings";
            clicked => { root.navigate("settings"); }
        }

        SidebarItem {
            label: "关于 AstraEMU";
            icon: Icons.circle-info;
            active: current-page == "about";
            clicked => { root.navigate("about"); }
        }

        Rectangle { vertical-stretch: 1; }

        // Theme toggle at bottom
        Rectangle {
            height: 1px;
            background: Theme.outline-variant;
        }
        Rectangle { height: 8px; }

        SidebarItem {
            label: dark-mode ? "浅色外观" : "深色外观";
            icon: dark-mode ? Icons.sun : Icons.moon;
            active: false;
            clicked => { root.toggle-theme(); }
        }
    }

    // Right border separator
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Theme.outline-variant;
    }
}

component BottomNavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        // M3 Active pill indicator
        Rectangle {
            width: 56px;
            height: 30px;
            border-radius: 15px;
            background: active ? Theme.primary-container : transparent;
            x: (parent.width - self.width) / 2;
            animate background { duration: 150ms; }

            Icon {
                glyph: icon;
                font-size: 17px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: active ? Theme.on-primary-container : Theme.on-surface-variant;
            }
        }

        Text {
            text: label;
            font-size: Theme.font-label-md;
            color: active ? Theme.primary : Theme.on-surface-variant;
            horizontal-alignment: center;
            font-weight: active ? 600 : 500;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Bottom navigation bar for mobile layout (M3 76dp height)
export component BottomNav inherits Rectangle {
    in property <string> current-page: "library";
    callback navigate(string);

    background: Theme.surface-container;
    height: 72px;
    border-width: 1px;
    border-color: Theme.outline-variant;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;

        BottomNavItem {
            label: "游戏库";
            icon: Icons.gamepad;
            active: current-page == "library";
            clicked => { root.navigate("library"); }
        }
        BottomNavItem {
            label: "设置";
            icon: Icons.gear;
            active: current-page == "settings";
            clicked => { root.navigate("settings"); }
        }
        BottomNavItem {
            label: "关于";
            icon: Icons.circle-info;
            active: current-page == "about";
            clicked => { root.navigate("about"); }
        }
    }
}
