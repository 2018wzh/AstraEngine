import { Theme, Accent } from "../theme.slint";
import { App, GameCard } from "../globals.slint";
import { Icon, Icons } from "./icons.slint";
import { CoverBadge, IconBtn } from "./controls.slint";

export component CoverCard inherits Rectangle {
    in property <GameCard> game;
    in property <bool> selected: false;
    in property <bool> cover-needed;
    callback activated();
    callback launch();
    callback cover-demand(string, bool);

    private property <string> cover-id: game.id;
    private property <string> demanded-id;
    property <bool> hovered: card-area.has-hover;
    property <Accent> ring: Theme.accent(game.tint.alpha > 0 ? game.tint : Theme.primary, App.dark);

    function report-cover() {
        if root.demanded-id != root.cover-id && root.demanded-id != "" {
            root.cover-demand(root.demanded-id, false);
        }
        root.demanded-id = root.cover-id;
        root.cover-demand(root.cover-id, root.cover-needed);
    }
    init => { root.report-cover(); }
    changed cover-needed => { root.report-cover(); }
    changed cover-id => { root.report-cover(); }

    background: transparent;
    accessible-role: button;
    accessible-id: "library-case-" + game.id;
    accessible-label: game.title + ", " + game.family;
    accessible-description: game.problem == "" ? "可以启动" : game.problem;
    accessible-action-default => { root.activated(); }

    card-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activated();
                return accept;
            }
            return reject;
        }
        card-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                card-focus.focus();
                root.activated();
            }
        }
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        spacing: 8px;
        poster := Rectangle {
            height: self.width * 4 / 3;
            border-radius: Theme.r-md;
            clip: true;
            border-width: root.selected ? 3px : 0px;
            border-color: root.ring.primary;
            drop-shadow-blur: root.hovered || root.selected ? 16px : 8px;
            drop-shadow-offset-y: root.hovered || root.selected ? 8px : 4px;
            drop-shadow-color: Theme.shadow;
            animate drop-shadow-blur, drop-shadow-offset-y { duration: Theme.motion-fast; }

            if game.cover.width > 0 : Image {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                source: game.cover;
                image-fit: cover;
            }
            if game.cover.width == 0 : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(160deg, Theme.primary-container 0%, Theme.surface-high 100%);
                Icon {
                    x: 0px;
                    y: parent.height * 0.28;
                    width: parent.width;
                    height: 36px;
                    glyph: Icons.image;
                    font-size: 28px;
                    color: Theme.on-primary-container;
                    opacity: 0.35;
                }
                Text {
                    x: 12px;
                    y: parent.height - 28px;
                    width: parent.width - 24px;
                    text: game.family;
                    color: Theme.on-variant;
                    font-size: Theme.label;
                    font-weight: 600;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            if game.compat != "" && App.appearance.cover-badges : CoverBadge {
                x: 8px;
                y: 8px;
                status: game.compat;
            }
            if game.problem != "" : Rectangle {
                x: parent.width - self.width - 8px;
                y: 8px;
                height: 22px;
                width: fail-label.preferred-width + 16px;
                border-radius: 11px;
                background: Theme.error;
                fail-label := Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: "无法启动";
                    color: #ffffff;
                    font-size: Theme.label-sm;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: game.title;
            color: Theme.on-surface;
            font-size: Theme.title-sm;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: game.problem != "" ? game.problem : (game.family + " · " + (game.play-time != "" ? game.play-time : "未开始"));
            color: game.problem != "" ? Theme.error : Theme.on-variant;
            font-size: Theme.body-sm;
            overflow: elide;
        }
    }

    if root.hovered || root.selected : IconBtn {
        x: parent.width - 56px;
        y: parent.width * 4 / 3 - 56px;
        z: 2;
        glyph: Icons.play;
        label: "开始游戏";
        variant: "filled";
        size: 48px;
        enabled: game.problem == "";
        clicked => { root.launch(); }
    }
}
