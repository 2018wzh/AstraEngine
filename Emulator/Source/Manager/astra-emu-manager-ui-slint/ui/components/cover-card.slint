// Game cover card component - evolved from the legacy CoverCard.

import { Theme } from "../theme.slint";

export struct GameCard {
    case-id: string,
    title: string,
    family: string,
    cover-uri: string,
    cover: image,
    diagnostic: string,
    play-time: string,
    last-played: string,
    // Compatibility grade: "" | "perfect" | "completable" | "flawed" | "boot_only" | "unplayable".
    compatibility-status: string,
}

export component CoverCard inherits Rectangle {
    in property <GameCard> game;
    in property <bool> selected: false;
    callback activated(string);

    background: selected ? Theme.card-hover : Theme.surface-raised;
    border-radius: Theme.radius;
    border-width: selected || card-focus.has-focus ? 2px : 0px;
    border-color: Theme.primary;
    accessible-role: button;
    accessible-id: "library-case-" + game.case-id;
    accessible-label: game.title + ", " + game.family;
    accessible-description: game.diagnostic == "" ? "Launchable legacy game" : game.diagnostic;
    accessible-action-default => { root.activated(game.case-id); }
    min-width: 148px;
    min-height: 224px;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        Rectangle {
            background: #313846;
            border-radius: Theme.radius-sm;
            min-height: 142px;

            if game.cover-uri != "" : Image {
                source: game.cover;
                image-fit: cover;
            }
            if game.cover-uri == "" : Text {
                text: "NO COVER";
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Compatibility badge overlay (top-right of the cover).
            if game.compatibility-status != "" : Rectangle {
                x: parent.width - self.width - 6px;
                y: 6px;
                width: badge-label.preferred-width + 12px;
                height: 18px;
                border-radius: 4px;
                background: game.compatibility-status == "perfect" ? #2ea043
                    : game.compatibility-status == "completable" ? #1f6feb
                    : game.compatibility-status == "flawed" ? #d29922
                    : game.compatibility-status == "boot_only" ? #db6d28
                    : #da3633;

                badge-label := Text {
                    text: game.compatibility-status == "perfect" ? "Perfect"
                        : game.compatibility-status == "completable" ? "Completable"
                        : game.compatibility-status == "flawed" ? "Flawed"
                        : game.compatibility-status == "boot_only" ? "Boot only"
                        : "Unplayable";
                    color: #ffffff;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: game.title;
            color: Theme.text;
            font-weight: 600;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: game.family;
                color: Theme.text-muted;
                font-size: 12px;
            }
            if game.play-time != "" : Text {
                text: "· " + game.play-time;
                color: Theme.text-muted;
                font-size: 11px;
            }
        }

        if game.last-played != "" : Text {
            text: game.last-played;
            color: Theme.text-muted;
            font-size: 11px;
            overflow: elide;
        }

        if game.diagnostic != "" : Text {
            text: game.diagnostic;
            color: Theme.danger;
            font-size: 11px;
            overflow: elide;
        }
    }

    card-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activated(game.case-id);
                return accept;
            }
            return reject;
        }

        TouchArea {
            clicked => { root.activated(game.case-id); }
        }
    }
}
