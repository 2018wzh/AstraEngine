import { MaterialPalette, MaterialText, MaterialTypography, Icon, IconButton, FilledIconButton, PopupMenu } from "@material";
import { App, GameCard, Library, GameSettings } from "../globals.slint";
import { Icons } from "../icons.slint";
import { Theme } from "../theme.slint";

// Opens game settings at `section` for `id` (shared by the library and the detail panel).
export global GameNav {
    public function open-settings(id: string, section: string) {
        GameSettings.section = section;
        Library.open-game-settings(id);
        App.page = "game-settings";
    }
}

// Context menu shared by cards, list rows and the detail panel's overflow button.
export component GameMenu {
    in property <length> bound-width;
    in property <length> bound-height;

    property <string> game-id;
    property <bool> ready;
    property <length> menu-x;
    property <length> menu-y;

    width: 0px;
    height: 0px;

    public function open(id: string, can-launch: bool, px: length, py: length) {
        root.game-id = id;
        root.ready = can-launch;
        root.menu-x = max(8px, min(px, root.bound-width - 208px));
        root.menu-y = max(8px, min(py, root.bound-height - 248px));
        menu.show();
    }

    menu := PopupMenu {
        x: root.menu-x;
        y: root.menu-y;
        items: [
            { icon: Icons.play-arrow, text: "开始游戏", enabled: root.ready },
            { icon: Icons.tune, text: "游戏设置", enabled: true },
            { icon: Icons.folder-open, text: "打开所在目录", enabled: true },
            { icon: Icons.delete, text: "从资料库移除", enabled: true },
        ];
        activated(index) => {
            menu.close();
            if index == 0 {
                Library.launch(root.game-id);
            } else if index == 1 {
                GameNav.open-settings(root.game-id, "emulator");
            } else if index == 2 {
                Library.open-folder(root.game-id);
            } else if index == 3 {
                if Library.selected-id == root.game-id {
                    Library.detail-open = false;
                }
                Library.remove(root.game-id);
            }
        }
    }
}

// Compatibility status pill; `on-image` uses a dark backing for legibility over cover art.
export component CompatPill {
    in property <string> status;
    in property <bool> on-image;

    height: 24px;
    width: row.preferred-width;
    accessible-role: AccessibleRole.text;
    accessible-label: "兼容性：" + Theme.status-label(root.status);

    Rectangle {
        border-radius: 12px;
        background: root.on-image ? #000000b0 : Theme.status-color(root.status).with-alpha(0.16);
    }

    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.status-color(root.status);
            }
        }

        MaterialText {
            text: Theme.status-label(root.status);
            style: MaterialTypography.label-medium;
            color: root.on-image ? #ffffff : MaterialPalette.on-surface;
            vertical-alignment: center;
        }
    }
}

// Pointer, touch and keyboard behaviour shared by grid cards and list rows.
// Click: activated; double-click / Enter: launch; Space: activated;
// right-click, 500 ms touch hold, Menu key or Shift+F10: context-menu (local coordinates);
// arrow keys: navigate.
export component GameInteraction {
    in property <bool> focus-wanted;
    in property <string> label;
    in property <string> description;
    out property <bool> has-focus: scope.has-focus;
    out property <bool> hovered: touch.has-hover;
    callback activated();
    callback launch();
    callback context-menu(x: length, y: length);
    callback navigate(dx: int, dy: int);
    callback focused();

    property <bool> long-fired;
    property <length> press-x;
    property <length> press-y;
    property <bool> focus-state: scope.has-focus;

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-action-default => { root.activated(); }

    changed focus-wanted => {
        if root.focus-wanted && !scope.has-focus {
            scope.focus();
        }
    }
    changed focus-state => {
        if root.focus-state {
            root.focused();
        }
    }

    scope := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if event.text == Key.Return {
                root.launch();
                return accept;
            }
            if event.text == " " {
                root.activated();
                return accept;
            }
            if event.text == Key.Menu || (event.modifiers.shift && event.text == Key.F10) {
                root.context-menu(root.width / 2, root.height / 2);
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.navigate(-1, 0);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.navigate(1, 0);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.navigate(0, -1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.navigate(0, 1);
                return accept;
            }
            reject
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if root.long-fired {
                    root.long-fired = false;
                } else {
                    scope.focus();
                    root.activated();
                }
            }
            double-clicked => { root.launch(); }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.long-fired = false;
                    if event.button == PointerEventButton.right {
                        scope.focus();
                        root.context-menu(self.mouse-x, self.mouse-y);
                    } else if event.touch-finger-id != 0 {
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                        hold.restart();
                    }
                }
                if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    hold.running = false;
                }
            }
            moved => {
                if hold.running && (abs(self.mouse-x - root.press-x) > 10px || abs(self.mouse-y - root.press-y) > 10px) {
                    hold.running = false;
                }
            }
        }
    }

    hold := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.long-fired = true;
            scope.focus();
            root.context-menu(root.press-x, root.press-y);
        }
    }
}

// Reports cover visibility for one row of the library model (see `CoverModel::demand`).
component CoverDemand {
    in property <string> cover-id;
    in property <bool> cover-needed;
    callback cover-demand(id: string, needed: bool);

    property <string> demanded-id;

    function report() {
        if root.demanded-id != root.cover-id && root.demanded-id != "" {
            root.cover-demand(root.demanded-id, false);
        }
        root.demanded-id = root.cover-id;
        root.cover-demand(root.cover-id, root.cover-needed);
    }
    init => { root.report(); }
    changed cover-needed => { root.report(); }
    changed cover-id => { root.report(); }

    width: 0px;
    height: 0px;
}

export component CoverCard {
    in property <GameCard> game;
    in property <bool> selected;
    in property <bool> cover-needed;
    in property <bool> focus-wanted;
    callback activated();
    callback launch();
    callback context-menu(x: length, y: length);
    callback navigate(dx: int, dy: int);
    callback focused();
    callback cover-demand(id: string, needed: bool);

    property <length> poster-height: root.width * 4 / 3;
    property <bool> active: input.hovered || input.has-focus || root.selected;
    property <bool> has-cover: root.game.cover.width > 0;
    property <bool> show-badge: App.appearance.cover-badges && root.game.compat != "" && root.game.compat != "unknown";

    CoverDemand {
        cover-id: root.game.id;
        cover-needed: root.cover-needed;
        cover-demand(id, needed) => { root.cover-demand(id, needed); }
    }

    Rectangle {
        x: -4px;
        y: -4px;
        width: root.width + 8px;
        height: root.poster-height + 8px;
        border-radius: 16px;
        border-width: 2px;
        border-color: MaterialPalette.primary;
        visible: input.has-focus;
    }

    poster := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.poster-height;
        border-radius: 12px;
        clip: true;
        background: MaterialPalette.surface-container-high;
        drop-shadow-blur: root.active ? 12px : 3px;
        drop-shadow-offset-y: root.active ? 6px : 1px;
        drop-shadow-color: MaterialPalette.shadow-30;
        animate drop-shadow-blur, drop-shadow-offset-y { duration: Theme.motion-short; }

        if root.has-cover : Image {
            x: 0px;
            y: 0px;
            width: poster.width;
            height: poster.height;
            source: root.game.cover;
            image-fit: cover;
        }

        if !root.has-cover : Rectangle {
            x: 0px;
            y: 0px;
            width: poster.width;
            height: poster.height;
            background: @linear-gradient(160deg, MaterialPalette.primary-container 0%, MaterialPalette.surface-container-highest 100%);

            Image {
                x: (poster.width - self.width) / 2;
                y: (poster.height - self.height) / 2;
                width: 40px;
                height: 40px;
                source: Icons.image;
                colorize: MaterialPalette.on-primary-container;
                opacity: 0.4;
            }
        }

        if root.show-badge : CompatPill {
            x: 8px;
            y: 8px;
            status: root.game.compat;
            on-image: true;
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.poster-height;
        border-radius: 12px;
        border-width: root.selected ? 3px : 0px;
        border-color: MaterialPalette.primary;
    }

    VerticalLayout {
        x: 0px;
        y: root.poster-height + 8px;
        width: root.width;
        height: root.height - root.poster-height - 8px;
        alignment: start;
        spacing: 2px;

        MaterialText {
            text: root.game.title;
            style: MaterialTypography.title-small;
            color: MaterialPalette.on-surface;
        }

        HorizontalLayout {
            spacing: 4px;

            if root.game.problem != "" : VerticalLayout {
                alignment: center;
                Icon {
                    width: 14px;
                    source: Icons.warning;
                    colorize: MaterialPalette.error;
                }
            }

            MaterialText {
                horizontal-stretch: 1;
                text: root.game.problem != "" ? root.game.problem : root.game.subtitle;
                style: MaterialTypography.body-small;
                color: MaterialPalette.on-surface-variant;
            }
        }
    }

    input := GameInteraction {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        focus-wanted: root.focus-wanted;
        label: root.game.title + "，" + root.game.subtitle;
        description: root.game.problem != "" ? root.game.problem : "可以启动";
        activated => { root.activated(); }
        launch => { root.launch(); }
        context-menu(x, y) => { root.context-menu(x, y); }
        navigate(dx, dy) => { root.navigate(dx, dy); }
        focused => { root.focused(); }
    }

    if root.active && root.game.ready : FilledIconButton {
        x: root.width - self.width - 8px;
        y: root.poster-height - self.height - 8px;
        icon: Icons.play-arrow;
        tooltip: "开始游戏";
        clicked => { root.launch(); }
    }
}

export component GameListRow {
    in property <GameCard> game;
    in property <bool> selected;
    in property <bool> cover-needed;
    in property <bool> focus-wanted;
    in property <bool> compact-row;
    // Column widths; 0px hides the column.
    in property <length> engine-width;
    in property <length> compat-width;
    in property <length> time-width;
    in property <length> last-width;
    callback activated();
    callback launch();
    callback context-menu(x: length, y: length);
    callback navigate(dx: int, dy: int);
    callback focused();
    callback cover-demand(id: string, needed: bool);

    property <bool> has-cover: root.game.cover.width > 0;
    property <string> second-line: root.game.problem != "" ? root.game.problem
        : root.compact-row ? root.game.subtitle + (root.game.play-time != "" ? " · " + root.game.play-time : "")
        : root.engine-width == 0px ? root.game.subtitle : "";

    height: Theme.compact-density || root.compact-row ? 56px : 64px;

    CoverDemand {
        cover-id: root.game.id;
        cover-needed: root.cover-needed;
        cover-demand(id, needed) => { root.cover-demand(id, needed); }
    }

    Rectangle {
        border-radius: 12px;
        background: root.selected ? MaterialPalette.secondary-container
            : input.hovered ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-hover)
            : transparent;
        border-width: input.has-focus ? 2px : 0px;
        border-color: MaterialPalette.primary;
    }

    input := GameInteraction {
        width: 100%;
        height: 100%;
        focus-wanted: root.focus-wanted;
        label: root.game.title + "，" + root.game.subtitle;
        description: root.game.problem != "" ? root.game.problem : "可以启动";
        activated => { root.activated(); }
        launch => { root.launch(); }
        context-menu(x, y) => { root.context-menu(x, y); }
        navigate(dx, dy) => { root.navigate(dx, dy); }
        focused => { root.focused(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 48px;
                border-radius: 4px;
                clip: true;
                background: MaterialPalette.surface-container-highest;

                if root.has-cover : Image {
                    width: 100%;
                    height: 100%;
                    source: root.game.cover;
                    image-fit: cover;
                }
                if !root.has-cover : Icon {
                    width: 18px;
                    source: Icons.image;
                    colorize: MaterialPalette.on-surface-variant;
                    opacity: 0.6;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            MaterialText {
                text: root.game.title;
                style: MaterialTypography.title-small;
                color: root.selected ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface;
            }
            if root.second-line != "" : MaterialText {
                text: root.second-line;
                style: MaterialTypography.body-small;
                color: root.game.problem != "" ? MaterialPalette.error : MaterialPalette.on-surface-variant;
            }
        }

        if root.engine-width > 0px : MaterialText {
            width: root.engine-width;
            text: root.game.subtitle;
            style: MaterialTypography.body-medium;
            color: MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }

        if root.compat-width > 0px : VerticalLayout {
            width: root.compat-width;
            alignment: center;
            HorizontalLayout {
                alignment: start;
                CompatPill { status: root.game.compat; }
            }
        }

        if root.time-width > 0px : MaterialText {
            width: root.time-width;
            text: root.game.play-time != "" ? root.game.play-time : "—";
            style: MaterialTypography.body-medium;
            color: MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }

        if root.last-width > 0px : MaterialText {
            width: root.last-width;
            text: root.game.last-played != "" ? root.game.last-played : "从未";
            style: MaterialTypography.body-medium;
            color: MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.play-arrow;
                tooltip: "开始游戏";
                enabled: root.game.ready;
                clicked => { root.launch(); }
            }
        }
    }
}

// Sortable list column header; mouse and Enter/Space activate it.
export component SortHeader {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 40px;
    accessible-role: button;
    accessible-label: root.label + (root.active ? "（当前排序）" : "");
    accessible-action-default => { root.clicked(); }

    focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.clicked();
            }
        }
    }

    Rectangle {
        border-radius: 8px;
        background: touch.has-hover ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-hover) : transparent;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: MaterialPalette.primary;
    }

    HorizontalLayout {
        spacing: 2px;
        MaterialText {
            horizontal-stretch: 0;
            text: root.label;
            style: MaterialTypography.label-large;
            color: root.active ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }
        if root.active : VerticalLayout {
            alignment: center;
            Icon {
                width: 20px;
                source: Icons.arrow-drop-down;
                colorize: MaterialPalette.primary;
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
