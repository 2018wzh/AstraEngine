import { Switch } from "std-widgets.slint";
import { Theme, Accent } from "../theme.slint";
import { Icon, Icons } from "./icons.slint";

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> variant: "filled";
    in property <color> fill: Theme.primary;
    in property <color> on-fill: Theme.on-primary;
    in property <bool> enabled: true;
    in property <length> h: 40px;
    callback clicked();

    height: h;
    min-width: content.preferred-width;
    border-radius: self.height / 2;
    opacity: enabled ? 1 : 0.38;
    accessible-role: button;
    accessible-label: text != "" ? text : "按钮";
    accessible-action-default => { if root.enabled { root.clicked(); } }

    property <bool> hovered: area.has-hover;
    property <color> danger-fill: Theme.error;
    property <color> glyph-color: variant == "filled" ? on-fill
        : variant == "danger" ? #ffffff
        : variant == "text" ? fill
        : Theme.on-surface;

    background: variant == "filled" ? (hovered ? fill.mix(on-fill, 0.92) : fill)
        : variant == "danger" ? (hovered ? danger-fill.mix(#ffffff, 0.92) : danger-fill)
        : variant == "tonal" ? (hovered ? Theme.surface-highest : Theme.surface-high)
        : hovered ? Theme.surface-high : transparent;
    border-width: variant == "outlined" || button-focus.has-focus ? 1px : 0px;
    border-color: button-focus.has-focus ? Theme.primary : Theme.outline-variant;
    drop-shadow-blur: variant == "filled" && hovered && enabled ? 6px : 0px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow;

    animate background { duration: Theme.motion-fast; }

    content := HorizontalLayout {
        x: 0px;
        y: 0px;
        height: parent.height;
        padding-left: root.text == "" ? 12px : (root.glyph == "" ? 20px : 16px);
        padding-right: root.text == "" ? 12px : 20px;
        spacing: 8px;
        alignment: center;
        if root.glyph != "" : Icon {
            glyph: root.glyph;
            font-size: Theme.body-sm;
            color: root.glyph-color;
        }
        if root.text != "" : Text {
            text: root.text;
            font-size: Theme.body-sm;
            font-weight: 600;
            vertical-alignment: center;
            color: root.glyph-color;
        }
    }

    button-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.enabled { root.clicked(); }
                return accept;
            }
            return reject;
        }
        area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                button-focus.focus();
                if root.enabled { root.clicked(); }
            }
        }
    }
}

export component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> variant: "standard";
    in property <length> size: 40px;
    in property <bool> active: false;
    in property <color> tint: Theme.on-variant;
    in property <bool> enabled: true;
    callback clicked();

    width: size;
    height: size;
    border-radius: size / 2;
    opacity: enabled ? 1 : 0.38;
    accessible-role: button;
    accessible-label: label != "" ? label : "按钮";
    accessible-action-default => { if root.enabled { root.clicked(); } }

    property <bool> hovered: area.has-hover;

    background: !enabled ? transparent
        : variant == "filled" || active ? Theme.primary-container
        : variant == "tonal" ? (hovered ? Theme.surface-highest : Theme.surface-high)
        : hovered ? Theme.surface-high : transparent;
    border-width: icon-focus.has-focus ? 1px : 0px;
    border-color: Theme.primary;

    animate background { duration: Theme.motion-fast; }

    Icon {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        glyph: root.glyph;
        font-size: root.size * 0.4;
        color: root.variant == "filled" || root.active ? Theme.on-primary-container : root.tint;
    }

    icon-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                if root.enabled { root.clicked(); }
                return accept;
            }
            return reject;
        }
        area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                icon-focus.focus();
                if root.enabled { root.clicked(); }
            }
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "搜索";
    in property <string> shortcut: "";
    in property <length> h: 48px;
    in property <bool> focus-request: false;
    callback edited(string);
    callback cleared();

    height: h;
    border-radius: h / 2;
    background: Theme.surface-high;
    border-width: input.has-focus ? 1px : 0px;
    border-color: Theme.primary;

    changed focus-request => { input.focus(); }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 18px;
        padding-right: 8px;
        spacing: 12px;

        Icon {
            glyph: Icons.search;
            font-size: 15px;
            width: 18px;
            color: Theme.on-variant;
        }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            if root.text == "" : Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Theme.on-variant;
                font-size: Theme.body;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                font-size: Theme.body;
                color: Theme.on-surface;
                single-line: true;
                vertical-alignment: center;
                edited => { root.edited(self.text); }
            }
        }

        if root.text == "" && root.shortcut != "" : Rectangle {
            width: key.preferred-width + 14px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.outline-variant;
            key := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.shortcut;
                color: Theme.on-variant;
                font-size: Theme.label-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.text != "" : IconBtn {
            glyph: Icons.xmark;
            label: "清除";
            size: 32px;
            clicked => {
                root.text = "";
                root.cleared();
            }
        }
    }
}

export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <string> count: "";
    in property <bool> selected: false;
    in property <string> glyph: "";
    callback clicked();

    height: 32px;
    width: row.preferred-width;
    border-radius: Theme.r-sm;
    background: selected ? Theme.primary-container : (area.has-hover ? Theme.surface-high : transparent);
    border-width: selected ? 0px : 1px;
    border-color: Theme.outline-variant;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    animate background { duration: Theme.motion-fast; }

    row := HorizontalLayout {
        x: 0px;
        y: 0px;
        height: parent.height;
        padding-left: root.selected || root.glyph != "" ? 10px : 14px;
        padding-right: 14px;
        spacing: 6px;
        if root.selected : Icon {
            glyph: Icons.check;
            font-size: 11px;
            color: Theme.on-primary-container;
        }
        if !root.selected && root.glyph != "" : Icon {
            glyph: root.glyph;
            font-size: 11px;
        }
        Text {
            text: root.text;
            font-size: Theme.body-sm;
            font-weight: root.selected ? 600 : 500;
            color: root.selected ? Theme.on-primary-container : Theme.on-surface;
            vertical-alignment: center;
        }
        if root.count != "" : Text {
            text: root.count;
            font-size: Theme.label;
            color: root.selected ? Theme.on-primary-container : Theme.on-variant;
            vertical-alignment: center;
        }
    }

    chip-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                chip-focus.focus();
                root.clicked();
            }
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current: 0;
    in property <length> segment-width: 96px;
    callback selected(int);

    height: 40px;
    width: segment-width * items.length;
    border-radius: 20px;
    border-width: 1px;
    border-color: Theme.outline;
    clip: true;

    for item[i] in root.items : Rectangle {
        x: i * root.segment-width;
        y: 0px;
        width: root.segment-width;
        height: parent.height;
        background: i == root.current ? Theme.primary-container : (seg-area.has-hover ? Theme.surface-high : transparent);
        accessible-role: button;
        accessible-label: item;
        accessible-action-default => {
            root.current = i;
            root.selected(i);
        }

        animate background { duration: Theme.motion-fast; }

        if i > 0 : Rectangle {
            x: 0px;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Theme.outline;
        }
        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            alignment: center;
            spacing: 6px;
            if i == root.current : Icon {
                glyph: Icons.check;
                font-size: 11px;
                color: Theme.on-primary-container;
            }
            Text {
                text: item;
                font-size: Theme.body-sm;
                font-weight: i == root.current ? 600 : 500;
                color: i == root.current ? Theme.on-primary-container : Theme.on-surface;
                vertical-alignment: center;
            }
        }

        seg-focus := FocusScope {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " {
                    root.current = i;
                    root.selected(i);
                    return accept;
                }
                return reject;
            }
            seg-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    seg-focus.focus();
                    root.current = i;
                    root.selected(i);
                }
            }
        }
    }
}

export component Tabs inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current: 0;
    in property <color> accent: Theme.primary;
    callback selected(int);

    height: 48px;

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.outline-variant;
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        for item[i] in root.items : Rectangle {
            horizontal-stretch: 1;
            accessible-role: button;
            accessible-label: item;
            accessible-action-default => {
                root.current = i;
                root.selected(i);
            }

            label := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: item;
                font-size: Theme.body;
                font-weight: i == root.current ? 650 : 500;
                color: i == root.current ? root.accent : Theme.on-variant;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if i == root.current : Rectangle {
                width: label.preferred-width + 8px;
                height: 3px;
                x: (parent.width - self.width) / 2;
                y: parent.height - 3px;
                border-top-left-radius: 3px;
                border-top-right-radius: 3px;
                background: root.accent;
            }

            tab-focus := FocusScope {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == " " {
                        root.current = i;
                        root.selected(i);
                        return accept;
                    }
                    return reject;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        tab-focus.focus();
                        root.current = i;
                        root.selected(i);
                    }
                }
            }
        }
    }
}

export component CoverBadge inherits Rectangle {
    in property <string> status;
    height: 22px;
    width: row.preferred-width;
    border-radius: 11px;
    background: #000000a8;
    row := HorizontalLayout {
        x: 0px;
        y: 0px;
        height: parent.height;
        padding-left: 8px;
        padding-right: 9px;
        spacing: 5px;
        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: Theme.accent(Theme.status-seed(root.status), true).primary;
        }
        Text {
            text: Theme.status-label(root.status);
            color: #ffffffee;
            font-size: Theme.label-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> status;
    property <Accent> a: Theme.accent(Theme.status-seed(status), Theme.dark);
    height: 26px;
    width: row.preferred-width;
    border-radius: 13px;
    background: a.container;
    row := HorizontalLayout {
        x: 0px;
        y: 0px;
        height: parent.height;
        padding-left: 10px;
        padding-right: 11px;
        spacing: 6px;
        Icon {
            glyph: root.status == "unplayable" || root.status == "boot_only" ? Icons.triangle : Icons.circle-check;
            font-size: 11px;
            color: root.a.on-container;
        }
        Text {
            text: Theme.status-label(root.status);
            color: root.a.on-container;
            font-size: Theme.label;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> bg: Theme.surface-high;
    in property <color> fg: Theme.on-surface;
    height: 26px;
    width: row.preferred-width;
    border-radius: Theme.r-sm;
    background: bg;
    row := HorizontalLayout {
        x: 0px;
        y: 0px;
        height: parent.height;
        padding-left: 10px;
        padding-right: 10px;
        t := Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.label;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
 }

export component SectionTitle inherits Text {
    color: Theme.on-surface;
    font-size: Theme.title-md;
    font-weight: 650;
}

export component Card inherits Rectangle {
    in property <length> pad: 20px;
    border-radius: Theme.r-lg;
    background: Theme.surface-container;
}

export component StatTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.primary;
    height: 72px;
    border-radius: Theme.r-md;
    background: Theme.surface-container;
    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding: 12px;
        padding-left: 14px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Icon {
                glyph: root.glyph;
                font-size: 11px;
                color: root.tint;
            }
            Text {
                text: root.label;
                font-size: Theme.label;
                color: Theme.on-variant;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.value;
            font-size: Theme.title-md;
            font-weight: 700;
            color: Theme.on-surface;
        }
    }
}

export component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text {
        text: root.label;
        width: 76px;
        horizontal-stretch: 0;
        color: Theme.on-variant;
        font-size: Theme.body-sm;
    }
    Text {
        text: root.value;
        color: Theme.on-surface;
        font-size: Theme.body-sm;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> divider: true;
    min-height: 72px;
    if root.divider : Rectangle {
        x: 20px;
        y: 0px;
        width: parent.width - 40px;
        height: 1px;
        background: Theme.outline-variant;
    }
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.title;
                color: Theme.on-surface;
                font-size: Theme.body;
                font-weight: 550;
            }
            if root.desc != "" : Text {
                text: root.desc;
                color: Theme.on-variant;
                font-size: Theme.body-sm;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

export component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in-out property <bool> checked;
    callback toggled;
    min-height: 72px;
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.label;
                color: Theme.on-surface;
                font-size: Theme.body;
                font-weight: 550;
            }
            if root.description != "" : Text {
                text: root.description;
                color: Theme.on-variant;
                font-size: Theme.body-sm;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            Switch {
                checked <=> root.checked;
                toggled => { root.toggled(); }
            }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <int> serial;
    property <bool> shown: false;
    height: shown && text != "" ? 40px : 0px;
    opacity: shown && text != "" ? 1 : 0;
    border-radius: Theme.r-md;
    background: Theme.surface-high;
    clip: true;

    animate opacity { duration: Theme.motion-medium; }
    animate height { duration: Theme.motion-fast; }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: Theme.on-surface;
            font-size: Theme.body-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    hide-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { shown = false; }
    }

    changed serial => {
        shown = root.text != "";
        hide-timer.running = false;
        hide-timer.running = shown;
    }
}
