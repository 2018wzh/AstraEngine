import { ComboBox, LineEdit, CheckBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ConfigField } from "../globals.slint";
import { PillButton } from "./controls.slint";

export component GenericConfigForm inherits Rectangle {
    in property <[ConfigField]> fields;
    in property <string> form-title: "";
    in property <string> form-description: "";
    in property <bool> has-selected-case: true;
    in property <bool> show-actions: true;
    in property <string> empty-message: "当前没有可配置选项";
    callback field-changed(string, string);
    callback save();
    callback reset();

    background: transparent;

    VerticalLayout {
        spacing: 12px;

        if form-title != "" : Text {
            text: form-title;
            color: Theme.on-surface;
            font-size: Theme.title-sm;
            font-weight: 600;
        }

        if form-description != "" : Text {
            text: form-description;
            color: Theme.on-variant;
            font-size: Theme.body-sm;
            wrap: word-wrap;
        }

        for field in fields : VerticalLayout {
            spacing: 4px;

            Text {
                text: field.label + (field.required ? " *" : "");
                color: Theme.on-surface;
                font-size: Theme.body-sm;
                font-weight: 500;
                vertical-alignment: center;
            }

            if field.description != "" : Text {
                text: field.description;
                color: Theme.on-variant;
                font-size: Theme.label;
                wrap: word-wrap;
            }

            if field.kind == "enum" : ComboBox {
                model: field.options;
                current-value: field.value;
                selected(value) => { root.field-changed(field.key, value); }
            }

            if field.kind == "string" || field.kind == "float" : LineEdit {
                text: field.value;
                placeholder-text: field.required ? "必填" : "选填";
                edited(value) => { root.field-changed(field.key, value); }
            }

            if field.kind == "secret" : LineEdit {
                text: field.value;
                input-type: password;
                placeholder-text: field.required ? "必填" : "留空保留当前值";
                edited(value) => { root.field-changed(field.key, value); }
            }

            if field.kind == "integer" : LineEdit {
                text: field.value;
                input-type: number;
                edited(value) => { root.field-changed(field.key, value); }
            }

            if field.kind == "bool" : CheckBox {
                text: field.value == "true" ? "已启用" : "已关闭";
                checked: field.value == "true";
                toggled => { root.field-changed(field.key, self.checked ? "true" : "false"); }
            }

            Rectangle { height: 6px; }
        }

        if show-actions && fields.length > 0 : HorizontalLayout {
            spacing: 10px;
            Rectangle { horizontal-stretch: 1; }
            PillButton {
                text: "重置";
                variant: "outlined";
                clicked => { root.reset(); }
            }
            PillButton {
                text: "保存";
                variant: "filled";
                enabled: has-selected-case;
                clicked => { root.save(); }
            }
        }

        if fields.length == 0 : Text {
            text: empty-message;
            color: Theme.on-variant;
            font-size: Theme.body-sm;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
