// VFS file tree and list components for the file browser page - M3 Styled.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, Icons } from "./icons.slint";

export struct VfsEntry {
    path: string,
    name: string,
    is-dir: bool,
    size-display: string,
    source-layer: string,
    expanded: bool,
    depth: int,
}

export struct VfsPreview {
    path: string,
    kind: string,
    text-content: string,
    hex-summary: string,
    image-data: image,
    size-display: string,
    source-layer: string,
    resolve-path: string,
}

// Single file tree row
export component FileTreeRow inherits Rectangle {
    in property <VfsEntry> entry;
    in property <bool> selected: false;
    callback activated(string);
    callback toggle-expand(string);

    height: 34px;
    background: selected
        ? Theme.primary-container
        : (row-area.has-hover ? Theme.surface-container-high : transparent);
    border-radius: Theme.shape-sm;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 8px + entry.depth * 16px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;

        // Expand/collapse indicator for directories
        if entry.is-dir : Rectangle {
            width: 16px;
            height: parent.height;

            Icon {
                glyph: entry.expanded ? Icons.chevron-down : Icons.chevron-right;
                color: Theme.on-surface-variant;
                font-size: 10px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            TouchArea {
                clicked => { root.toggle-expand(root.entry.path); }
            }
        }
        if !entry.is-dir : Rectangle { width: 16px; }

        // File/folder icon
        Icon {
            glyph: entry.is-dir ? Icons.folder : Icons.file;
            color: entry.is-dir ? Theme.primary : Theme.on-surface-variant;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 20px;
        }

        // Name
        Text {
            text: entry.name;
            color: selected ? Theme.on-primary-container : Theme.on-surface;
            font-size: Theme.font-body-sm;
            font-weight: entry.is-dir ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Size display for files
        if !entry.is-dir && entry.size-display != "" : Text {
            text: entry.size-display;
            color: selected ? Theme.on-primary-container : Theme.on-surface-variant;
            font-size: Theme.font-label-sm;
            vertical-alignment: center;
        }

        // Source layer badge
        if entry.source-layer != "" : Rectangle {
            width: layer-text.preferred-width + 10px;
            height: 18px;
            border-radius: Theme.shape-xs;
            background: selected ? Theme.surface-overlay : Theme.surface-container-highest;

            layer-text := Text {
                text: entry.source-layer;
                color: selected ? Theme.on-surface : Theme.on-surface-variant;
                font-size: Theme.font-label-sm;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    row-area := TouchArea {
        clicked => { root.activated(root.entry.path); }
    }
}

// File preview panel
export component FilePreviewPanel inherits Rectangle {
    in property <VfsPreview> preview;
    in property <bool> has-preview: false;

    background: Theme.surface-container-low;
    border-radius: Theme.shape-lg;
    border-width: 1px;
    border-color: Theme.outline-variant;

    if !has-preview : VerticalLayout {
        alignment: center;
        spacing: 8px;

        Icon {
            glyph: Icons.file;
            font-size: 32px;
            color: Theme.outline;
            horizontal-alignment: center;
        }

        Text {
            text: "选择文件以预览内容";
            color: Theme.on-surface-variant;
            font-size: Theme.font-body-md;
            horizontal-alignment: center;
        }
    }

    if has-preview : VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // File path header
        Text {
            text: preview.path;
            color: Theme.on-surface;
            font-size: Theme.font-title-sm;
            font-weight: 700;
            overflow: elide;
        }

        // Meta info
        HorizontalLayout {
            spacing: 16px;

            Text {
                text: "大小: " + preview.size-display;
                color: Theme.on-surface-variant;
                font-size: Theme.font-body-sm;
            }
            Text {
                text: "来源层: " + preview.source-layer;
                color: Theme.on-surface-variant;
                font-size: Theme.font-body-sm;
            }
            Text {
                text: "类型: " + preview.kind;
                color: Theme.primary;
                font-size: Theme.font-body-sm;
                font-weight: 600;
            }
        }

        Rectangle { height: 1px; background: Theme.outline-variant; }

        // Content preview area
        if preview.kind == "text" : ScrollView {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;

            Text {
                text: preview.text-content;
                color: Theme.on-surface;
                font-size: Theme.font-body-sm;
                wrap: no-wrap;
            }
        }

        if preview.kind == "image" : Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-container-lowest;
            border-radius: Theme.shape-sm;

            Image {
                source: preview.image-data;
                image-fit: contain;
            }
        }

        if preview.kind == "binary" : ScrollView {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;

            Text {
                text: preview.hex-summary;
                color: Theme.on-surface-variant;
                font-size: Theme.font-label-sm;
                wrap: no-wrap;
            }
        }

        // Resolve path footer
        Rectangle { height: 1px; background: Theme.outline-variant; }

        Text {
            text: "物理定位: " + preview.resolve-path;
            color: Theme.on-surface-variant;
            font-size: Theme.font-label-sm;
            overflow: elide;
        }
    }
}
