import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App, Selection, Settings } from "../globals.slint";
import { PillButton, Segmented, Card } from "./controls.slint";

export component WorkAssociation inherits Rectangle {
    private property <int> provider-index: Settings.metadata-provider == "bangumi" ? 1 : 0;
    private property <string> provider: provider-index == 1 ? "bangumi" : "vndb";
    private property <string> query;
    private property <bool> expanded: false;
    private property <bool> consented: provider == "bangumi" ? Settings.bangumi-enabled : Settings.vndb-enabled;

    changed work-watch => {
        root.query = "";
        root.expanded = false;
    }
    private property <string> work-watch: Selection.game.id;

    VerticalLayout {
        spacing: 8px;
        PillButton {
            text: root.expanded ? "收起作品关联" : "关联或更换作品";
            variant: "tonal";
            clicked => { root.expanded = !root.expanded; }
        }
        if root.expanded : VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                horizontal-stretch: 0;
                Segmented {
                    items: ["VNDB", "Bangumi"];
                    current <=> root.provider-index;
                    segment-width: 96px;
                    selected(i) => { root.provider-index = i; }
                }
            }
            LineEdit {
                text <=> root.query;
                placeholder-text: "搜索标题、原名或译名";
                enabled: !Selection.metadata-busy;
                accepted => { Selection.search-metadata(root.provider, root.query); }
            }
            if root.consented : PillButton {
                text: Selection.metadata-busy ? "正在搜索…" : "搜索作品";
                variant: "filled";
                enabled: !Selection.metadata-busy && root.query != "";
                clicked => { Selection.search-metadata(root.provider, root.query); }
            }
            if !root.consented : PillButton {
                text: "前往设置开启联网";
                variant: "outlined";
                clicked => {
                    App.page = "settings";
                    App.settings-category = "metadata";
                }
            }
            if Selection.metadata-status != "" : Text {
                text: Selection.metadata-status;
                wrap: word-wrap;
                color: Theme.on-variant;
                font-size: Theme.body-sm;
            }
            for item in Selection.matches : Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    Text {
                        text: item.title;
                        wrap: word-wrap;
                        color: Theme.on-surface;
                        font-weight: 600;
                        font-size: Theme.body;
                    }
                    Text {
                        text: item.provider + " · " + item.release-date + " · " + item.developer;
                        wrap: word-wrap;
                        color: Theme.on-variant;
                        font-size: Theme.body-sm;
                    }
                    if item.aliases != "" : Text {
                        text: item.aliases;
                        wrap: word-wrap;
                        overflow: elide;
                        height: 42px;
                        color: Theme.on-variant;
                        font-size: Theme.body-sm;
                    }
                    PillButton {
                        text: "关联这部作品";
                        enabled: !Selection.metadata-busy;
                        clicked => { Selection.accept-match(item.id); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                PillButton {
                    text: "重新获取资料";
                    variant: "outlined";
                    enabled: !Selection.metadata-busy;
                    clicked => { Selection.refresh-metadata(root.provider); }
                }
                PillButton {
                    text: "解除关联";
                    variant: "text";
                    enabled: !Selection.metadata-busy;
                    clicked => { Selection.unlink-metadata(root.provider); }
                }
            }
        }
    }
}
