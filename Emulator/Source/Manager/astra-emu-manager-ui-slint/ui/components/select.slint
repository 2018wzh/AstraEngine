import { MaterialPalette, MaterialText, MaterialTypography, Icon, ScrollView } from "@material";
import { Icons } from "../icons.slint";
import { Choice } from "../globals.slint";

// Wrapped helper/error line under a field, indented like Material's supporting
// text. The Rectangle root forwards its layout's size: a conditional layout
// element would measure the wrapped text without its padding and cut the last
// line.
export component SupportingText inherits Rectangle {
    in property <string> text;
    in property <bool> error;

    min-height: layout.min-height;
    preferred-height: layout.preferred-height;

    layout := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        MaterialText {
            text: root.text;
            style: MaterialTypography.body-small;
            color: root.error ? MaterialPalette.error : MaterialPalette.on-surface-variant;
            wrap: word-wrap;
            overflow: clip;
        }
    }
}

component SelectFrame {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> has-error;
    in property <string> supporting-text;
    in property <bool> open;
    out property <length> field-height: field.height;
    out property <length> slot-width: slot.width;
    out property <length> slot-height: slot.height;
    callback clicked();

    property <color> highlight: root.has-error ? MaterialPalette.error : root.open || focus.has-focus ? MaterialPalette.primary : MaterialPalette.on-surface-variant;

    min-width: 120px;
    min-height: layout.min-height;
    preferred-height: layout.preferred-height;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-expand => { root.clicked(); }

    focus := FocusScope {
        x: 0;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" || event.text == Key.DownArrow {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    layout := VerticalLayout {
        spacing: 4px;

        field := Rectangle {
            min-height: 56px;
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
            background: MaterialPalette.surface-container-highest;
            opacity: root.enabled ? 1 : 0.38;

            Rectangle {
                width: 100%;
                height: 100%;
                border-top-left-radius: 4px;
                border-top-right-radius: 4px;
                background: touch.has-hover ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-hover) : transparent;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 8px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    if root.label != "" : MaterialText {
                        text: root.label;
                        style: MaterialTypography.body-small;
                        color: root.highlight;
                        overflow: elide;
                    }

                    slot := Rectangle {
                        height: 24px;
                        @children
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Icon {
                        width: 24px;
                        source: Icons.arrow-drop-down;
                        colorize: MaterialPalette.on-surface-variant;
                        transform-rotation: root.open ? 180deg : 0deg;
                    }
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: root.open || focus.has-focus || root.has-error ? 2px : 1px;
                background: root.highlight;
            }

            touch := TouchArea {
                width: 100%;
                height: 100%;
                enabled: root.enabled;
                clicked => {
                    focus.focus();
                    root.clicked();
                }
            }
        }

        if root.supporting-text != "" : SupportingText {
            text: root.supporting-text;
            error: root.has-error;
        }
    }
}

component MenuRow {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: 48px;
    accessible-role: list-item;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.selected ? MaterialPalette.secondary-container : touch.has-hover ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-hover) : transparent;
    }

    MaterialText {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        style: MaterialTypography.body-large;
        color: root.selected ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component SelectMenu inherits PopupWindow {
    in property <int> count;
    close-policy: close-on-click-outside;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 4px;
        background: MaterialPalette.surface-container;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: MaterialPalette.shadow-30;
        clip: true;

        ScrollView {
            width: 100%;
            height: 100%;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                @children
            }
        }
    }
}

export component ChoiceSelect {
    in property <string> label;
    in property <[Choice]> choices;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> has-error;
    in property <string> supporting-text;
    callback selected(id: string);

    min-width: frame.min-width;
    min-height: frame.min-height;
    preferred-height: frame.preferred-height;
    forward-focus: frame;

    frame := SelectFrame {
        width: root.width;
        height: root.height;
        label: root.label;
        enabled: root.enabled && root.choices.length > 0;
        has-error: root.has-error;
        supporting-text: root.supporting-text;
        clicked => { menu.show(); }

        for choice in root.choices : MaterialText {
            x: 0px;
            y: 0px;
            width: frame.slot-width;
            height: frame.slot-height;
            visible: choice.id == root.value;
            text: choice.label;
            style: MaterialTypography.body-large;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    menu := SelectMenu {
        x: 0px;
        y: frame.field-height;
        width: root.width;
        height: min(root.choices.length * 48px + 16px, 6 * 48px + 16px);
        count: root.choices.length;

        for choice in root.choices : MenuRow {
            text: choice.label;
            selected: choice.id == root.value;
            clicked => {
                menu.close();
                if choice.id != root.value {
                    root.selected(choice.id);
                }
            }
        }
    }
}

export component OptionSelect {
    in property <string> label;
    in property <[string]> labels;
    in property <[string]> values;
    in property <string> value;
    in property <string> display;
    in property <bool> enabled: true;
    in property <bool> has-error;
    in property <string> supporting-text;
    callback selected(value: string);

    min-width: frame.min-width;
    min-height: frame.min-height;
    preferred-height: frame.preferred-height;
    forward-focus: frame;

    frame := SelectFrame {
        width: root.width;
        height: root.height;
        label: root.label;
        enabled: root.enabled && root.labels.length > 0;
        has-error: root.has-error;
        supporting-text: root.supporting-text;
        clicked => { menu.show(); }

        MaterialText {
            x: 0px;
            y: 0px;
            width: frame.slot-width;
            height: frame.slot-height;
            text: root.display;
            style: MaterialTypography.body-large;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    menu := SelectMenu {
        x: 0px;
        y: frame.field-height;
        width: root.width;
        height: min(root.labels.length * 48px + 16px, 6 * 48px + 16px);
        count: root.labels.length;

        for text[index] in root.labels : MenuRow {
            text: text;
            selected: root.values[index] == root.value;
            clicked => {
                menu.close();
                if root.values[index] != root.value {
                    root.selected(root.values[index]);
                }
            }
        }
    }
}
