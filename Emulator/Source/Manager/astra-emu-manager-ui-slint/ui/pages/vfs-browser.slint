// VFS file browser page - read-only tree + content preview + export - M3 Styled.

import { Button, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { IconButton, Icon, Icons } from "../components/icons.slint";
import { VfsEntry, VfsPreview, FileTreeRow, FilePreviewPanel } from "../components/file-tree.slint";
import { M3Button } from "../components/m3-widgets.slint";

export component VfsBrowserPage inherits Rectangle {
    in property <[VfsEntry]> entries;
    in property <VfsPreview> preview;
    in property <bool> has-preview: false;
    in property <string> selected-path;
    in property <string> current-dir: "/";
    in property <string> mount-summary: "";
    in property <bool> desktop-mode: true;
    in-out property <string> search-query: "";
    in-out property <string> type-filter: "all";
    callback select-entry(string);
    callback toggle-expand(string);
    callback navigate-up();
    callback refresh();
    callback export-file(string);
    callback copy-path(string);
    callback search(string);
    callback set-type-filter(string);

    background: Theme.surface;

    VerticalLayout {
        spacing: 0px;

        // Toolbar
        Rectangle {
            height: 56px;
            background: Theme.surface-container-low;
            border-width: 1px;
            border-color: Theme.outline-variant;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                alignment: center;

                IconButton {
                    glyph: Icons.arrow-up;
                    enabled: root.current-dir != "/";
                    clicked => { root.navigate-up(); }
                }

                // Breadcrumb path container
                Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.surface-container;
                    border-width: 1px;
                    border-color: Theme.outline-variant;

                    Text {
                        text: root.current-dir;
                        color: Theme.on-surface;
                        font-size: Theme.font-body-sm;
                        font-weight: 500;
                        vertical-alignment: center;
                        x: 14px;
                        width: parent.width - 28px;
                        overflow: elide;
                    }
                }

                M3Button {
                    text: "刷新";
                    icon: Icons.rotate;
                    variant: "tonal";
                    clicked => { root.refresh(); }
                }

                M3Button {
                    text: "复制路径";
                    icon: Icons.copy;
                    variant: "outlined";
                    enabled: root.selected-path != "";
                    clicked => { root.copy-path(root.selected-path); }
                }

                M3Button {
                    text: "导出文件";
                    icon: Icons.download;
                    primary: true;
                    enabled: root.selected-path != "";
                    clicked => { root.export-file(root.selected-path); }
                }
            }
        }

        // Search / type filter bar
        Rectangle {
            height: 48px;
            background: Theme.surface-container-low;
            border-width: 1px;
            border-color: Theme.outline-variant;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                alignment: center;

                LineEdit {
                    text <=> root.search-query;
                    placeholder-text: "搜索 VFS 虚拟文件系统（文件名 / 虚拟路径）";
                    horizontal-stretch: 1;
                    edited => { root.search(self.text); }
                }
                ComboBox {
                    model: ["全部格式", "文本/脚本", "图像纹理", "二进制包"];
                    current-index: root.type-filter == "text" ? 1 : root.type-filter == "image" ? 2 : root.type-filter == "binary" ? 3 : 0;
                    selected(value) => { root.set-type-filter(value == "文本/脚本" ? "text" : value == "图像纹理" ? "image" : value == "二进制包" ? "binary" : "all"); }
                }
                Text {
                    text: root.entries.length + " 个节点";
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-label-md;
                    vertical-alignment: center;
                }
            }
        }

        // Mount summary bar
        if root.mount-summary != "" : Rectangle {
            height: 34px;
            background: Theme.surface-container;

            Text {
                text: root.mount-summary;
                color: Theme.on-surface-variant;
                font-size: Theme.font-label-md;
                vertical-alignment: center;
                x: 16px;
                width: parent.width - 32px;
                overflow: elide;
            }
        }

        // Main content
        if root.desktop-mode : HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // File tree (left)
            Rectangle {
                width: 360px;
                background: Theme.surface-container-low;
                border-width: 1px;
                border-color: Theme.outline-variant;

                ScrollView {
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;

                        for entry in root.entries: FileTreeRow {
                            entry: entry;
                            selected: entry.path == root.selected-path;
                            activated(path) => { root.select-entry(path); }
                            toggle-expand(path) => { root.toggle-expand(path); }
                        }

                        if root.entries.length == 0 : Rectangle {
                            height: 100px;

                            Text {
                                text: "当前暂无挂载的 VFS 节点。\n启动游戏即可自动挂载只读档案层。";
                                color: Theme.on-surface-variant;
                                font-size: Theme.font-body-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Preview (right)
            VerticalLayout {
                horizontal-stretch: 1;
                padding: 16px;

                FilePreviewPanel {
                    preview: root.preview;
                    has-preview: root.has-preview;
                }
            }
        }

        // Mobile: stacked layout
        if !root.desktop-mode : VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // File list
            Rectangle {
                vertical-stretch: 1;
                background: Theme.surface-container-low;

                ScrollView {
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 2px;

                        for entry in root.entries: FileTreeRow {
                            entry: entry;
                            selected: entry.path == root.selected-path;
                            activated(path) => { root.select-entry(path); }
                            toggle-expand(path) => { root.toggle-expand(path); }
                        }

                        if root.entries.length == 0 : Rectangle {
                            height: 100px;

                            Text {
                                text: "当前暂无挂载的 VFS 节点。";
                                color: Theme.on-surface-variant;
                                font-size: Theme.font-body-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Preview below (when selected)
            if root.has-preview : FilePreviewPanel {
                height: 280px;
                preview: root.preview;
                has-preview: root.has-preview;
            }
        }
    }
}
