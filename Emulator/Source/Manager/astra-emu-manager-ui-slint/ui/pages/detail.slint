import { ScrollView, SpinBox, TextEdit, LineEdit, ComboBox, Spinner } from "std-widgets.slint";
import { Theme, Accent } from "../theme.slint";
import { App, Library, Selection, BangumiProgress, FilePatch } from "../globals.slint";
import { Icon, Icons } from "../components/icons.slint";
import { PillButton, IconBtn, Tabs, Tag, StatusBadge, StatTile, InfoRow, Card, Segmented, SectionTitle } from "../components/controls.slint";
import { WorkAssociation } from "../components/work-association.slint";
import { GenericConfigForm } from "../components/generic-config.slint";

export component DetailSheet inherits Rectangle {
    in property <bool> handle: false;
    callback close();

    property <Accent> a: Theme.accent(Selection.tint.alpha > 0 ? Selection.tint : Theme.primary, App.dark);
    background: Theme.surface-low;
    clip: true;
    border-top-left-radius: handle ? Theme.r-xl : 0px;
    border-top-right-radius: handle ? Theme.r-xl : 0px;

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        header := Rectangle {
            height: 200px;
            background: @linear-gradient(180deg, root.a.container 0%, transparent 100%);

            if root.handle : Rectangle {
                width: 36px;
                height: 4px;
                x: (parent.width - self.width) / 2;
                y: 10px;
                border-radius: 2px;
                background: Theme.on-surface;
                opacity: 0.4;
            }

            IconBtn {
                x: parent.width - 52px;
                y: 16px;
                glyph: Icons.xmark;
                label: "关闭";
                clicked => { root.close(); }
            }

            Rectangle {
                x: 24px;
                y: 48px;
                width: 104px;
                height: 138px;
                border-radius: Theme.r-md;
                clip: true;
                background: Theme.surface-high;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.shadow;
                if Selection.cover.width > 0 : Image {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: Selection.cover;
                    image-fit: cover;
                }
            }

            VerticalLayout {
                x: 140px;
                y: 88px;
                width: parent.width - 160px;
                spacing: 8px;
                Text {
                    text: Selection.game.title;
                    color: Theme.on-surface;
                    font-size: Theme.title-lg;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    if Selection.game.family != "" : Tag { text: Selection.game.family; }
                    StatusBadge { status: Selection.compat.status; }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;
            ScrollView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    alignment: start;

                    PillButton {
                        text: "开始游戏";
                        fill: root.a.primary;
                        on-fill: root.a.on-primary;
                        h: 52px;
                        enabled: Selection.game.launchable;
                        clicked => { Library.launch(Selection.game.id); }
                    }
                    if !Selection.game.launchable : Text {
                        text: Selection.game.problem != "" ? Selection.game.problem : "暂时无法启动";
                        color: Theme.error;
                        font-size: Theme.body-sm;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        StatTile {
                            horizontal-stretch: 1;
                            glyph: Icons.clock;
                            label: "累计时长";
                            value: Selection.game.play-time != "" ? Selection.game.play-time : "—";
                            tint: root.a.primary;
                        }
                        StatTile {
                            horizontal-stretch: 1;
                            glyph: Icons.history;
                            label: "上次游玩";
                            value: Selection.game.last-played != "" ? Selection.game.last-played : "从未";
                            tint: root.a.primary;
                        }
                    }

                    Tabs {
                        items: ["概览", "兼容性", "记录", "选项"];
                        current <=> Library.detail-tab;
                        accent: root.a.primary;
                        selected(i) => { Library.detail-tab = i; }
                    }

                    if Library.detail-tab == 0 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        if Selection.game.description != "" : Text {
                            text: Selection.game.description;
                            color: Theme.on-surface;
                            font-size: Theme.body;
                            wrap: word-wrap;
                        }
                        if Selection.game.developer != "" : InfoRow { label: "开发商"; value: Selection.game.developer; }
                        if Selection.game.release-date != "" : InfoRow { label: "发售日"; value: Selection.game.release-date; }
                        if Selection.game.platforms != "" : InfoRow { label: "发售平台"; value: Selection.game.platforms; }
                        if Selection.game.engine != "" : InfoRow { label: "原版引擎"; value: Selection.game.engine; }
                        if Selection.game.aliases != "" : InfoRow { label: "别名"; value: Selection.game.aliases; }
                        if Selection.game.tags != "" : InfoRow { label: "标签"; value: Selection.game.tags; }

                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                SectionTitle { text: "作品资料"; }
                                if Selection.metadata-status != "" : Text {
                                    text: Selection.metadata-status;
                                    color: Theme.on-variant;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                                WorkAssociation { }
                            }
                        }
                    }

                    if Library.detail-tab == 1 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        if Selection.compat.status == "" && Selection.compat.notes == "" : Text {
                            text: "社区暂无这部作品的兼容性记录";
                            color: Theme.on-variant;
                            font-size: Theme.body;
                            wrap: word-wrap;
                        }
                        if Selection.compat.status != "" || Selection.compat.notes != "" : Rectangle {
                            border-radius: Theme.r-lg;
                            background: Theme.accent(Theme.status-seed(Selection.compat.status), App.dark).container;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;
                                Text {
                                    text: Theme.status-label(Selection.compat.status);
                                    color: Theme.accent(Theme.status-seed(Selection.compat.status), App.dark).on-container;
                                    font-size: Theme.title-md;
                                    font-weight: 700;
                                }
                                if Selection.compat.notes != "" : Text {
                                    text: Selection.compat.notes;
                                    color: Theme.accent(Theme.status-seed(Selection.compat.status), App.dark).on-container;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                                if Selection.compat.updated != "" : Text {
                                    text: "更新于 " + Selection.compat.updated;
                                    color: Theme.accent(Theme.status-seed(Selection.compat.status), App.dark).on-container;
                                    font-size: Theme.label;
                                    opacity: 0.8;
                                }
                            }
                        }
                        if Selection.compat.vndb-id != "" : Text {
                            text: "VNDB 条目 " + Selection.compat.vndb-id;
                            color: Theme.on-variant;
                            font-size: Theme.body-sm;
                        }
                        SectionTitle { text: "发行版本"; }
                        for rel in Selection.releases : PillButton {
                            text: rel.label;
                            variant: "outlined";
                            clicked => { Selection.pin-release(rel.id); }
                        }
                        PillButton {
                            text: "获取发行版本列表";
                            variant: "tonal";
                            clicked => { Selection.fetch-releases(); }
                        }
                        PillButton {
                            text: "刷新兼容性数据";
                            variant: "text";
                            clicked => { Selection.refresh-compat(); }
                        }
                    }

                    if Library.detail-tab == 2 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        SectionTitle { text: "游玩记录"; }
                        if Selection.history.length == 0 : Text {
                            text: "还没有游玩记录";
                            color: Theme.on-variant;
                            font-size: Theme.body;
                        }
                        for row in Selection.history : HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: row.started + " · " + row.duration + " · " + row.ended-by;
                                color: Theme.on-surface;
                                font-size: Theme.body-sm;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }

                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 12px;
                                SectionTitle { text: "Bangumi"; }
                                HorizontalLayout {
                                    horizontal-stretch: 0;
                                    Segmented {
                                        items: ["想玩", "在玩", "玩过", "搁置", "抛弃"];
                                        current: Selection.bangumi.status == "wish" ? 0
                                            : Selection.bangumi.status == "doing" ? 1
                                            : Selection.bangumi.status == "collect" ? 2
                                            : Selection.bangumi.status == "on_hold" ? 3
                                            : Selection.bangumi.status == "dropped" ? 4
                                            : 1;
                                        segment-width: 64px;
                                        selected(i) => {
                                            Selection.bangumi = {
                                                status: i == 0 ? "wish" : i == 1 ? "doing" : i == 2 ? "collect" : i == 3 ? "on_hold" : "dropped",
                                                rating: Selection.bangumi.rating,
                                                note: Selection.bangumi.note,
                                            };
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "评分";
                                        color: Theme.on-variant;
                                        font-size: Theme.body-sm;
                                        vertical-alignment: center;
                                        horizontal-stretch: 0;
                                    }
                                    SpinBox {
                                        value: Selection.bangumi.rating;
                                        minimum: 1;
                                        maximum: 10;
                                        edited(v) => {
                                            Selection.bangumi = {
                                                status: Selection.bangumi.status,
                                                rating: v,
                                                note: Selection.bangumi.note,
                                            };
                                        }
                                    }
                                }
                                TextEdit {
                                    height: 80px;
                                    text: Selection.bangumi.note;
                                    edited(v) => {
                                        Selection.bangumi = {
                                            status: Selection.bangumi.status,
                                            rating: Selection.bangumi.rating,
                                            note: v,
                                        };
                                    }
                                }
                                PillButton {
                                    text: "同步到 Bangumi";
                                    variant: "filled";
                                    clicked => { Selection.sync-bangumi(Selection.bangumi); }
                                }
                                if Selection.bangumi-summary != "" : Text {
                                    text: Selection.bangumi-summary;
                                    color: Theme.on-variant;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    if Library.detail-tab == 3 : VerticalLayout {
                        spacing: 14px;
                        alignment: start;
                        GenericConfigForm {
                            fields: Selection.engine-fields;
                            form-title: "运行设置";
                            show-actions: false;
                            field-changed(key, value) => { Selection.config-changed(key, value); }
                        }
                        GenericConfigForm {
                            fields: Selection.family-fields;
                            form-title: "模拟器设置";
                            show-actions: false;
                            field-changed(key, value) => { Selection.config-changed(key, value); }
                        }
                        if Selection.musica-key-available : Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text {
                                    text: "选择当前游戏使用的 key.toml。原始文件不会修改。";
                                    color: Theme.on-surface;
                                    font-size: Theme.body;
                                    wrap: word-wrap;
                                }
                                PillButton {
                                    text: "选择 key.toml";
                                    variant: "tonal";
                                    clicked => { Selection.pick-musica-key(); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; }
                            PillButton {
                                text: "重置";
                                variant: "outlined";
                                enabled: Library.selected-id != "";
                                clicked => { Selection.reset-config(); }
                            }
                            PillButton {
                                text: "保存";
                                variant: "filled";
                                enabled: Library.selected-id != "";
                                clicked => { Selection.save-config(); }
                            }
                        }
                        Card {
                            init => { FilePatch.load-catalog(); }
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text {
                                    text: "应用文件补丁（仅必要时）";
                                    color: Theme.on-surface;
                                    font-size: Theme.body;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "优先使用模拟器的原生选项。仅在必要时运行可信本地脚本；原目录只读，结果写入新的独立目录。";
                                    color: Theme.on-variant;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    catalog := ComboBox {
                                        horizontal-stretch: 1;
                                        model: FilePatch.recipe-titles;
                                        current-index <=> FilePatch.catalog-index;
                                        enabled: !FilePatch.running && FilePatch.recipe-titles.length > 0;
                                        selected(value) => {
                                            FilePatch.script = FilePatch.recipe-scripts[catalog.current-index];
                                        }
                                    }
                                    PillButton {
                                        text: "本地 Luau…";
                                        variant: "tonal";
                                        enabled: !FilePatch.running;
                                        clicked => { FilePatch.pick-script(); }
                                    }
                                }
                                Text {
                                    text: FilePatch.script == "" ? "尚未选择脚本" : FilePatch.script;
                                    color: Theme.on-variant;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "补丁输入目录";
                                    color: Theme.on-surface;
                                    font-size: Theme.body-sm;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> FilePatch.patch-directory;
                                        placeholder-text: "留空使用所选游戏原目录";
                                        enabled: !FilePatch.running;
                                    }
                                    PillButton {
                                        text: "选择…";
                                        variant: "outlined";
                                        enabled: !FilePatch.running;
                                        clicked => { FilePatch.pick-patch-directory(); }
                                    }
                                }
                                Text {
                                    text: "新输出目录（必须尚不存在）";
                                    color: Theme.on-surface;
                                    font-size: Theme.body-sm;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit {
                                        horizontal-stretch: 1;
                                        text <=> FilePatch.output-directory;
                                        placeholder-text: "新的独立目录路径";
                                        enabled: !FilePatch.running;
                                    }
                                    PillButton {
                                        text: "选择…";
                                        variant: "outlined";
                                        enabled: !FilePatch.running;
                                        clicked => { FilePatch.pick-output-directory(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton {
                                        text: "开始";
                                        variant: "filled";
                                        enabled: FilePatch.can-start && FilePatch.script != "" && FilePatch.output-directory != "";
                                        clicked => {
                                            FilePatch.start(FilePatch.script, FilePatch.patch-directory, FilePatch.output-directory);
                                        }
                                    }
                                    if FilePatch.running : PillButton {
                                        text: "取消";
                                        variant: "outlined";
                                        clicked => { FilePatch.cancel(); }
                                    }
                                    if FilePatch.running : Spinner {
                                        width: 20px;
                                        height: 20px;
                                        indeterminate: true;
                                    }
                                }
                                if FilePatch.phase != "" : Text {
                                    text: FilePatch.phase + (FilePatch.running ? "\n" + FilePatch.completed + (FilePatch.total == "" ? "" : " / " + FilePatch.total) : "");
                                    color: Theme.on-variant;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                                if FilePatch.output != "" : Text {
                                    text: "输出：" + FilePatch.output;
                                    color: Theme.on-variant;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                                if FilePatch.error != "" : Text {
                                    text: FilePatch.error;
                                    color: Theme.error;
                                    font-size: Theme.body-sm;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
