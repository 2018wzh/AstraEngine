import {
    MaterialPalette, MaterialText, MaterialTypography, FilledButton, TonalButton, OutlineButton, TextButton,
    TextField, LinearProgressIndicator, HorizontalDivider, Icon,
} from "@material";
import { GameSettings } from "../../globals.slint";
import { Icons } from "../../icons.slint";
import { Theme } from "../../theme.slint";
import { SectionTitle, Panel, Pill, SelectableTile } from "./parts.slint";

component StepDot {
    in property <int> number;
    in property <string> label;
    in property <bool> active;
    in property <bool> done;
    in property <bool> reachable;
    callback activate();

    horizontal-stretch: 1;
    min-width: 40px;
    height: 56px;
    accessible-role: tab;
    accessible-label: "第 " + root.number + " 步：" + root.label;
    accessible-enabled: root.reachable;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { if root.reachable { root.activate(); } }
    forward-focus: focus;

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.reachable;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activate();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        border-radius: 8px;
        background: touch.has-hover && root.reachable ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-hover)
            : focus.has-focus ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-focus)
            : transparent;
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: root.active || root.done ? MaterialPalette.primary : transparent;
                border-width: root.active || root.done ? 0px : 1px;
                border-color: MaterialPalette.outline;

                if root.done && !root.active : Icon {
                    width: 16px;
                    source: Icons.check;
                    colorize: MaterialPalette.on-primary;
                }
                if !root.done || root.active : MaterialText {
                    text: root.number;
                    style: MaterialTypography.label-medium;
                    color: root.active ? MaterialPalette.on-primary : MaterialPalette.on-surface-variant;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        MaterialText {
            text: root.label;
            style: MaterialTypography.label-medium;
            color: root.active ? MaterialPalette.primary : MaterialPalette.on-surface-variant;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.reachable;
        clicked => {
            focus.focus();
            root.activate();
        }
    }
}

component DirectoryPicker {
    in property <string> label;
    in property <string> value;
    in property <string> empty-text;
    in property <string> hint;
    in property <bool> enabled: true;
    callback pick();

    HorizontalLayout {
        spacing: Theme.space-sm;
        TextField {
            horizontal-stretch: 1;
            label: root.label;
            text: root.value != "" ? root.value : root.empty-text;
            read-only: true;
            enabled: root.enabled;
            supporting-text: root.hint;
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: start;
            padding-top: 8px;
            OutlineButton {
                text: "选择…";
                icon: Icons.folder-open;
                enabled: root.enabled;
                clicked => { root.pick(); }
            }
        }
    }
}

export component PatchSection {
    // Page-local navigation for steps 1–3 (and the step-4 start screen). The controller
    // reports running/error (forced to 4) and completion (5) through `patch.step`.
    property <int> local-step: 1;
    property <bool> locked: GameSettings.patch.running;
    property <bool> failed: GameSettings.patch.error != "";
    out property <int> step: root.locked || root.failed ? 4 : GameSettings.patch.step >= 4 ? GameSettings.patch.step : root.local-step;
    property <bool> determinate: GameSettings.patch.total > 0;
    property <int> recipe-match: round(match-counter.preferred-height / 1px);
    property <bool> local-script: GameSettings.patch.script != "" && root.recipe-match == 0;

    function go(target: int) {
        if !root.locked && target >= 1 && target <= 4 {
            root.local-step = target;
        }
    }

    match-counter := VerticalLayout {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        visible: false;
        for recipe in GameSettings.recipes : Rectangle {
            height: recipe.id == GameSettings.patch.script ? 1px : 0px;
        }
    }

    VerticalLayout {
        spacing: Theme.space-xl;

        Panel {
            inset: Theme.space-sm;
            HorizontalLayout {
                spacing: 0px;
                StepDot {
                    number: 1;
                    label: "选补丁";
                    active: root.step == 1;
                    done: GameSettings.patch.script != "";
                    reachable: !root.locked;
                    activate => { root.go(1); }
                }
                StepDot {
                    number: 2;
                    label: "补丁目录";
                    active: root.step == 2;
                    done: root.step > 2;
                    reachable: !root.locked && GameSettings.patch.script != "";
                    activate => { root.go(2); }
                }
                StepDot {
                    number: 3;
                    label: "输出目录";
                    active: root.step == 3;
                    done: GameSettings.patch.output-directory != "";
                    reachable: !root.locked && GameSettings.patch.script != "";
                    activate => { root.go(3); }
                }
                StepDot {
                    number: 4;
                    label: "执行";
                    active: root.step == 4;
                    done: root.step == 5;
                    reachable: !root.locked && GameSettings.patch.script != "" && GameSettings.patch.output-directory != "";
                    activate => { root.go(4); }
                }
                StepDot {
                    number: 5;
                    label: "完成";
                    active: root.step == 5;
                    done: false;
                    reachable: false;
                }
            }
        }

        if root.step == 1 : Panel {
            SectionTitle {
                text: "选择补丁";
                description: "从补丁目录选择适用于这部作品的汉化补丁，或使用本地的 Luau 转换脚本。";
            }
            if GameSettings.recipes.length == 0 : MaterialText {
                text: "补丁目录为空。同步 AstraEMU 元数据后会列出可用补丁，也可以直接选择本地脚本。";
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }
            if GameSettings.recipes.length > 0 : VerticalLayout {
                spacing: 2px;
                for recipe in GameSettings.recipes : SelectableTile {
                    text: recipe.title;
                    selected: recipe.id == GameSettings.patch.script;
                    clicked => { GameSettings.patch-select-recipe(recipe.id); }
                    if recipe.recommended : VerticalLayout {
                        alignment: center;
                        Pill { text: "推荐"; }
                    }
                }
            }
            if root.local-script : SelectableTile {
                text: "本地脚本";
                supporting-text: GameSettings.patch.script;
                selected: true;
            }
            HorizontalLayout {
                alignment: start;
                TextButton {
                    text: "选择本地脚本…";
                    icon: Icons.upload-file;
                    clicked => { GameSettings.patch-pick-script(); }
                }
            }
        }

        if root.step == 2 : Panel {
            SectionTitle {
                text: "补丁输入目录";
                description: "补丁文件所在的目录。补丁已经解压到游戏目录里时留空即可。";
            }
            DirectoryPicker {
                label: "补丁输入目录（可选）";
                value: GameSettings.patch.patch-directory;
                empty-text: "使用游戏目录";
                pick => { GameSettings.patch-pick-directory("patch"); }
            }
        }

        if root.step == 3 : Panel {
            SectionTitle {
                text: "新输出目录";
                description: "转换结果写入一个新的目录，原游戏目录保持不变。完成后它会作为一部新作品加入资料库。";
            }
            DirectoryPicker {
                label: "输出目录";
                value: GameSettings.patch.output-directory;
                empty-text: "尚未选择";
                hint: "必须是不存在或为空的目录";
                pick => { GameSettings.patch-pick-directory("output"); }
            }
        }

        if root.step == 4 : Panel {
            SectionTitle {
                text: root.locked ? "正在转换" : root.failed ? "转换失败" : "开始转换";
                description: root.locked || root.failed ? "" : "确认下面的设置后开始。转换期间可以随时取消，取消时不会生成输出目录。";
            }

            if !root.locked : VerticalLayout {
                spacing: 4px;
                MaterialText {
                    text: "补丁：" + (GameSettings.patch.script != "" ? (root.local-script ? GameSettings.patch.script : "已从补丁目录选择") : "未选择");
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                    overflow: clip;
                }
                MaterialText {
                    text: "补丁目录：" + (GameSettings.patch.patch-directory != "" ? GameSettings.patch.patch-directory : "游戏目录");
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                    overflow: clip;
                }
                MaterialText {
                    text: "输出目录：" + (GameSettings.patch.output-directory != "" ? GameSettings.patch.output-directory : "未选择");
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface;
                    wrap: word-wrap;
                    overflow: clip;
                }
            }

            if root.locked : VerticalLayout {
                spacing: Theme.space-sm;
                LinearProgressIndicator {
                    progress: root.determinate ? clamp(GameSettings.patch.completed / GameSettings.patch.total, 0, 1) : 0;
                    indeterminate: !root.determinate;
                }
                HorizontalLayout {
                    spacing: Theme.space-md;
                    MaterialText {
                        horizontal-stretch: 1;
                        text: GameSettings.patch.phase;
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                    if root.determinate : MaterialText {
                        horizontal-stretch: 0;
                        text: round(GameSettings.patch.completed / GameSettings.patch.total * 100) + "%";
                        style: MaterialTypography.label-large;
                        color: MaterialPalette.on-surface;
                    }
                }
            }

            if root.failed && !root.locked : Rectangle {
                border-radius: 8px;
                background: MaterialPalette.error-container;
                min-height: error-body.min-height;
                error-body := HorizontalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    VerticalLayout {
                        alignment: start;
                        Icon {
                            width: 20px;
                            source: Icons.error;
                            colorize: MaterialPalette.on-error-container;
                        }
                    }
                    MaterialText {
                        horizontal-stretch: 1;
                        text: GameSettings.patch.error;
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-error-container;
                        wrap: word-wrap;
                        overflow: clip;
                    }
                }
            }

            if !root.locked && !GameSettings.patch.can-start && GameSettings.patch.phase != "" : MaterialText {
                text: GameSettings.patch.phase;
                style: MaterialTypography.body-small;
                color: MaterialPalette.on-surface-variant;
                wrap: word-wrap;
                overflow: clip;
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.space-sm;
                if root.locked : OutlineButton {
                    text: "取消";
                    icon: Icons.close;
                    clicked => { GameSettings.patch-cancel(); }
                }
                if !root.locked : FilledButton {
                    text: root.failed ? "重新开始" : "开始转换";
                    icon: Icons.play-arrow;
                    enabled: GameSettings.patch.can-start && GameSettings.patch.script != "" && GameSettings.patch.output-directory != "";
                    clicked => { GameSettings.patch-start(); }
                }
            }
        }

        if root.step == 5 : Panel {
            HorizontalLayout {
                spacing: Theme.space-md;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: start;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: MaterialPalette.primary-container;
                        Icon {
                            width: 24px;
                            source: Icons.check;
                            colorize: MaterialPalette.on-primary-container;
                        }
                    }
                }
                SectionTitle {
                    horizontal-stretch: 1;
                    text: "转换完成";
                    description: GameSettings.patch.phase != "" ? GameSettings.patch.phase : "新作品已加入资料库。";
                }
            }
            MaterialText {
                text: "输出目录：" + GameSettings.patch.output;
                style: MaterialTypography.body-medium;
                color: MaterialPalette.on-surface;
                wrap: word-wrap;
                overflow: clip;
            }
            HorizontalLayout {
                alignment: end;
                FilledButton {
                    text: "打开新作品";
                    icon: Icons.library-books;
                    clicked => { GameSettings.patch-open-output(); }
                }
            }
        }

        if root.step <= 3 : HorizontalLayout {
            spacing: Theme.space-sm;
            if root.step > 1 : TextButton {
                text: "上一步";
                icon: Icons.arrow-back;
                clicked => { root.go(root.step - 1); }
            }
            Rectangle { horizontal-stretch: 1; }
            TonalButton {
                text: "下一步";
                enabled: root.step == 3 ? GameSettings.patch.output-directory != "" : GameSettings.patch.script != "";
                clicked => { root.go(root.step + 1); }
            }
        }

        if root.step == 4 && !root.locked : HorizontalLayout {
            alignment: start;
            TextButton {
                text: "上一步";
                icon: Icons.arrow-back;
                clicked => { root.go(3); }
            }
        }
    }
}
