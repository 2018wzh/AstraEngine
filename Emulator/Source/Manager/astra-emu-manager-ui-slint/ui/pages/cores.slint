import { ScrollView, Spinner } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Cores, CoreInfo, Library, Logs } from "../globals.slint";
import { Icons } from "../components/icons.slint";
import { PillButton, IconBtn, Card, Tag, SectionTitle } from "../components/controls.slint";

component CoreRow inherits Rectangle {
    in property <CoreInfo> info;
    private property <bool> menu-open: false;

    min-height: 88px;
    border-radius: Theme.r-lg;
    background: Theme.surface-container;

    pure function state-label(state: string) -> string {
        return state == "loaded" ? "已加载"
            : state == "pending-update" ? "将在重启后更新"
            : state == "pending-removal" ? "将在重启后移除"
            : state == "pending-install" ? (Library.can-load-cores ? "将在加载核心时安装" : "将在重启后安装")
            : "加载失败";
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        padding: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: Theme.primary-container;
                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: info.monogram;
                    color: Theme.on-primary-container;
                    font-size: Theme.title-sm;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: center;
                Text {
                    text: info.name;
                    color: Theme.on-surface;
                    font-size: Theme.title-sm;
                    font-weight: 650;
                    overflow: elide;
                }
                Text {
                    text: "版本 " + info.version + " · " + (info.source == "bundled" ? "随包提供" : "用户安装");
                    color: Theme.on-variant;
                    font-size: Theme.body-sm;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 6px;
                    for cap in info.capabilities : Tag { text: cap; }
                    Rectangle {
                        height: 26px;
                        width: badge.preferred-width + 16px;
                        border-radius: 13px;
                        background: info.state == "failed" ? Theme.error-container : Theme.surface-high;
                        badge := Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: root.state-label(info.state);
                            color: info.state == "failed" ? Theme.on-error-container : Theme.on-surface;
                            font-size: Theme.label;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            IconBtn {
                glyph: Icons.more;
                label: "更多";
                clicked => { root.menu-open = !root.menu-open; }
            }
        }

        if info.state == "failed" && info.message != "" : Rectangle {
            border-radius: Theme.r-md;
            background: Theme.error-container;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text {
                    text: info.message;
                    color: Theme.on-error-container;
                    font-size: Theme.body-sm;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    PillButton {
                        text: "查看日志";
                        variant: "text";
                        h: 32px;
                        clicked => {
                            Logs.core = info.file;
                            Logs.scope = "core";
                            Logs.open = true;
                            Logs.load(info.file);
                        }
                    }
                }
            }
        }

        if root.menu-open : HorizontalLayout {
            spacing: 8px;
            alignment: end;
            PillButton {
                text: "更新…";
                variant: "tonal";
                h: 32px;
                clicked => {
                    root.menu-open = false;
                    Cores.install();
                }
            }
            if info.removable : PillButton {
                text: "卸载";
                variant: "danger";
                h: 32px;
                clicked => {
                    root.menu-open = false;
                    Cores.uninstall(info.file);
                }
            }
        }
    }
}

export component CoresPage inherits Rectangle {
    background: Theme.surface;



    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            alignment: start;

            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        text: "核心";
                        color: Theme.on-surface;
                        font-size: Theme.headline;
                        font-weight: 700;
                    }
                    Text {
                        text: Cores.items.length + " 个核心";
                        color: Theme.on-variant;
                        font-size: Theme.body-sm;
                    }
                }
                if Library.busy : Spinner {
                    indeterminate: true;
                    width: 20px;
                    height: 20px;
                }
                PillButton {
                    text: "安装核心";
                    glyph: Icons.upload;
                    variant: "tonal";
                    clicked => { Cores.install(); }
                }
                PillButton {
                    text: "加载核心";
                    variant: "filled";
                    enabled: Library.can-load-cores;
                    clicked => { Cores.load(); }
                }
            }

            if Cores.restart-required : Card {
                background: Theme.primary-container;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: "核心变更将在重启后生效";
                            color: Theme.on-primary-container;
                            font-size: Theme.title-sm;
                            font-weight: 650;
                        }
                    }
                    PillButton {
                        text: "立即重启 AstraEMU";
                        glyph: Icons.power-off;
                        clicked => { Cores.restart(); }
                    }
                }
            }

            if Library.status != "" : Card {
                VerticalLayout {
                    padding: 14px;
                    Text {
                        text: Library.status;
                        color: Theme.on-surface;
                        font-size: Theme.body;
                        wrap: word-wrap;
                    }
                }
            }

            if Cores.items.length == 0 : VerticalLayout {
                spacing: 12px;
                alignment: center;
                Text {
                    text: "尚未加载核心";
                    color: Theme.on-surface;
                    font-size: Theme.title-lg;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    PillButton {
                        text: "加载核心";
                        enabled: Library.can-load-cores;
                        clicked => { Cores.load(); }
                    }
                    PillButton {
                        text: "安装核心";
                        variant: "outlined";
                        clicked => { Cores.install(); }
                    }
                }
            }

            if Cores.items.length > 0 : SectionTitle { text: "已安装"; }
            for item in Cores.items : CoreRow {
                info: item;
                visible: item.state == "loaded" || item.state == "pending-update" || item.state == "pending-removal";
                height: self.visible ? 88px : 0px;
            }

            if Cores.items.length > 0 : SectionTitle { text: "等待安装"; }
            for item in Cores.items : CoreRow {
                info: item;
                visible: item.state == "pending-install";
                height: self.visible ? 88px : 0px;
            }

            if Cores.items.length > 0 : SectionTitle { text: "加载失败"; }
            for item in Cores.items : CoreRow {
                info: item;
                visible: item.state == "failed";
                height: self.visible ? 88px : 0px;
            }

            Text {
                text: "可安装文件名以 astra_emu_ 开头的核心动态库；与随包核心同名的文件会覆盖随包版本。";
                color: Theme.on-variant;
                font-size: Theme.label;
                wrap: word-wrap;
            }
        }
    }
}
