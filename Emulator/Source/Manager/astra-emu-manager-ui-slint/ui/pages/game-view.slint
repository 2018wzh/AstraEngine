// Game view page - full-screen stage + auto-hiding M3 toolbar + M3 Bottom Sheet.

import { Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CheckButton, Icon, Icons } from "../components/icons.slint";
import { FloatingPanel } from "../components/floating-panel.slint";
import { M3Button, M3IconButton } from "../components/m3-widgets.slint";

export component GameViewPage inherits Rectangle {
    // Stage
    in property <image> stage-frame;
    in-out property <float> stage-native-width: 1024;
    in-out property <float> stage-native-height: 768;
    callback game-input(string, bool, float);
    callback leave-game();

    // Overlay panel visibility
    in-out property <bool> translation-overlay-active: false;
    in-out property <bool> diagnostics-overlay-active: false;
    in-out property <bool> patches-overlay-active: false;
    in-out property <bool> filters-overlay-active: false;
    property <bool> overlay-active: root.diagnostics-overlay-active || root.patches-overlay-active || root.filters-overlay-active;
    in-out property <string> enhance-tab: "filters";

    // Toolbar auto-hide: visible while pointer is near the top edge
    property <length> last-pointer-y: 0px;
    property <bool> toolbar-hover: root.last-pointer-y < 64px;
    property <float> stage-aspect: root.stage-native-width / root.stage-native-height;
    property <length> stage-width: root.width / root.height > root.stage-aspect ? root.height * root.stage-aspect : root.width;
    property <length> stage-height: root.width / root.height > root.stage-aspect ? root.height : root.width / root.stage-aspect;
    property <length> stage-x: (root.width - root.stage-width) / 2;
    property <length> stage-y: (root.height - root.stage-height) / 2;

    // Diagnostics panel state
    in-out property <length> diagnostics-x: 40px;
    in-out property <length> diagnostics-y: 120px;
    in-out property <bool> diagnostics-collapsed: false;
    in property <string> diagnostics-summary;
    in property <string> global-diagnostic;

    // Patches panel state
    in-out property <length> patches-x: 60px;
    in-out property <length> patches-y: 160px;
    in-out property <bool> patches-collapsed: false;
    in property <string> patches-summary;
    callback set-patch-mode(string);

    // Filters panel state
    in-out property <length> filters-x: 80px;
    in-out property <length> filters-y: 200px;
    in-out property <bool> filters-collapsed: false;
    in-out property <string> filter-preset: "none";
    callback set-filter-preset(string);

    background: black;
    init => { game-focus.focus(); }

    // Game stage image
    Image {
        source: root.stage-frame;
        x: root.stage-x;
        y: root.stage-y;
        width: root.stage-width;
        height: root.stage-height;
        image-fit: fill;
        accessible-label: "Legacy game stage";
    }

    // Game input focus scope
    game-focus := FocusScope {
        key-pressed(event) => {
            if root.overlay-active { return reject; }
            if event.text == Key.Return { root.game-input("enter", true, 1); return accept; }
            if event.text == Key.Escape { root.game-input("escape", true, 1); return accept; }
            if event.text == Key.UpArrow { root.game-input("arrow_up", true, 1); return accept; }
            if event.text == Key.DownArrow { root.game-input("arrow_down", true, 1); return accept; }
            if event.text == Key.LeftArrow { root.game-input("arrow_left", true, 1); return accept; }
            if event.text == Key.RightArrow { root.game-input("arrow_right", true, 1); return accept; }
            if event.text == Key.Control { root.game-input("control", true, 1); return accept; }
            if event.text == " " { root.game-input("space", true, 1); return accept; }
            return reject;
        }
        key-released(event) => {
            if root.overlay-active { return reject; }
            if event.text == Key.Return { root.game-input("enter", false, 0); return accept; }
            if event.text == Key.Escape { root.game-input("escape", false, 0); return accept; }
            if event.text == Key.UpArrow { root.game-input("arrow_up", false, 0); return accept; }
            if event.text == Key.DownArrow { root.game-input("arrow_down", false, 0); return accept; }
            if event.text == Key.LeftArrow { root.game-input("arrow_left", false, 0); return accept; }
            if event.text == Key.RightArrow { root.game-input("arrow_right", false, 0); return accept; }
            if event.text == Key.Control { root.game-input("control", false, 0); return accept; }
            if event.text == " " { root.game-input("space", false, 0); return accept; }
            return reject;
        }

        TouchArea {
            moved => {
                root.last-pointer-y = self.mouse-y;
                if root.stage-width > 0px && root.stage-height > 0px && self.mouse-x >= root.stage-x && self.mouse-x < root.stage-x + root.stage-width && self.mouse-y >= root.stage-y && self.mouse-y < root.stage-y + root.stage-height {
                    root.game-input("pointer.x", true, (self.mouse-x - root.stage-x) / root.stage-width * root.stage-native-width);
                    root.game-input("pointer.y", true, (self.mouse-y - root.stage-y) / root.stage-height * root.stage-native-height);
                }
            }
            clicked => {
                if root.stage-width > 0px && root.stage-height > 0px && self.mouse-x >= root.stage-x && self.mouse-x < root.stage-x + root.stage-width && self.mouse-y >= root.stage-y && self.mouse-y < root.stage-y + root.stage-height {
                    root.game-input("pointer.x", true, (self.mouse-x - root.stage-x) / root.stage-width * root.stage-native-width);
                    root.game-input("pointer.y", true, (self.mouse-y - root.stage-y) / root.stage-height * root.stage-native-height);
                    root.game-input("pointer.primary", true, 1);
                    root.game-input("pointer.primary", false, 0);
                }
            }
            scroll-event(event) => {
                root.game-input("wheel", false, event.delta-y / 1px);
                return accept;
            }
        }
    }

    // Auto-hiding top toolbar (M3 Stadium App Bar on hover near top)
    toolbar-area := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 64px;
        z: 50;

        Rectangle {
            x: 16px;
            y: 10px;
            width: parent.width - 32px;
            height: 46px;
            background: Theme.surface-overlay;
            border-radius: 23px;
            border-width: 1px;
            border-color: Theme.outline-variant;
            opacity: root.toolbar-hover ? 1 : 0;
            animate opacity { duration: 150ms; }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;

                M3Button {
                    text: "返回管理器";
                    icon: Icons.arrow-left;
                    variant: "tonal";
                    clicked => { root.leave-game(); }
                }

                Rectangle { horizontal-stretch: 1; }

                CheckButton {
                    label: "运行时诊断";
                    checked: root.diagnostics-overlay-active;
                    clicked => {
                        root.translation-overlay-active = false;
                        root.patches-overlay-active = false;
                        root.filters-overlay-active = false;
                        if root.diagnostics-overlay-active { root.diagnostics-overlay-active = false; } else { root.diagnostics-overlay-active = true; root.enhance-tab = "diagnostics"; }
                    }
                }
                CheckButton {
                    label: "Luau 补丁";
                    checked: root.patches-overlay-active;
                    clicked => {
                        root.translation-overlay-active = false;
                        root.diagnostics-overlay-active = false;
                        root.filters-overlay-active = false;
                        if root.patches-overlay-active { root.patches-overlay-active = false; } else { root.patches-overlay-active = true; root.enhance-tab = "patches"; }
                    }
                }
                CheckButton {
                    label: "视觉滤镜";
                    checked: root.filters-overlay-active;
                    clicked => {
                        root.translation-overlay-active = false;
                        root.diagnostics-overlay-active = false;
                        root.patches-overlay-active = false;
                        if root.filters-overlay-active { root.filters-overlay-active = false; } else { root.filters-overlay-active = true; root.enhance-tab = "filters"; }
                    }
                }
            }
        }
    }

    // Unified enhance bottom sheet (M3 Bottom Sheet with drag handle)
    if root.overlay-active : Rectangle {
        x: (parent.width - min(parent.width, 680px)) / 2;
        y: root.height - 360px;
        width: min(parent.width, 680px);
        height: 360px;
        background: Theme.surface-container-high;
        border-radius: Theme.shape-xl;
        border-width: 1px;
        border-color: Theme.outline-variant;
        clip: true;
        z: 60;
        animate y { duration: 180ms; easing: ease-out; }

        VerticalLayout {
            spacing: 0px;

            // Drag handle bar
            Rectangle {
                height: 20px;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.outline;
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                }
            }

            // M3 Segmented tab bar
            HorizontalLayout {
                height: 40px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 4px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: root.enhance-tab == "diagnostics" ? Theme.primary-container : Theme.surface-container;
                        Text {
                            text: "诊断";
                            color: root.enhance-tab == "diagnostics" ? Theme.on-primary-container : Theme.on-surface-variant;
                            font-size: Theme.font-label-lg;
                            font-weight: root.enhance-tab == "diagnostics" ? 700 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.enhance-tab = "diagnostics"; root.diagnostics-overlay-active = true; root.patches-overlay-active = false; root.filters-overlay-active = false; } }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: root.enhance-tab == "patches" ? Theme.primary-container : Theme.surface-container;
                        Text {
                            text: "补丁";
                            color: root.enhance-tab == "patches" ? Theme.on-primary-container : Theme.on-surface-variant;
                            font-size: Theme.font-label-lg;
                            font-weight: root.enhance-tab == "patches" ? 700 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.enhance-tab = "patches"; root.diagnostics-overlay-active = false; root.patches-overlay-active = true; root.filters-overlay-active = false; } }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: root.enhance-tab == "filters" ? Theme.primary-container : Theme.surface-container;
                        Text {
                            text: "滤镜";
                            color: root.enhance-tab == "filters" ? Theme.on-primary-container : Theme.on-surface-variant;
                            font-size: Theme.font-label-lg;
                            font-weight: root.enhance-tab == "filters" ? 700 : 400;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.enhance-tab = "filters"; root.diagnostics-overlay-active = false; root.patches-overlay-active = false; root.filters-overlay-active = true; } }
                    }
                }

            Rectangle { height: 1px; background: Theme.outline-variant; }

            // Content area
            if root.enhance-tab == "diagnostics" : VerticalLayout {
                padding: 16px;
                spacing: 10px;
                vertical-stretch: 1;

                Text { text: "当前运行状态诊断"; color: Theme.on-surface; font-size: Theme.font-title-sm; font-weight: 600; }
                Text { text: root.diagnostics-summary; color: Theme.on-surface-variant; wrap: word-wrap; font-size: Theme.font-body-sm; }
                Text {
                    text: root.global-diagnostic == "" ? "运行环境正常，无阻断性异常。" : root.global-diagnostic;
                    color: root.global-diagnostic == "" ? Theme.on-success-container : Theme.error;
                    wrap: word-wrap;
                    font-size: Theme.font-body-sm;
                }
            }

            if root.enhance-tab == "patches" : VerticalLayout {
                padding: 16px;
                spacing: 10px;
                vertical-stretch: 1;

                Text { text: "Trusted Luau 补丁策略"; color: Theme.on-surface; font-size: Theme.font-title-sm; font-weight: 600; }
                Text { text: root.patches-summary; color: Theme.on-surface-variant; wrap: word-wrap; font-size: Theme.font-body-sm; }
                HorizontalLayout {
                    spacing: 10px;
                    M3Button { text: "无补丁模式 (no_patch)"; variant: "outlined"; clicked => { root.set-patch-mode("no_patch"); } }
                    M3Button { text: "强制签名补丁 (trusted)"; variant: "tonal"; clicked => { root.set-patch-mode("trusted"); } }
                }
            }

            if root.enhance-tab == "filters" : VerticalLayout {
                padding: 16px;
                spacing: 10px;
                vertical-stretch: 1;

                Text { text: "后处理着色器滤镜 (Final-frame Shader)"; color: Theme.primary; font-size: Theme.font-title-sm; font-weight: 600; }
                Text {
                    text: "实时 GPU 着色管线驱动，复用双缓冲纹理零开销呈现。";
                    color: Theme.on-surface-variant;
                    wrap: word-wrap;
                    font-size: Theme.font-body-sm;
                }
                HorizontalLayout {
                    spacing: 8px;
                    CheckButton { label: "原画 (Off)"; checked: root.filter-preset == "none"; clicked => { root.set-filter-preset("none"); } }
                    CheckButton { label: "灰度 (Grayscale)"; checked: root.filter-preset == "grayscale"; clicked => { root.set-filter-preset("grayscale"); } }
                    CheckButton { label: "柔和 CRT"; checked: root.filter-preset == "crt-soft"; clicked => { root.set-filter-preset("crt-soft"); } }
                    CheckButton { label: "暖色 (Warm)"; checked: root.filter-preset == "warm"; clicked => { root.set-filter-preset("warm"); } }
                }
            }

            // Close button row
            Rectangle {
                height: 48px;
                HorizontalLayout {
                    alignment: center;
                    M3Button {
                        text: "收起面板";
                        variant: "tonal";
                        clicked => {
                            root.diagnostics-overlay-active = false;
                            root.patches-overlay-active = false;
                            root.filters-overlay-active = false;
                        }
                    }
                }
            }
        }
    }
}
