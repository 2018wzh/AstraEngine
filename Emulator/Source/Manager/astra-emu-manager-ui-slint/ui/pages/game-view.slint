// Game view page - full-screen stage + auto-hiding toolbar + floating overlay panels.

import { Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CheckButton } from "../components/icons.slint";
import { FloatingPanel } from "../components/floating-panel.slint";

export struct SystemMenuItem {
    item-id: string,
    label: string,
    depth: int,
    enabled: bool,
    checked: bool,
    separator: bool,
    submenu: bool,
}

export component GameViewPage inherits Rectangle {
    // Stage
    in property <image> stage-frame;
    in-out property <float> stage-native-width: 1024;
    in-out property <float> stage-native-height: 768;
    callback game-input(string, bool, float);
    callback leave-game();
    in property <[SystemMenuItem]> system-menu-items;
    in property <bool> system-menu-active: false;
    in property <float> system-menu-x: 0;
    in property <float> system-menu-y: 0;
    callback system-menu-select(string);
    callback system-menu-dismiss();

    // Overlay panel visibility
    in-out property <bool> translation-overlay-active: false;
    in-out property <bool> diagnostics-overlay-active: false;
    in-out property <bool> filters-overlay-active: false;
    property <bool> overlay-active: root.diagnostics-overlay-active || root.filters-overlay-active || root.system-menu-active;

    // Toolbar auto-hide: visible while pointer is near the top edge
    property <length> last-pointer-y: 0px;
    property <bool> toolbar-hover: root.last-pointer-y < 60px;
    property <float> stage-aspect: root.stage-native-width / root.stage-native-height;
    property <length> stage-width: root.width / root.height > root.stage-aspect ? root.height * root.stage-aspect : root.width;
    property <length> stage-height: root.width / root.height > root.stage-aspect ? root.height : root.width / root.stage-aspect;
    property <length> stage-x: (root.width - root.stage-width) / 2;
    property <length> stage-y: (root.height - root.stage-height) / 2;

    // Diagnostics panel state
    in-out property <length> diagnostics-x: 40px;
    in-out property <length> diagnostics-y: 120px;
    in-out property <bool> diagnostics-collapsed: false;
    in property <string> diagnostics-summary;
    in property <string> global-diagnostic;

    // Filters panel state
    in-out property <length> filters-x: 80px;
    in-out property <length> filters-y: 200px;
    in-out property <bool> filters-collapsed: false;
    in-out property <string> filter-preset: "none";
    callback set-filter-preset(string);

    background: black;
    init => { game-focus.focus(); }

    // Game stage image
    Image {
        source: root.stage-frame;
        x: root.stage-x;
        y: root.stage-y;
        width: root.stage-width;
        height: root.stage-height;
        image-fit: fill;
        accessible-label: "Legacy game stage";
    }

    // Game input focus scope
    game-focus := FocusScope {
        key-pressed(event) => {
            if root.overlay-active { return reject; }
            if event.text == Key.Return { root.game-input("enter", true, 1); return accept; }
            if event.text == Key.Escape { root.game-input("escape", true, 1); return accept; }
            if event.text == Key.UpArrow { root.game-input("arrow_up", true, 1); return accept; }
            if event.text == Key.DownArrow { root.game-input("arrow_down", true, 1); return accept; }
            if event.text == Key.LeftArrow { root.game-input("arrow_left", true, 1); return accept; }
            if event.text == Key.RightArrow { root.game-input("arrow_right", true, 1); return accept; }
            if event.text == Key.Control { root.game-input("control", true, 1); return accept; }
            if event.text == " " { root.game-input("space", true, 1); return accept; }
            return reject;
        }
        key-released(event) => {
            if root.overlay-active { return reject; }
            if event.text == Key.Return { root.game-input("enter", false, 0); return accept; }
            if event.text == Key.Escape { root.game-input("escape", false, 0); return accept; }
            if event.text == Key.UpArrow { root.game-input("arrow_up", false, 0); return accept; }
            if event.text == Key.DownArrow { root.game-input("arrow_down", false, 0); return accept; }
            if event.text == Key.LeftArrow { root.game-input("arrow_left", false, 0); return accept; }
            if event.text == Key.RightArrow { root.game-input("arrow_right", false, 0); return accept; }
            if event.text == Key.Control { root.game-input("control", false, 0); return accept; }
            if event.text == " " { root.game-input("space", false, 0); return accept; }
            return reject;
        }

        TouchArea {
            moved => {
                root.last-pointer-y = self.mouse-y;
                if root.stage-width > 0px && root.stage-height > 0px && self.mouse-x >= root.stage-x && self.mouse-x < root.stage-x + root.stage-width && self.mouse-y >= root.stage-y && self.mouse-y < root.stage-y + root.stage-height {
                    root.game-input("pointer.x", true, (self.mouse-x - root.stage-x) / root.stage-width * root.stage-native-width);
                    root.game-input("pointer.y", true, (self.mouse-y - root.stage-y) / root.stage-height * root.stage-native-height);
                }
            }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
                    if root.stage-width > 0px && root.stage-height > 0px && self.mouse-x >= root.stage-x && self.mouse-x < root.stage-x + root.stage-width && self.mouse-y >= root.stage-y && self.mouse-y < root.stage-y + root.stage-height {
                        root.game-input("pointer.x", true, (self.mouse-x - root.stage-x) / root.stage-width * root.stage-native-width);
                        root.game-input("pointer.y", true, (self.mouse-y - root.stage-y) / root.stage-height * root.stage-native-height);
                        root.game-input("pointer.secondary", event.kind == PointerEventKind.down, event.kind == PointerEventKind.down ? 1 : 0);
                    }
                }
            }
            clicked => {
                if root.stage-width > 0px && root.stage-height > 0px && self.mouse-x >= root.stage-x && self.mouse-x < root.stage-x + root.stage-width && self.mouse-y >= root.stage-y && self.mouse-y < root.stage-y + root.stage-height {
                    root.game-input("pointer.x", true, (self.mouse-x - root.stage-x) / root.stage-width * root.stage-native-width);
                    root.game-input("pointer.y", true, (self.mouse-y - root.stage-y) / root.stage-height * root.stage-native-height);
                    root.game-input("pointer.primary", true, 1);
                    root.game-input("pointer.primary", false, 0);
                }
            }
            scroll-event(event) => {
                root.game-input("wheel", false, event.delta-y / 1px);
                return accept;
            }
        }
    }

    // Auto-hiding top toolbar (shows on hover near top)
    toolbar-area := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 60px;
        z: 50;

        Rectangle {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            height: 48px;
            background: #cc1a1d24;
            border-radius: Theme.radius;
            opacity: root.toolbar-hover ? 1 : 0;

            HorizontalLayout {
                padding: 8px;
                spacing: 6px;

                Button {
                    text: "Back";
                    clicked => { root.leave-game(); }
                }

                Rectangle { horizontal-stretch: 1; }

                CheckButton {
                    label: "Diagnostics";
                    checked: root.diagnostics-overlay-active;
                    clicked => {
                        root.translation-overlay-active = false;
                        root.filters-overlay-active = false;
                        root.diagnostics-overlay-active = !root.diagnostics-overlay-active;
                    }
                }
                CheckButton {
                    label: "Filters";
                    checked: root.filters-overlay-active;
                    clicked => {
                        root.translation-overlay-active = false;
                        root.diagnostics-overlay-active = false;
                        root.filters-overlay-active = !root.filters-overlay-active;
                    }
                }
            }
        }
    }

    // Floating panels
    if root.diagnostics-overlay-active : FloatingPanel {
        panel-title: "Runtime diagnostics";
        panel-x <=> root.diagnostics-x;
        panel-y <=> root.diagnostics-y;
        collapsed <=> root.diagnostics-collapsed;
        panel-width: 380px;
        panel-height: 240px;
        z: 60;
        close => { root.diagnostics-overlay-active = false; }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.diagnostics-summary;
                color: Theme.text-muted;
                wrap: word-wrap;
                font-size: 13px;
            }
            Text {
                text: root.global-diagnostic == "" ? "No blocking diagnostic." : root.global-diagnostic;
                color: root.global-diagnostic == "" ? Theme.primary : Theme.danger;
                wrap: word-wrap;
                font-size: 13px;
            }
        }
    }

    if root.filters-overlay-active : FloatingPanel {
        panel-title: "Final-frame filter";
        panel-x <=> root.filters-x;
        panel-y <=> root.filters-y;
        collapsed <=> root.filters-collapsed;
        panel-width: 380px;
        panel-height: 280px;
        z: 60;
        close => { root.filters-overlay-active = false; }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: "FVP does not expose stable layer metadata, so per-layer bindings are blocked and only final-frame presets are available.";
                color: Theme.text-muted;
                wrap: word-wrap;
                font-size: 12px;
            }
            CheckButton { label: "Off"; checked: root.filter-preset == "none"; clicked => { root.set-filter-preset("none"); } }
            CheckButton { label: "Grayscale"; checked: root.filter-preset == "grayscale"; clicked => { root.set-filter-preset("grayscale"); } }
            CheckButton { label: "CRT Soft"; checked: root.filter-preset == "crt-soft"; clicked => { root.set-filter-preset("crt-soft"); } }
            CheckButton { label: "Warm"; checked: root.filter-preset == "warm"; clicked => { root.set-filter-preset("warm"); } }
        }
    }

    if root.system-menu-active : TouchArea {
        z: 80;
        width: parent.width;
        height: parent.height;
        clicked => { root.system-menu-dismiss(); }

        menu-panel := Rectangle {
            x: min(root.width - self.width - 8px, max(8px, root.stage-x + root.system-menu-x / root.stage-native-width * root.stage-width));
            y: min(root.height - self.height - 8px, max(8px, root.stage-y + root.system-menu-y / root.stage-native-height * root.stage-height));
            width: 380px;
            height: menu-layout.preferred-height + 12px;
            background: Theme.surface-overlay;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 4px;

            menu-layout := VerticalLayout {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                spacing: 0px;
                for item in root.system-menu-items : Rectangle {
                    height: item.separator ? 9px : 30px;
                    background: transparent;
                    if item.separator : Rectangle {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: 1px;
                        background: Theme.border;
                    }
                    if !item.separator : Button {
                        x: item.depth * 16px;
                        width: parent.width - self.x;
                        height: parent.height;
                        enabled: item.enabled && !item.submenu;
                        text: (item.checked ? "✓  " : "    ") + item.label + (item.submenu ? "  ▶" : "");
                        clicked => { root.system-menu-select(item.item-id); }
                    }
                }
            }
        }
    }
}
