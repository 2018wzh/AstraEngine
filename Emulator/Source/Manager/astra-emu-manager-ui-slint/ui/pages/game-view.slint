// Game view page - unobstructed stage below the host toolbar.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CheckButton, Icons } from "../components/icons.slint";
import { M3Button } from "../components/m3-widgets.slint";
import { ConfigField } from "../components/generic-config.slint";
import { FilterSettingsPage } from "../settings/filters.slint";

export component GameViewPage inherits Rectangle {
    // Stage
    in property <image> stage-frame;
    in-out property <float> stage-native-width: 1024;
    in-out property <float> stage-native-height: 768;
    in-out property <float> stage-raster-width: 1024;
    in-out property <float> stage-raster-height: 768;
    in-out property <float> stage-content-x: 0;
    in-out property <float> stage-content-y: 0;
    in-out property <float> stage-content-width: 1024;
    in-out property <float> stage-content-height: 768;
    callback game-input(string, bool, float);
    callback leave-game();
    in property <bool> input-blocked: false;

    // Overlay panel visibility
    in-out property <bool> translation-overlay-active: false;
    in-out property <bool> diagnostics-overlay-active: false;
    in-out property <bool> filters-overlay-active: false;
    property <bool> overlay-active: root.translation-overlay-active || root.diagnostics-overlay-active || root.filters-overlay-active;
    in-out property <string> enhance-tab: "filters";

    // Keep host controls outside the game's original input and image area.
    property <length> toolbar-height: 64px;
    property <length> stage-available-height: max(1px, root.height - root.toolbar-height);
    in property <float> stage-output-aspect: 1.333333;
    property <float> stage-aspect: root.stage-output-aspect;
    property <length> stage-width: root.width / root.stage-available-height > root.stage-aspect ? root.stage-available-height * root.stage-aspect : root.width;
    property <length> stage-height: root.width / root.stage-available-height > root.stage-aspect ? root.stage-available-height : root.width / root.stage-aspect;
    property <length> stage-x: (root.width - root.stage-width) / 2;
    property <length> stage-y: root.toolbar-height + (root.stage-available-height - root.stage-height) / 2;
    property <length> content-stage-x: root.stage-raster-width > 0 ? root.stage-x + root.stage-content-x / root.stage-raster-width * root.stage-width : root.stage-x;
    property <length> content-stage-y: root.stage-raster-height > 0 ? root.stage-y + root.stage-content-y / root.stage-raster-height * root.stage-height : root.stage-y;
    property <length> content-stage-width: root.stage-raster-width > 0 ? root.stage-content-width / root.stage-raster-width * root.stage-width : 0px;
    property <length> content-stage-height: root.stage-raster-height > 0 ? root.stage-content-height / root.stage-raster-height * root.stage-height : 0px;
    // Export the same viewport used by input, in window logical pixels.
    in-out property <float> pointer-content-x: (root.absolute-position.x + root.content-stage-x) / 1px;
    in-out property <float> pointer-content-y: (root.absolute-position.y + root.content-stage-y) / 1px;
    in-out property <float> pointer-content-width: root.content-stage-width / 1px;
    in-out property <float> pointer-content-height: root.content-stage-height / 1px;

    // Diagnostics panel state
    in-out property <length> diagnostics-x: 40px;
    in-out property <length> diagnostics-y: 120px;
    in-out property <bool> diagnostics-collapsed: false;
    in property <string> diagnostics-summary;
    in property <string> global-diagnostic;

    // Filters panel state
    in-out property <length> filters-x: 80px;
    in-out property <length> filters-y: 200px;
    in-out property <bool> filters-collapsed: false;
    in-out property <string> filter-preset: "none";
    callback set-filter-preset(string);
    in property <[ConfigField]> filter-config-fields;
    callback filter-config-changed(string, string);
    callback load-filter-source();
    callback save-filter-config();
    callback reset-filter-config();

    background: black;
    init => { game-focus.focus(); }

    // Game stage image
    Image {
        source: root.stage-frame;
        x: root.stage-x;
        y: root.stage-y;
        width: root.stage-width;
        height: root.stage-height;
        image-fit: fill;
        accessible-label: "游戏画面";
    }

    // Game input focus scope
    game-focus := FocusScope {

        TouchArea {
            // HostPointer owns visibility; Slint only selects control shapes.
            moved => {
                if root.overlay-active || root.input-blocked { return; }
                if root.content-stage-width > 0px && root.content-stage-height > 0px && self.mouse-x >= root.content-stage-x && self.mouse-x < root.content-stage-x + root.content-stage-width && self.mouse-y >= root.content-stage-y && self.mouse-y < root.content-stage-y + root.content-stage-height {
                    root.game-input("pointer.x", true, (self.mouse-x - root.content-stage-x) / root.content-stage-width * root.stage-native-width);
                    root.game-input("pointer.y", true, (self.mouse-y - root.content-stage-y) / root.content-stage-height * root.stage-native-height);
                }
            }
            pointer-event(event) => {
                if root.overlay-active || root.input-blocked { return; }
                if event.kind == PointerEventKind.cancel {
                    root.game-input("pointer.primary", false, 0);
                    root.game-input("pointer.secondary", false, 0);
                    root.game-input("pointer.middle", false, 0);
                    return;
                }
                if event.kind != PointerEventKind.down && event.kind != PointerEventKind.up { return; }
                if self.mouse-x < root.content-stage-x || self.mouse-x >= root.content-stage-x + root.content-stage-width || self.mouse-y < root.content-stage-y || self.mouse-y >= root.content-stage-y + root.content-stage-height {
                    if event.kind == PointerEventKind.up {
                        if event.button == PointerEventButton.left { root.game-input("pointer.primary", false, 0); }
                        if event.button == PointerEventButton.right { root.game-input("pointer.secondary", false, 0); }
                        if event.button == PointerEventButton.middle { root.game-input("pointer.middle", false, 0); }
                    }
                    return;
                }
                if event.kind == PointerEventKind.down { game-focus.focus(); }
                root.game-input("pointer.x", true, (self.mouse-x - root.content-stage-x) / root.content-stage-width * root.stage-native-width);
                root.game-input("pointer.y", true, (self.mouse-y - root.content-stage-y) / root.content-stage-height * root.stage-native-height);
                if event.button == PointerEventButton.left { root.game-input("pointer.primary", event.kind == PointerEventKind.down, 1); }
                if event.button == PointerEventButton.right { root.game-input("pointer.secondary", event.kind == PointerEventKind.down, 1); }
                if event.button == PointerEventButton.middle { root.game-input("pointer.middle", event.kind == PointerEventKind.down, 1); }
            }
            scroll-event(event) => {
                if root.overlay-active || root.input-blocked { return reject; }
                if self.mouse-x < root.content-stage-x || self.mouse-x >= root.content-stage-x + root.content-stage-width || self.mouse-y < root.content-stage-y || self.mouse-y >= root.content-stage-y + root.content-stage-height {
                    return reject;
                }
                root.game-input("wheel", false, event.delta-y / 60px);
                return accept;
            }
        }
    }

    // Persistent host toolbar above the stage.
    toolbar-area := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.toolbar-height;
        z: 50;
        background: Theme.surface-container-low;
        TouchArea {}
        Rectangle {
            x: 16px;
            y: 10px;
            width: parent.width - 32px;
            height: 46px;
            background: Theme.surface-container;
            border-radius: Theme.shape-lg;
            border-width: 1px;
            border-color: Theme.outline-variant;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;

                M3Button {
                    text: root.width < 480px ? "返回" : "返回管理器";
                    icon: Icons.arrow-left;
                    variant: "tonal";
                    clicked => { root.leave-game(); }
                }

                Rectangle { horizontal-stretch: 1; }

                CheckButton {
                    label: "诊断";
                    checked: root.diagnostics-overlay-active;
                    clicked => {
                        root.translation-overlay-active = false;
                        root.filters-overlay-active = false;
                        if root.diagnostics-overlay-active { root.diagnostics-overlay-active = false; } else { root.diagnostics-overlay-active = true; root.enhance-tab = "diagnostics"; }
                    }
                }
                CheckButton {
                    label: "滤镜";
                    checked: root.filters-overlay-active;
                    clicked => {
                        root.translation-overlay-active = false;
                        root.diagnostics-overlay-active = false;
                        if root.filters-overlay-active { root.filters-overlay-active = false; } else { root.filters-overlay-active = true; root.enhance-tab = "filters"; }
                    }
                }
            }
        }
    }

    // Modal host sheet: the game stays visible, but receives no pointer input.
    if root.overlay-active : Rectangle {
        y: root.toolbar-height;
        height: parent.height - self.y;
        background: #0006;
        z: 60;
        TouchArea {
            clicked => {
                root.translation-overlay-active = false;
                root.diagnostics-overlay-active = false;
                root.filters-overlay-active = false;
            }
        }

        Rectangle {
            x: parent.width - self.width;
            width: min(parent.width, 600px);
            height: parent.height;
            background: Theme.surface;
            TouchArea {}
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: root.enhance-tab == "filters" ? "画面滤镜" : "运行诊断";
                        color: Theme.on-surface;
                        font-size: Theme.font-title-lg;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    M3Button {
                        text: "关闭";
                        variant: "tonal";
                        clicked => {
                            root.translation-overlay-active = false;
                            root.diagnostics-overlay-active = false;
                            root.filters-overlay-active = false;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.outline-variant; }
                if root.enhance-tab == "diagnostics" : ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;
                        alignment: start;
                        Text {
                            text: root.diagnostics-summary == "" ? "尚无运行诊断数据" : root.diagnostics-summary;
                            color: Theme.on-surface;
                            wrap: word-wrap;
                            font-size: Theme.font-body-md;
                        }
                        Text {
                            text: root.global-diagnostic == "" ? "当前没有诊断消息" : root.global-diagnostic;
                            color: root.global-diagnostic == "" ? Theme.on-surface-variant : Theme.error;
                            wrap: word-wrap;
                            font-size: Theme.font-body-md;
                        }
                    }
                }
                if root.enhance-tab == "filters" : FilterSettingsPage {
                    filter-preset <=> root.filter-preset;
                    filter-config-fields: root.filter-config-fields;
                    set-filter-preset(preset) => { root.set-filter-preset(preset); }
                    filter-config-changed(key, value) => { root.filter-config-changed(key, value); }
                    load-filter-source => { root.load-filter-source(); }
                    save-filter-config => { root.save-filter-config(); }
                    reset-filter-config => { root.reset-filter-config(); }
                }
            }
        }
    }
}
