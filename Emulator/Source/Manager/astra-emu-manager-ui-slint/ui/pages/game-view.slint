import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Session, Selection, Dialogs, Filters } from "../globals.slint";
import { Icon, Icons } from "../components/icons.slint";
import { IconBtn, Toast } from "../components/controls.slint";
import { GenericConfigForm } from "../components/generic-config.slint";
import { FilterPresetGrid } from "../settings/filters.slint";

component MenuRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <color> fg: Theme.on-surface;
    callback clicked();
    height: 52px;
    background: area.has-hover ? Theme.surface-high : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 14px;
        Icon {
            glyph: root.glyph;
            font-size: 16px;
            width: 22px;
            color: root.fg;
        }
        Text {
            text: root.label;
            color: root.fg;
            font-size: Theme.body;
            font-weight: 550;
            vertical-alignment: center;
        }
    }

    row-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                row-focus.focus();
                root.clicked();
            }
        }
    }
}

export component GameViewPage inherits Rectangle {
    background: #000000;

    property <length> stage-available-height: root.height;
    property <float> stage-aspect: Session.output-aspect;
    property <length> stage-width: root.width / root.stage-available-height > root.stage-aspect ? root.stage-available-height * root.stage-aspect : root.width;
    property <length> stage-height: root.width / root.stage-available-height > root.stage-aspect ? root.stage-available-height : root.width / root.stage-aspect;
    property <length> stage-x: (root.width - root.stage-width) / 2;
    property <length> stage-y: (root.stage-available-height - root.stage-height) / 2;
    property <length> content-stage-x: Session.raster-width > 0 ? root.stage-x + Session.content-x / Session.raster-width * root.stage-width : root.stage-x;
    property <length> content-stage-y: Session.raster-height > 0 ? root.stage-y + Session.content-y / Session.raster-height * root.stage-height : root.stage-y;
    property <length> content-stage-width: Session.raster-width > 0 ? Session.content-width / Session.raster-width * root.stage-width : 0px;
    property <length> content-stage-height: Session.raster-height > 0 ? Session.content-height / Session.raster-height * root.stage-height : 0px;

    property <float> computed-px: (root.absolute-position.x + root.content-stage-x) / 1px;
    property <float> computed-py: (root.absolute-position.y + root.content-stage-y) / 1px;
    property <float> computed-pw: root.content-stage-width / 1px;
    property <float> computed-ph: root.content-stage-height / 1px;

    property <bool> input-blocked: Session.menu-open || Dialogs.modal-active || Dialogs.fatal-active;
    property <bool> handle-visible: true;
    property <bool> hint-visible: true;
    property <bool> panel-seen: false;
    property <length> menu-w: min(360px, root.width);

    function push-pointer() {
        Session.pointer-x = root.computed-px;
        Session.pointer-y = root.computed-py;
        Session.pointer-width = root.computed-pw;
        Session.pointer-height = root.computed-ph;
    }
    function ping-handle() {
        root.handle-visible = true;
        idle-timer.running = false;
        idle-timer.running = true;
    }
    function open-menu() {
        Session.menu-open = true;
        Session.menu-page = "main";
    }
    function close-menu() {
        Session.menu-open = false;
        Session.menu-page = "main";
        root.panel-seen = false;
    }

    init => {
        game-focus.focus();
        root.push-pointer();
        idle-timer.running = true;
        hint-timer.running = true;
    }
    changed computed-px => { root.push-pointer(); }
    changed computed-py => { root.push-pointer(); }
    changed computed-pw => { root.push-pointer(); }
    changed computed-ph => { root.push-pointer(); }

    idle-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { root.handle-visible = false; }
    }
    hint-timer := Timer {
        interval: 3s;
        running: false;
        triggered => { root.hint-visible = false; }
    }

    Image {
        source: Session.frame;
        x: root.stage-x;
        y: root.stage-y;
        width: root.stage-width;
        height: root.stage-height;
        image-fit: fill;
        accessible-label: "游戏画面";
    }

    game-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        game-area := TouchArea {
            moved => {
                root.ping-handle();
                if root.input-blocked { return; }
                if root.content-stage-width > 0px && root.content-stage-height > 0px && self.mouse-x >= root.content-stage-x && self.mouse-x < root.content-stage-x + root.content-stage-width && self.mouse-y >= root.content-stage-y && self.mouse-y < root.content-stage-y + root.content-stage-height {
                    Session.input("pointer.x", true, (self.mouse-x - root.content-stage-x) / root.content-stage-width * Session.native-width);
                    Session.input("pointer.y", true, (self.mouse-y - root.content-stage-y) / root.content-stage-height * Session.native-height);
                }
            }
            pointer-event(event) => {
                root.ping-handle();
                if root.input-blocked { return; }
                if event.kind == PointerEventKind.cancel {
                    Session.input("pointer.primary", false, 0);
                    Session.input("pointer.secondary", false, 0);
                    Session.input("pointer.middle", false, 0);
                    return;
                }
                if event.kind != PointerEventKind.down && event.kind != PointerEventKind.up { return; }
                if self.mouse-x < root.content-stage-x || self.mouse-x >= root.content-stage-x + root.content-stage-width || self.mouse-y < root.content-stage-y || self.mouse-y >= root.content-stage-y + root.content-stage-height {
                    if event.kind == PointerEventKind.up {
                        if event.button == PointerEventButton.left { Session.input("pointer.primary", false, 0); }
                        if event.button == PointerEventButton.right { Session.input("pointer.secondary", false, 0); }
                        if event.button == PointerEventButton.middle { Session.input("pointer.middle", false, 0); }
                    }
                    return;
                }
                if event.kind == PointerEventKind.down { game-focus.focus(); }
                Session.input("pointer.x", true, (self.mouse-x - root.content-stage-x) / root.content-stage-width * Session.native-width);
                Session.input("pointer.y", true, (self.mouse-y - root.content-stage-y) / root.content-stage-height * Session.native-height);
                if event.button == PointerEventButton.left { Session.input("pointer.primary", event.kind == PointerEventKind.down, 1); }
                if event.button == PointerEventButton.right { Session.input("pointer.secondary", event.kind == PointerEventKind.down, 1); }
                if event.button == PointerEventButton.middle { Session.input("pointer.middle", event.kind == PointerEventKind.down, 1); }
            }
            scroll-event(event) => {
                if root.input-blocked { return reject; }
                if self.mouse-x < root.content-stage-x || self.mouse-x >= root.content-stage-x + root.content-stage-width || self.mouse-y < root.content-stage-y || self.mouse-y >= root.content-stage-y + root.content-stage-height {
                    return reject;
                }
                Session.input("wheel", false, event.delta-y / 60px);
                return accept;
            }
            changed has-hover => { root.ping-handle(); }
        }
    }

    Rectangle {
        x: parent.width - 56px;
        y: 16px;
        z: 30;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: #0008;
        opacity: Session.menu-open ? 0 : (root.handle-visible ? 1 : 0);
        animate opacity { duration: Theme.motion-medium; }
        IconBtn {
            x: 0px;
            y: 0px;
            glyph: Icons.bars;
            label: "打开快捷菜单";
            variant: "standard";
            size: 40px;
            tint: #ffffff;
            clicked => { root.open-menu(); }
        }
    }

    edge := TouchArea {
        x: parent.width - 12px;
        y: 0px;
        width: 12px;
        height: parent.height;
        z: 25;
    }
    edge-timer := Timer {
        interval: 300ms;
        running: edge.has-hover && !Session.menu-open;
        triggered => { root.open-menu(); }
    }

    if root.hint-visible && !Session.menu-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: 16px;
        z: 28;
        height: 36px;
        width: hint-text.preferred-width + 28px;
        border-radius: 18px;
        background: #000000a8;
        hint-text := Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: "移动鼠标后点按右上角按钮，可打开快捷菜单";
            color: #ffffff;
            font-size: Theme.label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { }
    }

    if Session.menu-open : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        z: 40;
        background: #0000004d;

        scrim-area := TouchArea {
            clicked => { root.close-menu(); }
        }

        panel := Rectangle {
            x: parent.width - root.menu-w;
            y: 0px;
            width: root.menu-w;
            height: parent.height;
            background: Theme.surface-container;
            border-top-left-radius: Theme.r-xl;
            border-bottom-left-radius: Theme.r-xl;
            drop-shadow-blur: 24px;
            drop-shadow-offset-x: -8px;
            drop-shadow-color: Theme.shadow-strong;

            panel-area := TouchArea {
                changed has-hover => { if self.has-hover { root.panel-seen = true; } }
            }

            if Session.menu-page == "main" : VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 0px;

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 12px;
                    spacing: 4px;
                    Text {
                        text: Session.title != "" ? Session.title : Selection.game.title;
                        color: Theme.on-surface;
                        font-size: Theme.title-md;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: Selection.game.family;
                        color: Theme.on-variant;
                        font-size: Theme.body-sm;
                    }
                }

                MenuRow {
                    glyph: Icons.play;
                    label: "继续游戏";
                    clicked => { root.close-menu(); }
                }
                Rectangle { height: 1px; background: Theme.outline-variant; }

                for action in Session.actions : MenuRow {
                    glyph: Icons.action-glyph(action.icon);
                    label: action.label;
                    clicked => { Session.engine-action(action.control); }
                }

                Rectangle { height: 1px; background: Theme.outline-variant; }
                MenuRow {
                    glyph: Icons.wand;
                    label: "画面滤镜";
                    clicked => { Session.menu-page = "filters"; }
                }
                MenuRow {
                    glyph: Session.fullscreen ? Icons.compress : Icons.expand;
                    label: Session.fullscreen ? "退出全屏" : "全屏";
                    clicked => { Session.set-fullscreen(!Session.fullscreen); }
                }
                Rectangle { height: 1px; background: Theme.outline-variant; }
                MenuRow {
                    glyph: Icons.arrow-left;
                    label: "返回游戏库";
                    fg: Theme.error;
                    clicked => { Session.leave(); }
                }

                Rectangle { vertical-stretch: 1; }

                Toast {
                    text: Session.action-message;
                    serial: Session.action-serial;
                }
                Rectangle { height: 8px; }
                Text {
                    text: "菜单打开时，键盘和手柄仍会传给游戏";
                    color: Theme.on-variant;
                    font-size: Theme.label-sm;
                    horizontal-alignment: center;
                }
            }

            if Session.menu-page == "filters" : VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    IconBtn {
                        glyph: Icons.arrow-left;
                        label: "返回";
                        clicked => { Session.menu-page = "main"; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: "画面滤镜";
                            color: Theme.on-surface;
                            font-size: Theme.title-md;
                            font-weight: 700;
                        }
                        Text {
                            text: "立即生效";
                            color: Theme.on-variant;
                            font-size: Theme.label;
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        spacing: 12px;
                        alignment: start;
                        FilterPresetGrid { }
                        GenericConfigForm {
                            fields: Filters.fields;
                            form-title: "效果参数";
                            field-changed(key, value) => { Filters.field-changed(key, value); }
                            save => { Filters.save(); }
                            reset => { Filters.reset(); }
                        }
                    }
                }
            }
        }

        hide-timer := Timer {
            interval: 800ms;
            running: root.panel-seen && Session.menu-page == "main" && scrim-area.has-hover && !panel-area.has-hover;
            triggered => { root.close-menu(); }
        }
    }
}
