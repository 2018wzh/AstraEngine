import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App } from "../globals.slint";
import { BrandMark } from "../components/nav.slint";
import { Card } from "../components/controls.slint";

export component AboutPage inherits Rectangle {
    background: Theme.surface;

    ScrollView {
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            padding: 32px;
            spacing: 16px;
            alignment: start;

            VerticalLayout {
                spacing: 8px;
                alignment: center;
                BrandMark {
                    size: 64px;
                }
                Text {
                    text: "AstraEMU";
                    color: Theme.on-surface;
                    font-size: Theme.headline;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "视觉小说运行与管理工具";
                    color: Theme.primary;
                    font-size: Theme.title-sm;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "版本 " + App.version;
                    color: Theme.on-variant;
                    font-size: Theme.body-sm;
                    horizontal-alignment: center;
                }
                Text {
                    text: "构建信息 " + App.build;
                    color: Theme.on-variant;
                    font-size: Theme.label;
                    horizontal-alignment: center;
                }
            }

            Text {
                text: "在现代系统上运行经典视觉小说，统一管理游戏库、画面效果与实时翻译。";
                color: Theme.on-variant;
                wrap: word-wrap;
                font-size: Theme.body;
                horizontal-alignment: center;
            }

            Card {
                min-height: 120px;
                VerticalLayout {
                    padding: 16px;
                    AboutSlint { }
                }
            }

            Text {
                text: "开源协议与第三方声明";
                color: Theme.on-surface;
                font-size: Theme.title-md;
                font-weight: 650;
            }
            Text {
                text: "Slint 1.18.1 — Royalty-free Desktop, Mobile, and Web Applications License 2.0.\nwgpu 30.0.1 — MIT / Apache-2.0\nwinit 0.30 — Apache-2.0\nFont Awesome 6 Free (Solid) — SIL OFL 1.1（内嵌矢量字元库）";
                color: Theme.on-variant;
                wrap: word-wrap;
                font-size: Theme.body-sm;
            }
        }
    }
}
