// About page - app info, third-party licenses, AboutSlint widget.

import { AboutSlint, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, Icons } from "../components/icons.slint";
import { SettingsSectionHeader, SettingsDivider } from "../components/settings-card.slint";

export component AboutPage inherits Rectangle {
    in property <string> version: "";
    in property <string> build-identity: "";

    background: Theme.background;

    ScrollView {
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            // App header
            VerticalLayout {
                spacing: 8px;
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: Theme.shape-xl;
                    background: Theme.primary-container;
                    x: (parent.width - self.width) / 2;

                    Icon {
                        glyph: Icons.gamepad;
                        font-size: 32px;
                        color: Theme.on-primary-container;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "AstraEMU";
                    color: Theme.on-surface;
                    font-size: Theme.font-headline-md;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: "下一代旧引擎视觉小说运行时与通用管理器";
                    color: Theme.primary;
                    font-size: Theme.font-title-sm;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                if version != "" : Text {
                    text: "版本 (Version) " + version;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-label-md;
                    horizontal-alignment: center;
                }
                if build-identity != "" : Text {
                    text: build-identity;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-label-sm;
                    horizontal-alignment: center;
                }
            }

            SettingsDivider {}

            SettingsSectionHeader { title: "关于架构与项目定位"; }

            Text {
                text: "AstraEMU 作为 AstraEngine 系列原生独立产品，提供多 Family 旧引擎（FVP、Minori、KrKr、BGI 等）的原生加载与探测、Trusted Luau 补丁沙盒、LLM 实时翻译与统一的视觉小说书架管理体验。遵循系列宪章 Migration 12，采用 Slint 1.17 + wgpu 29 同设备硬件单通道渲染合成。";
                color: Theme.on-surface-variant;
                wrap: word-wrap;
                font-size: Theme.font-body-sm;
            }

            SettingsDivider {}

            SettingsSectionHeader { title: "Slint 跨平台 GUI 框架"; }

            Rectangle {
                background: Theme.surface-container-low;
                border-radius: Theme.shape-lg;
                border-width: 1px;
                border-color: Theme.outline-variant;
                min-height: 120px;

                AboutSlint { }
            }

            SettingsDivider {}

            SettingsSectionHeader { title: "开源协议与第三方声明"; }

            Text {
                text: "Slint 1.17.1 — Royalty-free Desktop, Mobile, and Web Applications License 2.0.\nwgpu 29.0.4 — MIT / Apache-2.0\nwinit 0.30 — Apache-2.0\nFont Awesome 6 Free (Solid) — SIL OFL 1.1 (内嵌矢量字元库)";
                color: Theme.on-surface-variant;
                wrap: word-wrap;
                font-size: Theme.font-label-md;
            }
        }
    }
}
