import { MaterialPalette, MaterialText, MaterialTypography, SmallAppBar, Icon, Badge, ScrollView } from "@material";
import { App, Cores } from "../globals.slint";
import { Icons } from "../icons.slint";
import { AppearanceSection } from "./settings/appearance.slint";
import { RootsSection } from "./settings/roots.slint";
import { NetworkSection } from "./settings/network.slint";
import { TranslationSection } from "./settings/translation.slint";
import { InputSection } from "./settings/input.slint";
import { FiltersSection } from "./settings/filters.slint";
import { CoresSection } from "./settings/cores.slint";
import { AboutSection } from "./settings/about.slint";

// Single-pane navigation state. Leaving the settings page resets
// App.settings-category to "" (shown as 外观), so any deep link -- writing a
// category and then App.page = "settings" -- is a change and opens that
// category's content directly; plain navigation opens the category list.
global SettingsNav {
    in-out property <bool> show-content;
    in-out property <bool> visited;
    property <string> watch-category: App.settings-category;
    changed watch-category => { self.show-content = App.settings-category != ""; }
    property <string> watch-page: App.page;
    changed watch-page => {
        if App.page != "settings" {
            App.settings-category = "";
        }
    }

    public function enter() {
        // The global default is "appearance", so on the first visit only
        // another category counts as a deep link.
        self.show-content = App.settings-category != "" && (self.visited || App.settings-category != "appearance");
        self.visited = true;
    }
}

struct Category {
    id: string,
    label: string,
    icon: image,
}

component CategoryItem {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> show-chevron;
    in property <int> badge;
    callback activate();

    height: 56px;
    forward-focus: keys;
    accessible-role: tab;
    accessible-label: root.label + (root.badge > 0 ? "，" + root.badge + " 个可更新" : "");
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.activate(); }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        border-radius: 28px;
        background: root.selected ? MaterialPalette.secondary-container : transparent;
        border-width: keys.has-focus ? 2px : 0px;
        border-color: MaterialPalette.secondary;
    }

    Rectangle {
        border-radius: 28px;
        background: touch.pressed ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-press)
            : touch.has-hover ? MaterialPalette.on-surface.with-alpha(MaterialPalette.state-layer-opacity-hover)
            : transparent;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon {
                width: 24px;
                height: 24px;
                source: root.icon;
                colorize: root.selected ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
            }
        }

        MaterialText {
            horizontal-stretch: 1;
            text: root.label;
            style: MaterialTypography.label-large;
            color: root.selected ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.badge > 0 : VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Badge { text: root.badge; }
        }

        if root.show-chevron : VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon {
                width: 24px;
                height: 24px;
                source: Icons.chevron-right;
                colorize: MaterialPalette.on-surface-variant;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            keys.focus();
            root.activate();
        }
    }

    keys := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activate();
                return accept;
            }
            reject
        }
    }
}

component CategoryList {
    in property <[Category]> categories;
    in property <bool> highlight-selected;
    in property <bool> show-chevron;
    callback chosen(id: string);

    ScrollView {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            alignment: start;

            for c in root.categories : CategoryItem {
                label: c.label;
                icon: c.icon;
                selected: root.highlight-selected && (App.settings-category == "" ? "appearance" : App.settings-category) == c.id;
                show-chevron: root.show-chevron;
                badge: c.id == "cores" ? Cores.updates-available : 0;
                activate => { root.chosen(c.id); }
            }
        }
    }
}

component SectionHost {
    in property <bool> show-title;
    property <string> category: App.settings-category == "" ? "appearance" : App.settings-category;

    if root.category == "appearance" : AppearanceSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
    if root.category == "library-roots" : RootsSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
    if root.category == "network" : NetworkSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
    if root.category == "translation" : TranslationSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
    if root.category == "input" : InputSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
    if root.category == "filters" : FiltersSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
    if root.category == "cores" : CoresSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
    if root.category == "about" : AboutSection {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        show-title: root.show-title;
    }
}

export component SettingsPage {
    in property <bool> compact;

    property <[Category]> categories: [
        { id: "appearance", label: "外观", icon: Icons.palette },
        { id: "library-roots", label: "库目录", icon: Icons.folder-open },
        { id: "network", label: "联网与资料", icon: Icons.public },
        { id: "translation", label: "实时翻译", icon: Icons.translate },
        { id: "input", label: "输入与手柄", icon: Icons.sports-esports },
        { id: "filters", label: "画面滤镜", icon: Icons.filter-vintage },
        { id: "cores", label: "核心", icon: Icons.memory },
        { id: "about", label: "关于", icon: Icons.info },
    ];
    property <bool> two-pane: root.width >= 760px;
    property <bool> single-content: !root.two-pane && SettingsNav.show-content;
    property <length> list-width: 280px;
    property <length> bar-height: 64px;

    pure function category-label(id: string) -> string {
        return id == "appearance" ? "外观"
            : id == "library-roots" ? "库目录"
            : id == "network" ? "联网与资料"
            : id == "translation" ? "实时翻译"
            : id == "input" ? "输入与手柄"
            : id == "filters" ? "画面滤镜"
            : id == "cores" ? "核心"
            : id == "about" ? "关于"
            : "设置";
    }

    function back() {
        if root.single-content {
            SettingsNav.show-content = false;
        } else {
            App.page = "library";
        }
    }

    forward-focus: keys;
    init => { SettingsNav.enter(); }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && root.single-content {
                root.back();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        background: MaterialPalette.surface;
    }

    // Two panes: category list on the left, content on the right.
    if root.two-pane : HorizontalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        Rectangle {
            width: root.list-width;
            background: MaterialPalette.surface-container-low;

            VerticalLayout {
                HorizontalLayout {
                    padding-left: 28px;
                    height: 72px;
                    MaterialText {
                        text: "设置";
                        style: MaterialTypography.headline-small;
                        color: MaterialPalette.on-surface;
                        vertical-alignment: center;
                    }
                }
                CategoryList {
                    vertical-stretch: 1;
                    categories: root.categories;
                    highlight-selected: true;
                    chosen(id) => { App.settings-category = id; }
                }
            }
        }

        SectionHost {
            horizontal-stretch: 1;
            show-title: true;
        }
    }

    // Single pane: app bar plus either the category list or one category.
    if !root.two-pane : SmallAppBar {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.bar-height;
        title: root.single-content ? root.category-label(App.settings-category) : "设置";
        leading-button: root.single-content || root.compact ? { icon: Icons.arrow-back, tooltip: "返回", enabled: true } : { };
        leading-button-clicked => { root.back(); }
    }

    if !root.two-pane && !root.single-content : CategoryList {
        x: 0px;
        y: root.bar-height;
        width: root.width;
        height: root.height - root.bar-height;
        categories: root.categories;
        show-chevron: true;
        chosen(id) => {
            App.settings-category = id;
            SettingsNav.show-content = true;
        }
    }

    if root.single-content : SectionHost {
        x: 0px;
        y: root.bar-height;
        width: root.width;
        height: root.height - root.bar-height;
        show-title: false;
    }
}
