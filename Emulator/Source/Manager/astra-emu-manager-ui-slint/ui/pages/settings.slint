import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App } from "../globals.slint";
import { Icon, Icons } from "../components/icons.slint";
import { IconBtn } from "../components/controls.slint";
import { AppearanceSettingsPage } from "../settings/appearance.slint";
import { InputSettingsPage } from "../settings/input.slint";
import { FilterSettingsPage } from "../settings/filters.slint";
import { TranslationSettingsPage } from "../settings/translation.slint";
import { MetadataSettingsPage } from "../settings/metadata.slint";
import { CompatibilitySettingsPage } from "../settings/compatibility.slint";

struct SettingsDestination {
    id: string,
    title: string,
    glyph: string,
}

component CategoryRow inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <bool> active;
    callback clicked();

    height: 52px;
    border-radius: Theme.r-md;
    background: active ? Theme.primary-container : (area.has-hover ? Theme.surface-high : transparent);
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Icon {
            glyph: root.glyph;
            font-size: 16px;
            width: 24px;
            color: root.active ? Theme.on-primary-container : Theme.on-variant;
        }
        Text {
            text: root.title;
            color: root.active ? Theme.on-primary-container : Theme.on-surface;
            font-size: Theme.body;
            font-weight: root.active ? 650 : 500;
            vertical-alignment: center;
        }
    }

    row-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                row-focus.focus();
                root.clicked();
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> compact: false;
    private property <bool> show-detail: false;
    property <bool> two-pane: root.width >= 760px;
    property <[SettingsDestination]> destinations: [
        { id: "appearance", title: "外观", glyph: Icons.palette },
        { id: "input", title: "输入与手柄", glyph: Icons.keyboard },
        { id: "filters", title: "画面滤镜", glyph: Icons.wand },
        { id: "translation", title: "实时翻译", glyph: Icons.language },
        { id: "metadata", title: "作品资料与账号", glyph: Icons.database },
        { id: "compatibility", title: "兼容性数据", glyph: Icons.shield },
    ];

    background: Theme.surface;

    function open-category(id: string) {
        App.settings-category = id;
        root.show-detail = true;
    }

    if root.two-pane || !root.show-detail : Rectangle {
        x: 0px;
        y: 0px;
        width: root.two-pane ? 280px : parent.width;
        height: parent.height;
        background: Theme.surface-low;

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            padding: 20px;
            spacing: 12px;
            Text {
                text: "设置";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }
            ScrollView {
                mouse-drag-pan-enabled: true;
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    for destination in root.destinations : CategoryRow {
                        glyph: destination.glyph;
                        title: destination.title;
                        active: App.settings-category == destination.id;
                        clicked => { root.open-category(destination.id); }
                    }
                }
            }
        }
    }

    if root.two-pane || root.show-detail : Rectangle {
        x: root.two-pane ? 280px : 0px;
        y: 0px;
        width: parent.width - self.x;
        height: parent.height;
        clip: true;

        if !root.two-pane : IconBtn {
            x: 12px;
            y: 12px;
            z: 2;
            glyph: Icons.arrow-left;
            label: "返回";
            clicked => { root.show-detail = false; }
        }

        Rectangle {
            x: 0px;
            y: !root.two-pane ? 52px : 0px;
            width: parent.width;
            height: parent.height - self.y;
            if App.settings-category == "appearance" : AppearanceSettingsPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
            }
            if App.settings-category == "input" : InputSettingsPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
            }
            if App.settings-category == "filters" : FilterSettingsPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
            }
            if App.settings-category == "translation" : TranslationSettingsPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
            }
            if App.settings-category == "metadata" : MetadataSettingsPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
            }
            if App.settings-category == "compatibility" : CompatibilitySettingsPage {
                x: 0px; y: 0px; width: 100%; height: 100%;
            }
        }
    }
}
