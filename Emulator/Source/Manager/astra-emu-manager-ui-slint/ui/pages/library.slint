import { ComboBox, ScrollView, Spinner } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App, Library, GameCard, Cores } from "../globals.slint";
import { Icon, Icons } from "../components/icons.slint";
import { CoverCard } from "../components/cover-card.slint";
import { DetailSheet } from "./detail.slint";
import { PillButton, IconBtn, SearchField, FilterChip, Segmented, Card, Tag, StatusBadge } from "../components/controls.slint";

component PlaceholderCover inherits Rectangle {
    in property <length> shift: 0px;
    width: 72px;
    height: 96px;
    x: shift;
    y: 8px - shift / 4;
    border-radius: Theme.r-md;
    background: @linear-gradient(160deg, Theme.primary-container 0%, Theme.surface-high 100%);
    Icon {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        glyph: Icons.image;
        font-size: 22px;
        color: Theme.on-primary-container;
        opacity: 0.35;
    }
}

component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    spacing: 14px;
    alignment: center;
    Rectangle {
        height: 120px;
        PlaceholderCover { shift: 0px; }
        PlaceholderCover { shift: 28px; }
        PlaceholderCover { shift: 56px; }
    }
    Text {
        text: root.title;
        color: Theme.on-surface;
        font-size: Theme.title-lg;
        font-weight: 700;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Text {
        text: root.body;
        color: Theme.on-variant;
        font-size: Theme.body-sm;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

component ListRow inherits Rectangle {
    in property <GameCard> game;
    in property <bool> selected: false;
    in property <bool> compact-row: false;
    in property <bool> cover-needed;
    callback activated();
    callback launch();
    callback cover-demand(string, bool);

    private property <string> cover-id: game.id;
    private property <string> demanded-id;
    property <bool> hovered: row-area.has-hover;
    height: compact-row ? 52px : (Theme.compact-density ? 52px : 64px);
    background: selected ? Theme.primary-container : (hovered ? Theme.surface-low : transparent);
    accessible-role: button;
    accessible-label: game.title;
    accessible-action-default => { root.activated(); }

    function report-cover() {
        if root.demanded-id != root.cover-id && root.demanded-id != "" {
            root.cover-demand(root.demanded-id, false);
        }
        root.demanded-id = root.cover-id;
        root.cover-demand(root.cover-id, root.cover-needed);
    }
    init => { root.report-cover(); }
    changed cover-needed => { root.report-cover(); }
    changed cover-id => { root.report-cover(); }

    row-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activated();
                return accept;
            }
            return reject;
        }
        row-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                row-focus.focus();
                root.activated();
            }
        }
    }

    if selected : Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: Theme.primary;
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;

        Rectangle {
            width: 36px;
            height: 48px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-xs;
            clip: true;
            background: Theme.surface-high;
            if game.cover.width > 0 : Image {
                x: 0px; y: 0px; width: 100%; height: 100%;
                source: game.cover;
                image-fit: cover;
            }
            if game.cover.width == 0 : Icon {
                x: 0px; y: 0px; width: 100%; height: 100%;
                glyph: Icons.image;
                font-size: 14px;
                opacity: 0.4;
            }
        }

        if !compact-row : VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: game.title;
                color: Theme.on-surface;
                font-size: Theme.title-sm;
                font-weight: 600;
                overflow: elide;
            }
            if game.problem != "" : Text {
                text: game.problem;
                color: Theme.error;
                font-size: Theme.label;
                overflow: elide;
            }
        }
        if compact-row : VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: game.title;
                color: Theme.on-surface;
                font-size: Theme.title-sm;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: game.family + " · " + (game.play-time != "" ? game.play-time : "未开始") + " · " + Theme.status-label(game.compat);
                color: Theme.on-variant;
                font-size: Theme.label;
                overflow: elide;
            }
        }
        if !compact-row : Rectangle {
            width: 120px;
            Tag { x: 0px; y: (parent.height - self.height) / 2; text: game.family; }
        }
        if !compact-row : Rectangle {
            width: 104px;
            if game.compat != "" : StatusBadge { x: 0px; y: (parent.height - self.height) / 2; status: game.compat; }
            if game.compat == "" : Text {
                x: 0px; y: 0px; width: 100%; height: 100%;
                text: "—";
                color: Theme.on-variant;
                vertical-alignment: center;
            }
        }
        if !compact-row : Text {
            width: 96px;
            text: game.play-time;
            color: Theme.on-variant;
            font-size: Theme.body-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        if !compact-row : Text {
            width: 112px;
            text: game.last-played;
            color: Theme.on-variant;
            font-size: Theme.body-sm;
            vertical-alignment: center;
            overflow: elide;
        }
        IconBtn {
            glyph: Icons.play;
            label: "开始游戏";
            enabled: game.problem == "";
            clicked => { root.launch(); }
        }
    }

}

component SortHeader inherits Rectangle {
    in property <string> label;
    in property <string> key;
    in property <length> w: 0px;
    in property <bool> stretch: false;
    in property <bool> clickable: true;
    callback clicked();
    height: 40px;
    width: stretch ? 1px : w;
    horizontal-stretch: stretch ? 1 : 0;
    accessible-role: button;
    accessible-label: label;
    HorizontalLayout {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        spacing: 4px;
        Text {
            text: root.label;
            color: Library.sort == root.key ? Theme.primary : Theme.on-variant;
            font-size: Theme.label;
            font-weight: 600;
            vertical-alignment: center;
        }
        if Library.sort == root.key : Icon {
            glyph: Icons.chevron-down;
            font-size: 11px;
            color: Theme.primary;
            width: 14px;
        }
    }
    if clickable : TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component LibraryPage inherits Rectangle {
    in property <bool> compact: false;
    background: Theme.surface;

    property <length> pad: compact ? 16px : (root.width >= 840px ? 32px : 24px);
    property <bool> docked: !compact && root.width >= 1100px;
    property <bool> sheet-open: Library.detail-open && Library.selected-id != "";
    property <length> sheet-w: 420px;
    property <length> content-w: sheet-open && docked ? root.width - sheet-w : root.width;
    property <length> avail: max(1px, content-w - 2 * pad);
    property <length> min-card: (App.appearance.cover-size == "large" ? 208px : App.appearance.cover-size == "small" ? 136px : 168px) - (Theme.compact-density ? 12px : 0px);
    property <length> max-card: min-card * 1.5;
    property <length> gap: Theme.compact-density ? (compact ? 12px : 16px) : (compact ? 20px : 24px);
    property <int> cols: max(1, Math.floor((avail + gap) / (min-card + gap)));
    property <length> card: min(max-card, (avail - gap * (cols - 1)) / cols);
    property <string> local-filter: Library.compat-filter;
    property <bool> grid-mode: App.appearance.view-mode != "list";
    private property <bool> search-focus-request: false;

    animate content-w { duration: Theme.motion-medium; }

    function push-view(mode: string) {
        App.appearance = {
            theme-mode: App.appearance.theme-mode,
            density: App.appearance.density,
            cover-size: App.appearance.cover-size,
            view-mode: mode,
            reduce-motion: App.appearance.reduce-motion,
            cover-badges: App.appearance.cover-badges,
        };
        App.appearance-changed(App.appearance);
    }

    function apply-filter(id: string) {
        root.local-filter = id;
        Library.compat-filter = id;
        Library.set-compat-filter(id);
    }

    init => { page-focus.focus(); }

    page-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "f" || event.text == "F") {
                root.search-focus-request = !root.search-focus-request;
                return accept;
            }
            if event.text == Key.Escape {
                Library.detail-open = false;
                return accept;
            }
            return reject;
        }

        search-debounce := Timer {
            interval: 300ms;
            running: false;
            triggered => { Library.search(Library.query); }
        }

        content := Rectangle {
            x: 0px;
            y: 0px;
            width: root.content-w;
            height: parent.height;
            clip: true;

            VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding: root.pad;
                spacing: 16px;

                if !root.compact : HorizontalLayout {
                    height: 48px;
                    spacing: 12px;
                    Text {
                        text: "游戏库";
                        font-size: Theme.headline;
                        font-weight: 700;
                        color: Theme.on-surface;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: Library.games.length + " 部作品";
                        font-size: Theme.body-sm;
                        color: Theme.on-variant;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SearchField {
                        width: 320px;
                        text <=> Library.query;
                        focus-request: root.search-focus-request;
                        placeholder: "搜索标题、别名或开发商";
                        shortcut: "Ctrl F";
                        edited(t) => { search-debounce.running = false; search-debounce.running = true; }
                        cleared => { Library.search(""); }
                    }
                    Segmented {
                        items: ["网格", "列表"];
                        current: root.grid-mode ? 0 : 1;
                        segment-width: 64px;
                        selected(i) => { root.push-view(i == 1 ? "list" : "grid"); }
                    }
                    IconBtn {
                        glyph: Icons.refresh;
                        label: "扫描游戏目录";
                        variant: "tonal";
                        enabled: Library.cores-ready && !Library.busy;
                        clicked => { Library.rescan(); }
                    }
                    PillButton {
                        text: "添加游戏";
                        glyph: Icons.plus;
                        enabled: Library.cores-ready && !Library.busy;
                        clicked => { Library.add-directory(); }
                    }
                }

                if root.compact : VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: 48px;
                        spacing: 8px;
                        Text {
                            text: "游戏库";
                            font-size: Theme.headline;
                            font-weight: 700;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Segmented {
                            items: ["网格", "列表"];
                            current: root.grid-mode ? 0 : 1;
                            segment-width: 56px;
                            selected(i) => { root.push-view(i == 1 ? "list" : "grid"); }
                        }
                        IconBtn {
                            glyph: Icons.refresh;
                            label: "扫描游戏目录";
                            variant: "tonal";
                            enabled: Library.cores-ready && !Library.busy;
                            clicked => { Library.rescan(); }
                        }
                        IconBtn {
                            glyph: Icons.plus;
                            label: "添加游戏";
                            variant: "filled";
                            enabled: Library.cores-ready && !Library.busy;
                            clicked => { Library.add-directory(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        SearchField {
                            horizontal-stretch: 1;
                            text <=> Library.query;
                            focus-request: root.search-focus-request;
                            placeholder: "搜索作品";
                            edited(t) => { search-debounce.running = false; search-debounce.running = true; }
                            cleared => { Library.search(""); }
                        }
                        ComboBox {
                            width: 112px;
                            model: ["标题", "最近游玩", "游玩时长"];
                            current-index: Library.sort == "recent" ? 1 : Library.sort == "play_time" ? 2 : 0;
                            selected(value) => {
                                Library.set-sort(value == "最近游玩" ? "recent" : value == "游玩时长" ? "play_time" : "title");
                            }
                        }
                    }
                }

                if Library.busy || Library.can-load-cores : Card {
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        if Library.busy : Spinner {
                            indeterminate: true;
                            width: 20px;
                            height: 20px;
                        }
                        if !Library.busy : Icon {
                            glyph: Icons.microchip;
                            font-size: 16px;
                            width: 20px;
                            color: Theme.primary;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Library.status;
                            color: Theme.on-surface;
                            font-size: Theme.body-sm;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        if Library.can-load-cores : PillButton {
                            text: "加载核心";
                            variant: "filled";
                            h: 32px;
                            clicked => { Cores.load(); }
                        }
                    }
                }

                HorizontalLayout {
                    height: 32px;
                    spacing: 8px;
                    Flickable {
                        horizontal-stretch: 1;
                        height: 32px;
                        viewport-height: 32px;
                        viewport-width: chips.preferred-width;
                        chips := HorizontalLayout {
                            spacing: 8px;
                            FilterChip { text: "全部"; selected: root.local-filter == "all"; clicked => { root.apply-filter("all"); } }
                            FilterChip { text: "完美"; selected: root.local-filter == "perfect"; clicked => { root.apply-filter("perfect"); } }
                            FilterChip { text: "可通关"; selected: root.local-filter == "completable"; clicked => { root.apply-filter("completable"); } }
                            FilterChip { text: "有瑕疵"; selected: root.local-filter == "flawed"; clicked => { root.apply-filter("flawed"); } }
                            FilterChip { text: "仅能启动"; selected: root.local-filter == "boot_only"; clicked => { root.apply-filter("boot_only"); } }
                            FilterChip { text: "无法运行"; selected: root.local-filter == "unplayable"; clicked => { root.apply-filter("unplayable"); } }
                            FilterChip { text: "未评级"; selected: root.local-filter == "unknown"; clicked => { root.apply-filter("unknown"); } }
                        }
                    }
                    if root.grid-mode && !root.compact : HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 8px;
                        Text {
                            text: "排序";
                            horizontal-stretch: 0;
                            color: Theme.on-variant;
                            font-size: Theme.body-sm;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            width: 140px;
                            model: ["标题", "最近游玩", "游玩时长"];
                            current-index: Library.sort == "recent" ? 1 : Library.sort == "play_time" ? 2 : 0;
                            selected(value) => {
                                Library.set-sort(value == "最近游玩" ? "recent" : value == "游玩时长" ? "play_time" : "title");
                            }
                        }
                    }
                }

                if root.grid-mode : desktop-grid := ScrollView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        spacing: 16px;
                        alignment: start;
                        if Library.games.length > 0 : HorizontalLayout {
                            vertical-stretch: 0;
                            alignment: start;
                            GridLayout {
                                horizontal-stretch: 0;
                                vertical-stretch: 0;
                                spacing: root.gap;
                                for game[index] in Library.games : CoverCard {
                                    row: Math.floor(index / root.cols);
                                    col: Math.mod(index, root.cols);
                                    width: root.card;
                                    height: root.card * 4 / 3 + 52px;
                                    vertical-stretch: 0;
                                    game: game;
                                    selected: game.id == Library.selected-id;
                                    cover-needed: Library.cover-loading && self.y + self.height >= -desktop-grid.viewport-y - self.height && self.y <= -desktop-grid.viewport-y + desktop-grid.height + self.height;
                                    cover-demand(id, needed) => { Library.cover-demand(index, id, needed, "grid"); }
                                    activated => {
                                        Library.select(game.id);
                                        Library.detail-open = true;
                                    }
                                    launch => { Library.launch(game.id); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if Library.games.length == 0 : empty-grid := VerticalLayout {
                            spacing: 12px;
                            alignment: center;
                            if !Library.cores-ready : EmptyState {
                                title: "先加载模拟器核心";
                                body: "加载完成后即可添加游戏目录。";
                            }
                            if !Library.cores-ready : HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                PillButton {
                                    text: "加载核心";
                                    enabled: Library.can-load-cores;
                                    clicked => { Cores.load(); }
                                }
                                PillButton {
                                    text: "查看核心";
                                    variant: "outlined";
                                    clicked => { App.page = "cores"; }
                                }
                            }
                            if Library.cores-ready && Library.query == "" : EmptyState {
                                title: "添加第一个游戏目录";
                                body: "AstraEMU 会识别目录里的作品，并匹配已安装的核心。联网获取封面和简介默认关闭，需要时在设置中开启。";
                            }
                            if Library.cores-ready && Library.query == "" : HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                PillButton {
                                    text: "选择游戏目录";
                                    clicked => { Library.add-directory(); }
                                }
                                PillButton {
                                    text: "扫描已有目录";
                                    variant: "outlined";
                                    clicked => { Library.rescan(); }
                                }
                            }
                            if Library.cores-ready && Library.query != "" : EmptyState {
                                title: "没有找到“" + Library.query + "”";
                                body: "换个关键词，或清除筛选条件。";
                            }
                            if Library.cores-ready && Library.query != "" : HorizontalLayout {
                                alignment: center;
                                PillButton {
                                    text: "清除搜索";
                                    variant: "outlined";
                                    clicked => {
                                        Library.query = "";
                                        Library.search("");
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.grid-mode : desktop-list := ScrollView {
                    vertical-stretch: 1;
                    mouse-drag-pan-enabled: true;
                    VerticalLayout {
                        width: root.avail;
                        alignment: start;
                        spacing: 0px;
                        if !root.compact : HorizontalLayout {
                            width: 100%;
                            height: 40px;
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 12px;
                            Rectangle { width: 36px; }
                            SortHeader {
                                label: "标题";
                                key: "title";
                                w: max(80px, root.avail - 616px);
                                clicked => { Library.set-sort("title"); }
                            }
                            SortHeader {
                                label: "引擎";
                                key: "";
                                w: 120px;
                                clickable: false;
                            }
                            SortHeader {
                                label: "兼容性";
                                key: "";
                                w: 104px;
                                clickable: false;
                            }
                            SortHeader {
                                label: "游玩时长";
                                key: "play_time";
                                w: 96px;
                                clicked => { Library.set-sort("play_time"); }
                            }
                            SortHeader {
                                label: "上次游玩";
                                key: "recent";
                                w: 112px;
                                clicked => { Library.set-sort("recent"); }
                            }
                            Rectangle { width: 56px; }
                        }
                        if !root.compact : Rectangle {
                            height: 1px;
                            background: Theme.outline-variant;
                        }
                        for game[index] in Library.games : ListRow {
                            game: game;
                            selected: game.id == Library.selected-id;
                            compact-row: root.compact;
                            cover-needed: Library.cover-loading && self.y + self.height >= -desktop-list.viewport-y - self.height && self.y <= -desktop-list.viewport-y + desktop-list.height + self.height;
                            cover-demand(id, needed) => { Library.cover-demand(index, id, needed, "list"); }
                            activated => {
                                Library.select(game.id);
                                Library.detail-open = true;
                            }
                            launch => { Library.launch(game.id); }
                        }
                    }
                }
            }
        }

        if !root.docked : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: Theme.scrim;
            opacity: root.sheet-open ? 1 : 0;
            visible: root.sheet-open;
            animate opacity { duration: Theme.motion-medium; }
            TouchArea {
                clicked => { Library.detail-open = false; }
            }
        }

        DetailSheet {
            x: root.compact ? 0px : (root.sheet-open ? parent.width - root.sheet-w : parent.width);
            y: root.compact ? (root.sheet-open ? 32px : parent.height) : 0px;
            width: root.compact ? parent.width : root.sheet-w;
            height: root.compact ? parent.height - 32px : parent.height;
            handle: root.compact;
            z: 20;
            close => { Library.detail-open = false; }
            animate x, y { duration: Theme.motion-medium; }
        }
    }
}
