import { MaterialPalette, MaterialText, MaterialTypography, IconButton, TextButton, OutlineButton, HorizontalDivider, Icon } from "@material";
import { Settings } from "../../globals.slint";
import { Icons } from "../../icons.slint";
import { PageScroll, SettingGroup } from "./common.slint";

// One row of a path list: folder icon, path, trailing remove button.
export component PathRow {
    in property <string> path;
    in property <string> remove-label: "移除";
    callback remove();

    min-height: 56px;
    preferred-height: 56px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Icon {
                width: 24px;
                height: 24px;
                source: Icons.folder-open;
                colorize: MaterialPalette.on-surface-variant;
            }
        }

        MaterialText {
            horizontal-stretch: 1;
            text: root.path;
            style: MaterialTypography.body-large;
            color: MaterialPalette.on-surface;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            IconButton {
                icon: Icons.delete;
                tooltip: root.remove-label;
                accessible-label: root.remove-label + " " + root.path;
                clicked => { root.remove(); }
            }
        }
    }
}

export component EmptyLine inherits MaterialText {
    style: MaterialTypography.body-medium;
    color: MaterialPalette.on-surface-variant;
    wrap: word-wrap;
    overflow: clip;
}

export component RootsSection inherits PageScroll {
    title: "库目录";

    SettingGroup {
        title: "游戏目录";
        description: "准备资料库时会扫描这些目录及其子目录。";
        flush: true;

        if Settings.roots.length == 0 : HorizontalLayout {
            padding: 16px;
            EmptyLine { text: "还没有添加目录。"; }
        }

        for path[index] in Settings.roots : VerticalLayout {
            if index > 0 : HorizontalDivider { }
            PathRow {
                path: path;
                remove => { Settings.remove-root(path); }
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            alignment: start;
            OutlineButton {
                text: "添加目录";
                icon: Icons.add;
                clicked => { Settings.add-root(); }
            }
        }
    }

    SettingGroup {
        title: "已移除的作品";
        description: "从资料库移除的作品不会在扫描时重新加入，恢复后会重新出现。";
        flush: true;

        if Settings.excluded.length == 0 : HorizontalLayout {
            padding: 16px;
            EmptyLine { text: "没有已移除的作品。"; }
        }

        for game[index] in Settings.excluded : VerticalLayout {
            if index > 0 : HorizontalDivider { }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    MaterialText {
                        text: game.title;
                        style: MaterialTypography.body-large;
                        color: MaterialPalette.on-surface;
                        overflow: elide;
                    }
                    MaterialText {
                        text: game.location;
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface-variant;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    TextButton {
                        text: "恢复";
                        accessible-label: "恢复《" + game.title + "》";
                        clicked => { Settings.restore-game(game.id); }
                    }
                }
            }
        }
    }
}
