import {
    MaterialPalette, MaterialText, MaterialTypography, SmallAppBar, TabBar, ScrollView, VerticalDivider, Icon,
} from "@material";
import { App, GameSettings } from "../globals.slint";
import { Icons } from "../icons.slint";
import { Theme } from "../theme.slint";
import { EmulatorSection } from "./game-settings/emulator-section.slint";
import { InputSection } from "./game-settings/input-section.slint";
import { MetadataSection } from "./game-settings/metadata-section.slint";

component SectionItem {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 56px;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;

    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        border-radius: 28px;
        background: root.selected ? MaterialPalette.secondary-container : transparent;
    }
    Rectangle {
        border-radius: 28px;
        background: MaterialPalette.on-surface.with-alpha(
            touch.pressed ? MaterialPalette.state-layer-opacity-press
            : focus.has-focus ? MaterialPalette.state-layer-opacity-focus
            : touch.has-hover ? MaterialPalette.state-layer-opacity-hover : 0);
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 24px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 24px;
                source: root.icon;
                colorize: root.selected ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
            }
        }
        MaterialText {
            horizontal-stretch: 1;
            text: root.text;
            style: MaterialTypography.label-large;
            color: root.selected ? MaterialPalette.on-secondary-container : MaterialPalette.on-surface-variant;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

export component GameSettingsPage {
    in property <bool> compact;

    property <bool> narrow: root.width < 840px;
    property <length> side-width: 240px;
    property <length> bar-height: 64px;
    property <length> tab-height: root.narrow ? 49px : 0px;
    property <length> content-max: 760px;
    property <int> section-index: GameSettings.section == "input" ? 1
        : GameSettings.section == "metadata" ? 2 : 0;
    property <[string]> section-ids: ["emulator", "input", "metadata"];

    function select-section(index: int) {
        if root.section-ids[index] != GameSettings.section {
            GameSettings.cancel-capture();
            GameSettings.section = root.section-ids[index];
            scroll.content-y = 0px;
        }
    }

    function back() {
        GameSettings.cancel-capture();
        GameSettings.close();
        App.page = "library";
    }

    Rectangle {
        background: MaterialPalette.surface;
    }

    // SmallAppBar clips rather than elides a long title next to a leading button.
    SmallAppBar {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.bar-height;
        leading-button: { icon: Icons.arrow-back, tooltip: "返回游戏库", enabled: true };
        leading-button-clicked => { root.back(); }
    }

    MaterialText {
        x: 50px;
        y: 0px;
        width: root.width - 50px - 16px;
        height: root.bar-height;
        text: "游戏设置 · " + GameSettings.title;
        style: MaterialTypography.title-large;
        color: MaterialPalette.on-surface;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: text;
    }

    if root.narrow : TabBar {
        x: 0px;
        y: root.bar-height;
        width: root.width;
        height: root.tab-height;
        items: [
            { icon: Icons.tune, text: "模拟器" },
            { icon: Icons.sports-esports, text: "按键" },
            { icon: Icons.info, text: "作品资料" },
        ];
        current-index: root.section-index;
        index-changed(index) => { root.select-section(index); }
    }

    if !root.narrow : VerticalLayout {
        x: 0px;
        y: root.bar-height;
        width: root.side-width;
        height: root.height - root.bar-height;
        padding: 12px;
        spacing: 0px;
        alignment: start;
        accessible-role: tab-list;
        accessible-label: "游戏设置分区";

        SectionItem {
            text: "模拟器与渲染";
            icon: Icons.tune;
            selected: root.section-index == 0;
            clicked => { root.select-section(0); }
        }
        SectionItem {
            text: "按键";
            icon: Icons.sports-esports;
            selected: root.section-index == 1;
            clicked => { root.select-section(1); }
        }
        SectionItem {
            text: "作品资料";
            icon: Icons.info;
            selected: root.section-index == 2;
            clicked => { root.select-section(2); }
        }
    }

    if !root.narrow : VerticalDivider {
        x: root.side-width;
        y: root.bar-height;
        height: root.height - root.bar-height;
    }

    property <length> body-x: root.narrow ? 0px : root.side-width + 1px;
    property <length> body-y: root.bar-height + root.tab-height;

    scroll := ScrollView {
        x: root.body-x;
        y: root.body-y;
        width: root.width - root.body-x;
        height: root.height - root.body-y;

        property <length> pad: root.compact ? Theme.space-lg : Theme.space-xl;
        property <length> column: min(self.visible-width - 2 * self.pad, root.content-max);
        content-height: content.preferred-height;

        content := VerticalLayout {
            x: max((scroll.visible-width - scroll.column) / 2, scroll.pad);
            y: 0px;
            width: scroll.column;
            height: self.preferred-height;
            padding-top: scroll.pad;
            padding-bottom: scroll.pad + 72px;

            if root.section-index == 0 : EmulatorSection { }
            if root.section-index == 1 : InputSection { }
            if root.section-index == 2 : MetadataSection {
                narrow: scroll.column < 480px;
            }
        }
    }
}
