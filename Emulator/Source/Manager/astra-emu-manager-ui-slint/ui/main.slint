import { Palette } from "std-widgets.slint";
import { Theme } from "./theme.slint";
import {
    App, Library, Selection, Cores, Logs, Notices, Dialogs, Settings, Filters, Session,
    GameCard, CoreInfo, Notice, EngineAction, Appearance, SelectedGame, CompatInfo,
    ReleaseOption, PlaySession, MatchReview, BangumiProgress, ConfigField,
    TranslationProfile, GamepadBinding,
} from "./globals.slint";
import { NavRail, BottomNav } from "./components/nav.slint";
import { NoticeStack } from "./components/notices.slint";
import { LogPanel } from "./components/logs.slint";
import { ModalDialog, FatalDialog } from "./components/dialogs.slint";
import { LibraryPage } from "./pages/library.slint";
import { CoresPage } from "./pages/cores.slint";
import { SettingsPage } from "./pages/settings.slint";
import { AboutPage } from "./pages/about.slint";
import { GameViewPage } from "./pages/game-view.slint";

export {
    App, Library, Selection, Cores, Logs, Notices, Dialogs, Settings, Filters, Session,
    GameCard, CoreInfo, Notice, EngineAction, Appearance, SelectedGame, CompatInfo,
    ReleaseOption, PlaySession, MatchReview, BangumiProgress, ConfigField,
    TranslationProfile, GamepadBinding,
}

export component ManagerWindow inherits Window {
    title: Session.active && Session.title != "" ? Session.title : "AstraEMU";
    background: Theme.surface;
    min-width: 360px;
    min-height: 640px;
    preferred-width: 1280px;
    preferred-height: 800px;

    property <length> usable-x: root.safe-area-insets.left;
    property <length> usable-y: root.safe-area-insets.top;
    property <length> usable-width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
    property <length> usable-height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
    property <bool> compact: usable-width < 600px;

    init => { Palette.color-scheme = App.dark ? ColorScheme.dark : ColorScheme.light; }
    property <bool> watch-dark: App.dark;
    changed watch-dark => { Palette.color-scheme = App.dark ? ColorScheme.dark : ColorScheme.light; }

    property <bool> watch-session-active: Session.active;
    changed watch-session-active => {
        Session.pointer-state-changed();
        if !Session.active {
            Session.menu-open = false;
            Session.menu-page = "main";
        }
        Library.cover-demand(-1, "", false, "");
    }
    property <bool> watch-menu-open: Session.menu-open;
    changed watch-menu-open => { Session.pointer-state-changed(); }
    property <bool> watch-modal: Dialogs.modal-active;
    changed watch-modal => { Session.pointer-state-changed(); }
    property <bool> watch-fatal: Dialogs.fatal-active;
    changed watch-fatal => { Session.pointer-state-changed(); }
    property <float> watch-pointer-x: Session.pointer-x;
    changed watch-pointer-x => { Session.pointer-state-changed(); }
    property <float> watch-pointer-y: Session.pointer-y;
    changed watch-pointer-y => { Session.pointer-state-changed(); }
    property <float> watch-pointer-w: Session.pointer-width;
    changed watch-pointer-w => { Session.pointer-state-changed(); }
    property <float> watch-pointer-h: Session.pointer-height;
    changed watch-pointer-h => { Session.pointer-state-changed(); }

    property <string> watch-selected: Library.selected-id;
    changed watch-selected => { Library.cover-demand(-1, "", false, ""); }
    property <string> watch-page: App.page;
    changed watch-page => { Library.cover-demand(-1, "", false, ""); }
    property <string> watch-view: App.appearance.view-mode;
    changed watch-view => { Library.cover-demand(-1, "", false, ""); }
    property <bool> watch-cover-loading: Library.cover-loading;
    changed watch-cover-loading => { Library.cover-demand(-1, "", false, ""); }

    if !root.compact : NavRail {
        x: root.usable-x;
        y: root.usable-y;
        height: root.usable-height;
    }

    pages := Rectangle {
        x: root.usable-x + (root.compact ? 0px : 88px);
        y: root.usable-y;
        width: root.usable-width - (root.compact ? 0px : 88px);
        height: root.usable-height - (root.compact ? 80px : 0px);
        clip: true;

        if App.page == "library" : LibraryPage {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            compact: root.compact;
        }
        if App.page == "cores" : CoresPage {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }
        if App.page == "settings" : SettingsPage {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            compact: root.compact;
        }
        if App.page == "about" : AboutPage {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
        }
    }

    if root.compact : BottomNav {
        x: root.usable-x;
        y: root.usable-y + root.usable-height - 80px;
        width: root.usable-width;
    }

    if Session.active : GameViewPage {
        x: root.usable-x;
        y: root.usable-y;
        width: root.usable-width;
        height: root.usable-height;
        z: 10;
    }

    NoticeStack {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        compact: root.compact;
        z: 100;
    }
    LogPanel { z: 105; }
    ModalDialog { z: 110; }
    FatalDialog { z: 1000; }
}
