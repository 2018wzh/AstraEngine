export struct Appearance {
    theme-mode: string,
    density: string,
    cover-size: string,
    view-mode: string,
    reduce-motion: bool,
    cover-badges: bool,
}

export struct Choice {
    id: string,
    label: string,
}

export global App {
    in-out property <string> page: "library";
    in-out property <string> settings-category: "appearance";
    in-out property <Appearance> appearance: {
        theme-mode: "system",
        density: "comfortable",
        cover-size: "medium",
        view-mode: "grid",
        reduce-motion: false,
        cover-badges: true,
    };
    in-out property <bool> system-dark: true;
    out property <bool> dark: appearance.theme-mode == "system" ? system-dark : appearance.theme-mode == "dark";
    in-out property <string> version;
    in-out property <string> build;
    callback appearance-changed(Appearance);
    // "data" | "logs" | "third-party-notices"
    callback open-path(string);
    callback restart();
}

export global Network {
    in-out property <bool> allowed;
    in-out property <bool> syncing;
    in-out property <string> sync-status;
    in-out property <string> source;
    callback set-allowed(bool);
    callback sync-now();
}

export struct GameCard {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    tint: color,
    ready: bool,
    problem: string,
    play-time: string,
    last-played: string,
    compat: string,
}

export global Library {
    in-out property <[GameCard]> games;
    in-out property <string> query;
    in-out property <string> sort: "title";
    in-out property <string> compat-filter: "all";
    in-out property <string> prepare-state: "unprepared";
    in-out property <string> prepare-label: "准备";
    in-out property <string> prepare-detail;
    in-out property <float> prepare-progress: -1;
    in-out property <bool> can-cancel-prepare;
    in-out property <string> selected-id;
    in-out property <bool> detail-open;
    in-out property <bool> cover-loading;
    callback prepare();
    callback cancel-prepare();
    callback add-directory();
    callback search(string);
    callback set-sort(string);
    callback set-compat-filter(string);
    callback select(string);
    callback launch(string);
    callback open-game-settings(string);
    callback open-folder(string);
    callback remove(string);
    callback cover-demand(int, string, bool, string);
}

export struct SelectedGame {
    id: string,
    title: string,
    engine: string,
    emulator: string,
    emulator-id: string,
    launchable: bool,
    problem: string,
    play-time: string,
    last-played: string,
    developer: string,
    release-date: string,
    platforms: string,
    description: string,
    tags: string,
    aliases: string,
}

export struct CompatInfo {
    status: string,
    notes: string,
    updated: string,
    release-id: string,
    emulator-label: string,
    report-url: string,
    hint: string,
}

export struct PlaySession {
    started: string,
    duration: string,
    ended-by: string,
}

export struct MatchReview {
    id: string,
    provider: string,
    title: string,
    aliases: string,
    release-date: string,
    developer: string,
}

export struct BangumiProgress {
    status: string,
    rating: int,
    note: string,
}

export global Selection {
    in-out property <SelectedGame> game;
    in-out property <image> cover;
    in-out property <color> tint;
    in-out property <[Choice]> emulator-choices;
    in-out property <CompatInfo> compat;
    in-out property <[Choice]> releases;
    in-out property <string> pinned-release;
    in-out property <[PlaySession]> history;
    in-out property <BangumiProgress> bangumi;
    in-out property <string> bangumi-summary;
    in-out property <bool> metadata-busy;
    in-out property <string> metadata-status;
    in-out property <[MatchReview]> matches;
    callback choose-emulator(string);
    callback pin-release(string);
    callback fetch-releases();
    callback sync-bangumi(BangumiProgress);
    callback search-metadata(string, string);
    callback accept-match(string);
    callback refresh-metadata(string);
    callback unlink-metadata(string);
}

export struct ConfigField {
    key: string,
    label: string,
    description: string,
    group: string,
    kind: string,
    value: string,
    display-value: string,
    options: [string],
    option-values: [string],
    min: float,
    max: float,
    step: float,
    unit: string,
    advanced: bool,
    overridden: bool,
    error: string,
}

export struct GamepadBinding {
    id: string,
    label: string,
    key: string,
}

export struct Recipe {
    id: string,
    title: string,
    recommended: bool,
}

export struct PatchState {
    step: int,
    running: bool,
    phase: string,
    completed: float,
    total: float,
    output: string,
    error: string,
    can-start: bool,
    script: string,
    patch-directory: string,
    output-directory: string,
}

export struct PatchGame {
    id: string,
    title: string,
    subtitle: string,
    linked: bool,
    cover: image,
    tint: color,
}

export global Patch {
    in-out property <[PatchGame]> games;
    in-out property <string> query;
    // Empty id when no game is selected.
    in-out property <PatchGame> game;
    in-out property <image> cover;
    in-out property <[Recipe]> recipes;
    in-out property <string> hint;
    // Page navigation 1–4; `state` reports running/failed and completion (5).
    in-out property <int> step: 1;
    in-out property <PatchState> state;
    callback search(string);
    callback select-game(string);
    callback select-recipe(string);
    callback pick-script();
    // "patch" | "output"
    callback pick-directory(string);
    callback start();
    callback cancel();
    callback open-output();
    callback cover-demand(int, string, bool);
}

export struct RenderState {
    supported: bool,
    options: [Choice],
    mode: string,
    custom-width: int,
    custom-height: int,
    min: string,
    max: string,
    note: string,
    error: string,
}

export struct TranslationForm {
    provider: string,
    base-url: string,
    openai-api: string,
    model: string,
    language: string,
    timeout-s: int,
    custom-prompt: string,
    context-segments: int,
    context-chars: int,
}

export struct Excluded {
    id: string,
    title: string,
    location: string,
}

export global Settings {
    in-out property <TranslationForm> translation;
    in-out property <bool> translation-enabled;
    in-out property <bool> secret-saved;
    in-out property <[string]> models;
    in-out property <string> translation-status;
    callback save-translation(TranslationForm, string);
    callback test-translation(TranslationForm, string);
    callback set-translation-enabled(bool);

    in-out property <bool> sensitive-covers;
    in-out property <bool> bangumi-token-saved;
    in-out property <string> compat-summary;
    callback set-sensitive-covers(bool);
    callback save-bangumi-token(string);
    callback clear-bangumi-token();

    in-out property <bool> gamepad-enabled: true;
    in-out property <string> deadzone: "medium";
    in-out property <[GamepadBinding]> bindings;
    in-out property <string> capture-button;
    in-out property <string> capture-hint;
    in-out property <[string]> pad-state;
    callback set-gamepad-enabled(bool);
    callback set-deadzone(string);
    callback reset-bindings();

    in-out property <[string]> roots;
    in-out property <[Excluded]> excluded;
    callback add-root();
    callback remove-root(string);
    callback restore-game(string);

    public function begin-capture(button: string) {
        self.capture-button = button;
        self.capture-hint = "";
        GameSettings.capture-button = "";
        GameSettings.capture-hint = "";
    }

    public function cancel-capture() {
        self.capture-button = "";
        self.capture-hint = "";
    }
}

export global GameSettings {
    in-out property <string> game-id;
    in-out property <string> title;
    in-out property <string> section: "emulator";
    in-out property <[Choice]> emulator-choices;
    in-out property <string> emulator-id;

    in-out property <bool> render-supported;
    in-out property <[Choice]> render-options;
    in-out property <string> render-mode: "default";
    in-out property <int> custom-width;
    in-out property <int> custom-height;
    in-out property <string> render-min;
    in-out property <string> render-max;
    in-out property <string> render-note;
    in-out property <string> render-error;

    in-out property <[ConfigField]> fields;

    in-out property <bool> recommended-available;
    in-out property <string> recommended-summary;

    in-out property <bool> input-override;
    in-out property <[GamepadBinding]> bindings;
    in-out property <string> capture-button;
    in-out property <string> capture-hint;

    callback close();
    callback set-emulator(string);
    callback set-render(string, int, int);
    callback field-changed(string, string);
    callback reset-field(string);
    callback pick-path(string);
    callback apply-recommended();
    callback set-input-override(bool);

    public function begin-capture(button: string) {
        self.capture-button = button;
        self.capture-hint = "";
        Settings.capture-button = "";
        Settings.capture-hint = "";
    }

    public function cancel-capture() {
        self.capture-button = "";
        self.capture-hint = "";
    }
}

export struct CoreInfo {
    id: string,
    name: string,
    engine: string,
    version: string,
    state: string,
    source: string,
    message: string,
    capabilities: [string],
    removable: bool,
    update-version: string,
}

export global Logs {
    in-out property <bool> open;
    in-out property <string> core;
    in-out property <string> scope: "core";
    in-out property <string> text;
    in-out property <int> count;
    callback load(string);
}

export global Cores {
    in-out property <[CoreInfo]> items;
    in-out property <bool> restart-required;
    in-out property <int> updates-available;
    in-out property <[ConfigField]> default-fields;
    in-out property <string> default-plugin;
    in-out property <RenderState> default-render;
    callback install-local();
    callback install-online(string);
    callback uninstall(string);
    callback restart();
    callback view-logs(string);
    callback select-defaults(string);
    callback default-field-changed(string, string);
    callback reset-default-field(string);
    callback set-default-render(string, int, int);

    view-logs(core) => {
        Logs.core = core;
        Logs.scope = "core";
        Logs.open = true;
        Logs.load(core);
    }
}

export struct Notice {
    id: string,
    severity: string,
    title: string,
    detail: string,
    code: string,
    core: string,
}

export global Notices {
    in-out property <[Notice]> items;
    in-out property <string> snackbar-text;
    in-out property <string> snackbar-action;
    in-out property <int> snackbar-serial;
    callback dismiss(string);
    callback snackbar-action-clicked();
    callback view-logs(string);

    view-logs(core) => {
        Logs.core = core;
        Logs.scope = core == "" ? "all" : "core";
        Logs.open = true;
        Logs.load(core);
    }
}

export global Dialogs {
    in-out property <bool> modal-active;
    in-out property <string> modal-caption;
    in-out property <string> modal-message;
    in-out property <[string]> modal-buttons;
    in-out property <bool> modal-has-input;
    in-out property <string> modal-text;
    callback modal-submit(int, string);
    callback modal-cancel();
    in-out property <bool> fatal-active;
    in-out property <string> fatal-title;
    in-out property <string> fatal-detail;
    in-out property <string> fatal-code;
    in-out property <bool> fatal-retryable;
    callback retry();
}

export global Filters {
    in-out property <string> preset: "none";
    in-out property <[ConfigField]> fields;
    callback set-preset(string);
    callback field-changed(string, string);
    callback reset-parameters();
    callback load-source();
}

export struct EngineAction {
    control: int,
    label: string,
    icon: string,
}

export global Session {
    in-out property <bool> active;
    in-out property <string> phase: "opening";
    in-out property <string> title;
    in-out property <string> launch-title;
    in-out property <image> launch-cover;
    in-out property <image> frame;
    in-out property <float> output-aspect: 1.333333;
    in-out property <float> native-width: 1024;
    in-out property <float> native-height: 768;
    in-out property <float> raster-width: 1024;
    in-out property <float> raster-height: 768;
    in-out property <float> content-x;
    in-out property <float> content-y;
    in-out property <float> content-width: 1024;
    in-out property <float> content-height: 768;
    in-out property <float> pointer-x;
    in-out property <float> pointer-y;
    in-out property <float> pointer-width;
    in-out property <float> pointer-height;
    in-out property <bool> menu-open;
    in-out property <string> menu-page: "main";
    in-out property <[EngineAction]> actions;
    in-out property <string> action-message;
    in-out property <int> action-serial;
    in-out property <bool> fullscreen;
    callback input(string, bool, float);
    callback leave();
    callback engine-action(int);
    callback set-fullscreen(bool);
    callback pointer-state-changed();
}

export global Onboarding {
    in-out property <int> step;
    in-out property <[string]> roots;
    callback add-root();
    callback remove-root(string);
    callback finish();
}
