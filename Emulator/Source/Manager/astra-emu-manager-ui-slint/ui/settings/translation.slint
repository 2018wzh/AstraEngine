import { ComboBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings } from "../globals.slint";
import { Card, PillButton, SwitchRow, Segmented, SettingRow } from "../components/controls.slint";

export component TranslationSettingsPage inherits Rectangle {
    background: Theme.surface;
    private property <bool> advanced: false;
    property <[string]> provider-labels: ["OpenAI", "Anthropic", "Google"];

    pure function provider-index(provider: string) -> int {
        return provider == "anthropic" ? 1 : provider == "google" ? 2 : 0;
    }
    pure function provider-from-index(index: int) -> string {
        return index == 1 ? "anthropic" : index == 2 ? "google" : "openai";
    }
    pure function default-base-url(provider: string) -> string {
        return provider == "anthropic" ? "https://api.anthropic.com/v1"
            : provider == "google" ? "https://generativelanguage.googleapis.com/v1beta"
            : "https://api.openai.com/v1";
    }

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "实时翻译";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }

            Card {
                VerticalLayout {
                    SwitchRow {
                        label: "启用实时翻译";
                        description: Settings.network-allowed
                            ? "启用后会将当前游戏台词及上下文发送至指定的接口与模型。"
                            : "需要先在“作品资料与账号”中允许联网。";
                        checked: Settings.translation-enabled;
                        toggled => {
                            Settings.set-translation-enabled(!Settings.translation-enabled);
                        }
                    }
                    SettingRow {
                        title: "服务商";
                        desc: "";
                        ComboBox {
                            width: 200px;
                            model: root.provider-labels;
                            current-index: root.provider-index(Settings.translation.provider);
                            selected(value) => {
                                Settings.translation.provider = root.provider-from-index(self.current-index);
                                Settings.translation.base-url = root.default-base-url(Settings.translation.provider);
                            }
                        }
                    }
                    SettingRow {
                        title: "接口地址";
                        desc: "";
                        LineEdit {
                            width: 280px;
                            text: Settings.translation.base-url;
                            placeholder-text: "https://…/v1";
                            edited(value) => {
                                Settings.translation.base-url = value;
                            }
                        }
                    }
                    SettingRow {
                        title: "模型名称";
                        desc: "必填";
                        LineEdit {
                            width: 220px;
                            text: Settings.translation.model;
                            placeholder-text: "必填";
                            edited(value) => {
                                Settings.translation.model = value;
                            }
                        }
                    }
                    if Settings.models.length > 0 : SettingRow {
                        title: "可用模型";
                        desc: "来自上次测试连接";
                        ComboBox {
                            width: 220px;
                            model: Settings.models;
                            selected(value) => {
                                Settings.translation.model = value;
                            }
                        }
                    }
                    SettingRow {
                        title: "目标语言";
                        desc: "例如 zh-CN";
                        LineEdit {
                            width: 160px;
                            text: Settings.translation.language;
                            placeholder-text: "例如 zh-CN";
                            edited(value) => {
                                Settings.translation.language = value;
                            }
                        }
                    }
                    SettingRow {
                        title: "超时（毫秒）";
                        desc: "";
                        SpinBox {
                            width: 140px;
                            value: Settings.translation.timeout-ms;
                            minimum: 1000;
                            maximum: 120000;
                            step-size: 1000;
                            edited(value) => {
                                Settings.translation.timeout-ms = value;
                            }
                        }
                    }
                    SettingRow {
                        title: "API 密钥";
                        desc: "留空则保留已保存的密钥";
                        LineEdit {
                            width: 240px;
                            text <=> Settings.translation-secret;
                            input-type: password;
                            placeholder-text: "留空则保留已保存的密钥";
                        }
                    }
                    SwitchRow {
                        label: "高级";
                        description: "";
                        checked <=> root.advanced;
                    }
                    if root.advanced && Settings.translation.provider == "openai" : SettingRow {
                        title: "接口格式";
                        desc: "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["Responses", "Chat Completions"];
                                current: Settings.translation.openai-api == "chat_completions" ? 1 : 0;
                                segment-width: 160px;
                                selected(i) => {
                                    Settings.translation.openai-api = i == 1 ? "chat_completions" : "responses";
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    text: "保存";
                    variant: "filled";
                    clicked => {
                        Settings.save-translation(Settings.translation, Settings.translation-secret);
                        Settings.translation-secret = "";
                    }
                }
                PillButton {
                    text: "测试连接";
                    variant: "outlined";
                    clicked => { Settings.test-translation(Settings.translation, Settings.translation-secret); }
                }
            }

            if Settings.translation-status != "" : Text {
                text: Settings.translation-status;
                color: Theme.on-variant;
                wrap: word-wrap;
                font-size: Theme.body-sm;
            }
        }
    }
}
