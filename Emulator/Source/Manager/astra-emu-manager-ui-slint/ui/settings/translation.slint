import { ComboBox, LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings } from "../globals.slint";
import { Card, PillButton, SwitchRow, Segmented, SettingRow } from "../components/controls.slint";

export component TranslationSettingsPage inherits Rectangle {
    background: Theme.surface;
    private property <bool> advanced: false;
    property <[string]> kind-labels: ["OpenAI 兼容服务", "OpenAI 官方", "ECNU 服务", "其他第三方服务"];
    property <[string]> kind-values: ["openai-compatible", "openai", "ecnu", "third_party"];

    pure function kind-index(kind: string) -> int {
        return kind == "openai" ? 1 : kind == "ecnu" ? 2 : kind == "third_party" ? 3 : 0;
    }
    pure function kind-from-label(label: string) -> string {
        return label == "OpenAI 官方" ? "openai" : label == "ECNU 服务" ? "ecnu" : label == "其他第三方服务" ? "third_party" : "openai-compatible";
    }

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "实时翻译";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }

            Card {
                VerticalLayout {
                    SettingRow {
                        title: "服务类型";
                        desc: "";
                        divider: false;
                        ComboBox {
                            width: 200px;
                            model: root.kind-labels;
                            current-index: root.kind-index(Settings.translation.kind);
                            selected(value) => {
                                Settings.translation = {
                                    kind: root.kind-from-label(value),
                                    endpoint: Settings.translation.endpoint,
                                    protocol: Settings.translation.protocol,
                                    model: Settings.translation.model,
                                    language: Settings.translation.language,
                                    timeout-ms: Settings.translation.timeout-ms,
                                };
                            }
                        }
                    }
                    SettingRow {
                        title: "接口地址";
                        desc: "";
                        LineEdit {
                            width: 280px;
                            text: Settings.translation.endpoint;
                            placeholder-text: "https://…/v1";
                            edited(value) => {
                                Settings.translation = {
                                    kind: Settings.translation.kind,
                                    endpoint: value,
                                    protocol: Settings.translation.protocol,
                                    model: Settings.translation.model,
                                    language: Settings.translation.language,
                                    timeout-ms: Settings.translation.timeout-ms,
                                };
                            }
                        }
                    }
                    SettingRow {
                        title: "模型名称";
                        desc: "必填";
                        LineEdit {
                            width: 220px;
                            text: Settings.translation.model;
                            placeholder-text: "必填";
                            edited(value) => {
                                Settings.translation = {
                                    kind: Settings.translation.kind,
                                    endpoint: Settings.translation.endpoint,
                                    protocol: Settings.translation.protocol,
                                    model: value,
                                    language: Settings.translation.language,
                                    timeout-ms: Settings.translation.timeout-ms,
                                };
                            }
                        }
                    }
                    SettingRow {
                        title: "目标语言";
                        desc: "例如 zh-CN";
                        LineEdit {
                            width: 160px;
                            text: Settings.translation.language;
                            placeholder-text: "例如 zh-CN";
                            edited(value) => {
                                Settings.translation = {
                                    kind: Settings.translation.kind,
                                    endpoint: Settings.translation.endpoint,
                                    protocol: Settings.translation.protocol,
                                    model: Settings.translation.model,
                                    language: value,
                                    timeout-ms: Settings.translation.timeout-ms,
                                };
                            }
                        }
                    }
                    SettingRow {
                        title: "超时（毫秒）";
                        desc: "";
                        SpinBox {
                            width: 140px;
                            value: Settings.translation.timeout-ms;
                            minimum: 1000;
                            maximum: 120000;
                            step-size: 1000;
                            edited(value) => {
                                Settings.translation = {
                                    kind: Settings.translation.kind,
                                    endpoint: Settings.translation.endpoint,
                                    protocol: Settings.translation.protocol,
                                    model: Settings.translation.model,
                                    language: Settings.translation.language,
                                    timeout-ms: value,
                                };
                            }
                        }
                    }
                    SettingRow {
                        title: "API 密钥";
                        desc: "留空则保留已保存的密钥";
                        LineEdit {
                            width: 240px;
                            text <=> Settings.translation-secret;
                            input-type: password;
                            placeholder-text: "留空则保留已保存的密钥";
                        }
                    }
                    SwitchRow {
                        label: "高级";
                        description: "";
                        checked <=> root.advanced;
                    }
                    if root.advanced : SettingRow {
                        title: "协议";
                        desc: "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["Responses 接口", "Chat Completions 接口"];
                                current: Settings.translation.protocol == "chat_completions" ? 1 : 0;
                                segment-width: 160px;
                                selected(i) => {
                                    Settings.translation = {
                                        kind: Settings.translation.kind,
                                        endpoint: Settings.translation.endpoint,
                                        protocol: i == 1 ? "chat_completions" : "responses",
                                        model: Settings.translation.model,
                                        language: Settings.translation.language,
                                        timeout-ms: Settings.translation.timeout-ms,
                                    };
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    text: "保存";
                    variant: "filled";
                    clicked => {
                        Settings.save-translation(Settings.translation, Settings.translation-secret);
                        Settings.translation-secret = "";
                    }
                }
                PillButton {
                    text: "测试连接";
                    variant: "outlined";
                    clicked => { Settings.test-translation(); }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Text {
                        text: Settings.translation-consent
                            ? "已授权当前翻译服务。更改配置后需重新授权。"
                            : "翻译服务会将当前游戏台词及上下文发送至指定的接口与模型。授权为全局生效。";
                        color: Theme.on-variant;
                        wrap: word-wrap;
                        font-size: Theme.body-sm;
                    }
                    if !Settings.translation-consent : PillButton {
                        text: "授予联网权限";
                        variant: "tonal";
                        clicked => { Settings.grant-translation-consent(); }
                    }
                }
            }
        }
    }
}
