import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings, Selection } from "../globals.slint";
import { Card, SwitchRow, SettingRow, Segmented, PillButton, SectionTitle } from "../components/controls.slint";

export component InputSettingsPage inherits Rectangle {
    background: Theme.surface;

    property <[string]> key-labels: ["未绑定", "回车", "Esc", "空格", "↑", "↓", "←", "→", "Shift", "Ctrl", "Tab", "退格", "Page Up", "Page Down", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12"];
    property <[string]> key-values: ["", "enter", "escape", "space", "arrow_up", "arrow_down", "arrow_left", "arrow_right", "shift", "control", "tab", "backspace", "page_up", "page_down", "f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12"];

    pure function key-index(value: string) -> int {
        return value == "enter" ? 1
            : value == "escape" ? 2
            : value == "space" ? 3
            : value == "arrow_up" ? 4
            : value == "arrow_down" ? 5
            : value == "arrow_left" ? 6
            : value == "arrow_right" ? 7
            : value == "shift" ? 8
            : value == "control" ? 9
            : value == "tab" ? 10
            : value == "backspace" ? 11
            : value == "page_up" ? 12
            : value == "page_down" ? 13
            : value == "f1" ? 14
            : value == "f2" ? 15
            : value == "f3" ? 16
            : value == "f4" ? 17
            : value == "f5" ? 18
            : value == "f6" ? 19
            : value == "f7" ? 20
            : value == "f8" ? 21
            : value == "f9" ? 22
            : value == "f10" ? 23
            : value == "f11" ? 24
            : value == "f12" ? 25
            : 0;
    }

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "输入与手柄";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }

            Card {
                VerticalLayout {
                    SwitchRow {
                        label: "启用手柄";
                        description: "";
                        checked <=> Settings.gamepad-enabled;
                    }
                    SettingRow {
                        title: "摇杆死区";
                        desc: "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["低", "中", "高"];
                                current: Settings.deadzone == "low" ? 0 : Settings.deadzone == "high" ? 2 : 1;
                                segment-width: 72px;
                                selected(i) => {
                                    Settings.deadzone = i == 0 ? "low" : i == 2 ? "high" : "medium";
                                }
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    for binding in Settings.bindings : HorizontalLayout {
                        spacing: 12px;
                        alignment: center;
                        Rectangle {
                            width: 96px;
                            height: 32px;
                            border-radius: 16px;
                            background: Theme.surface-high;
                            Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                text: binding.label;
                                color: Theme.on-surface;
                                font-size: Theme.label;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        ComboBox {
                            horizontal-stretch: 1;
                            model: root.key-labels;
                            current-index: root.key-index(binding.key);
                            selected(value) => {
                                Settings.bind(binding.id, value == "未绑定" ? "" : root.key-values[root.key-labels.length > 0 ? root.key-index-of(value) : 0]);
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    text: "保存为默认按键";
                    variant: "filled";
                    clicked => { Settings.save-input(Settings.gamepad-enabled, Settings.deadzone); }
                }
                PillButton {
                    text: "恢复推荐按键";
                    variant: "outlined";
                    clicked => { Settings.reset-bindings(); }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    SectionTitle { text: Selection.game.id != "" ? "当前作品：" + Selection.game.title : "当前作品"; }
                    if Selection.game.id != "" : HorizontalLayout {
                        spacing: 8px;
                        PillButton {
                            text: "为这部作品单独保存";
                            variant: "filled";
                            clicked => { Selection.save-game-input(Settings.gamepad-enabled, Settings.deadzone); }
                        }
                        PillButton {
                            text: "清除单独设置";
                            variant: "outlined";
                            clicked => { Selection.clear-game-input(); }
                        }
                    }
                    if Selection.game.id == "" : Text {
                        text: "在游戏库中选择作品后，可为它单独设置按键。";
                        color: Theme.on-variant;
                        font-size: Theme.body-sm;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    pure function key-index-of(label: string) -> int {
        return label == "回车" ? 1
            : label == "Esc" ? 2
            : label == "空格" ? 3
            : label == "↑" ? 4
            : label == "↓" ? 5
            : label == "←" ? 6
            : label == "→" ? 7
            : label == "Shift" ? 8
            : label == "Ctrl" ? 9
            : label == "Tab" ? 10
            : label == "退格" ? 11
            : label == "Page Up" ? 12
            : label == "Page Down" ? 13
            : label == "F1" ? 14
            : label == "F2" ? 15
            : label == "F3" ? 16
            : label == "F4" ? 17
            : label == "F5" ? 18
            : label == "F6" ? 19
            : label == "F7" ? 20
            : label == "F8" ? 21
            : label == "F9" ? 22
            : label == "F10" ? 23
            : label == "F11" ? 24
            : label == "F12" ? 25
            : 0;
    }
}
