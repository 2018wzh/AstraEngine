import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { App, Appearance } from "../globals.slint";
import { Card, Segmented, SwitchRow, SettingRow } from "../components/controls.slint";

export component AppearanceSettingsPage inherits Rectangle {
    background: Theme.surface;

    function push(next: Appearance) {
        App.appearance = next;
        App.appearance-changed(next);
    }

    function with-theme(mode: string) -> Appearance {
        return {
            theme-mode: mode,
            density: App.appearance.density,
            cover-size: App.appearance.cover-size,
            view-mode: App.appearance.view-mode,
            reduce-motion: App.appearance.reduce-motion,
            cover-badges: App.appearance.cover-badges,
        };
    }
    function with-view(mode: string) -> Appearance {
        return {
            theme-mode: App.appearance.theme-mode,
            density: App.appearance.density,
            cover-size: App.appearance.cover-size,
            view-mode: mode,
            reduce-motion: App.appearance.reduce-motion,
            cover-badges: App.appearance.cover-badges,
        };
    }
    function with-cover(size: string) -> Appearance {
        return {
            theme-mode: App.appearance.theme-mode,
            density: App.appearance.density,
            cover-size: size,
            view-mode: App.appearance.view-mode,
            reduce-motion: App.appearance.reduce-motion,
            cover-badges: App.appearance.cover-badges,
        };
    }
    function with-density(d: string) -> Appearance {
        return {
            theme-mode: App.appearance.theme-mode,
            density: d,
            cover-size: App.appearance.cover-size,
            view-mode: App.appearance.view-mode,
            reduce-motion: App.appearance.reduce-motion,
            cover-badges: App.appearance.cover-badges,
        };
    }
    function with-motion(on: bool) -> Appearance {
        return {
            theme-mode: App.appearance.theme-mode,
            density: App.appearance.density,
            cover-size: App.appearance.cover-size,
            view-mode: App.appearance.view-mode,
            reduce-motion: on,
            cover-badges: App.appearance.cover-badges,
        };
    }
    function with-badges(on: bool) -> Appearance {
        return {
            theme-mode: App.appearance.theme-mode,
            density: App.appearance.density,
            cover-size: App.appearance.cover-size,
            view-mode: App.appearance.view-mode,
            reduce-motion: App.appearance.reduce-motion,
            cover-badges: on,
        };
    }

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "外观";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }

            Card {
                VerticalLayout {
                    SettingRow {
                        title: "颜色模式";
                        desc: "";
                        divider: false;
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["跟随系统", "浅色", "深色"];
                                current: App.appearance.theme-mode == "light" ? 1 : App.appearance.theme-mode == "dark" ? 2 : 0;
                                segment-width: 88px;
                                selected(i) => {
                                    root.push(root.with-theme(i == 1 ? "light" : i == 2 ? "dark" : "system"));
                                }
                            }
                        }
                    }
                    SettingRow {
                        title: "视图";
                        desc: "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["网格", "列表"];
                                current: App.appearance.view-mode == "list" ? 1 : 0;
                                segment-width: 88px;
                                selected(i) => { root.push(root.with-view(i == 1 ? "list" : "grid")); }
                            }
                        }
                    }
                    SettingRow {
                        title: "封面大小";
                        desc: App.appearance.view-mode == "list" ? "列表视图下不适用" : "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            opacity: App.appearance.view-mode == "list" ? 0.38 : 1;
                            Segmented {
                                items: ["大", "中", "小"];
                                current: App.appearance.cover-size == "large" ? 0 : App.appearance.cover-size == "small" ? 2 : 1;
                                segment-width: 72px;
                                selected(i) => {
                                    if App.appearance.view-mode != "list" {
                                        root.push(root.with-cover(i == 0 ? "large" : i == 2 ? "small" : "medium"));
                                    }
                                }
                            }
                        }
                    }
                    SettingRow {
                        title: "显示密度";
                        desc: "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["舒适", "紧凑"];
                                current: App.appearance.density == "compact" ? 1 : 0;
                                segment-width: 88px;
                                selected(i) => { root.push(root.with-density(i == 1 ? "compact" : "comfortable")); }
                            }
                        }
                    }
                    SwitchRow {
                        label: "减少动态效果";
                        description: "关闭面板滑动、封面悬停等动画";
                        checked: App.appearance.reduce-motion;
                        toggled => { root.push(root.with-motion(!App.appearance.reduce-motion)); }
                    }
                    SwitchRow {
                        label: "封面上显示兼容性评级";
                        description: "";
                        checked: App.appearance.cover-badges;
                        toggled => { root.push(root.with-badges(!App.appearance.cover-badges)); }
                    }
                }
            }

            Text {
                text: "强调色跟随系统设置";
                color: Theme.on-variant;
                font-size: Theme.body-sm;
            }
        }
    }
}
