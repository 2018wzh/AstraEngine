import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings, Selection } from "../globals.slint";
import { Card, PillButton, InfoRow } from "../components/controls.slint";

export component CompatibilitySettingsPage inherits Rectangle {
    background: Theme.surface;

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "兼容性数据";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }

            Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    Text {
                        text: "社区兼容性数据";
                        color: Theme.on-surface;
                        font-size: Theme.title-md;
                        font-weight: 650;
                    }
                    Text {
                        text: "由社区维护的视觉小说运行情况评级。";
                        color: Theme.on-variant;
                        font-size: Theme.body-sm;
                        wrap: word-wrap;
                    }
                    InfoRow {
                        label: "数据来源";
                        value: Settings.compat-source != "" ? Settings.compat-source : "未配置";
                    }
                    InfoRow {
                        label: "同步状态";
                        value: Settings.compat-summary != "" ? Settings.compat-summary : "尚未同步";
                    }
                    HorizontalLayout {
                        alignment: start;
                        PillButton {
                            text: "刷新兼容性数据";
                            variant: "filled";
                            enabled: Settings.network-allowed;
                            clicked => { Selection.refresh-compat(); }
                        }
                    }
                    if !Settings.network-allowed : Text {
                        text: "请先在“作品资料与账号”中开启联网。";
                        color: Theme.error;
                        wrap: word-wrap;
                        font-size: Theme.body-sm;
                    }
                }
            }
        }
    }
}
