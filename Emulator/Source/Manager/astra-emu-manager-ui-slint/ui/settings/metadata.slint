import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings } from "../globals.slint";
import { Card, PillButton, SwitchRow, SettingRow, Segmented } from "../components/controls.slint";

export component MetadataSettingsPage inherits Rectangle {
    background: Theme.surface;

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "作品资料与账号";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }

            Card {
                VerticalLayout {
                    SwitchRow {
                        label: "允许联网";
                        description: "包括 VNDB 资料与封面、Bangumi、AstraEMU 元数据与核心更新、实时翻译";
                        checked: Settings.network-allowed;
                        toggled => {
                            Settings.set-network-allowed(!Settings.network-allowed);
                        }
                    }
                    SettingRow {
                        title: "Bangumi 访问令牌";
                        desc: "保存在系统凭据管理器";
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                width: 220px;
                                text <=> Settings.bangumi-token;
                                input-type: password;
                                placeholder-text: "Bangumi 访问令牌";
                            }
                            PillButton {
                                text: "保存";
                                variant: "tonal";
                                clicked => {
                                    Settings.save-bangumi-token(Settings.bangumi-token);
                                    Settings.bangumi-token = "";
                                }
                            }
                            PillButton {
                                text: "清除";
                                variant: "outlined";
                                clicked => { Settings.clear-bangumi-token(); }
                            }
                        }
                    }
                    SettingRow {
                        title: "资料来源";
                        desc: "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["VNDB", "Bangumi"];
                                current: Settings.metadata-provider == "bangumi" ? 1 : 0;
                                segment-width: 96px;
                                selected(i) => { Settings.metadata-provider = i == 1 ? "bangumi" : "vndb"; }
                            }
                        }
                    }
                    SwitchRow {
                        label: "下载敏感封面";
                        description: "";
                        checked: Settings.sensitive-covers;
                        toggled => {
                            Settings.set-sensitive-covers(!Settings.sensitive-covers);
                        }
                    }
                }
            }
        }
    }
}
