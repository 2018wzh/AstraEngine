import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings } from "../globals.slint";
import { Card, SwitchRow, SettingRow, Segmented } from "../components/controls.slint";

export component MetadataSettingsPage inherits Rectangle {
    background: Theme.surface;

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;

            Text {
                text: "作品资料与账号";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }

            Card {
                VerticalLayout {
                    SwitchRow {
                        label: "允许联网获取 VNDB 资料";
                        description: "";
                        checked: Settings.vndb-enabled;
                        toggled => {
                            Settings.vndb-enabled = !Settings.vndb-enabled;
                            Settings.set-metadata-consent("vndb", Settings.vndb-enabled, "");
                        }
                    }
                    SwitchRow {
                        label: "允许联网获取 Bangumi 资料与收藏";
                        description: "";
                        checked: Settings.bangumi-enabled;
                        toggled => {
                            Settings.bangumi-enabled = !Settings.bangumi-enabled;
                            Settings.set-metadata-consent("bangumi", Settings.bangumi-enabled, Settings.bangumi-token);
                            Settings.bangumi-token = "";
                        }
                    }
                    SettingRow {
                        title: "Bangumi 访问令牌";
                        desc: "保存在系统凭据管理器";
                        LineEdit {
                            width: 260px;
                            text <=> Settings.bangumi-token;
                            input-type: password;
                            placeholder-text: "Bangumi 访问令牌（保存在系统凭据管理器）";
                        }
                    }
                    SettingRow {
                        title: "资料来源";
                        desc: "";
                        HorizontalLayout {
                            horizontal-stretch: 0;
                            Segmented {
                                items: ["VNDB", "Bangumi"];
                                current: Settings.metadata-provider == "bangumi" ? 1 : 0;
                                segment-width: 96px;
                                selected(i) => { Settings.metadata-provider = i == 1 ? "bangumi" : "vndb"; }
                            }
                        }
                    }
                    SwitchRow {
                        label: "下载敏感封面";
                        description: "";
                        checked: Settings.sensitive-covers;
                        toggled => {
                            Settings.sensitive-covers = !Settings.sensitive-covers;
                            Settings.set-sensitive-covers(Settings.metadata-provider, Settings.sensitive-covers);
                        }
                    }
                }
            }
        }
    }
}
