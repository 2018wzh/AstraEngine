import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Filters } from "../globals.slint";
import { Icon, Icons } from "../components/icons.slint";
import { GenericConfigForm } from "../components/generic-config.slint";

component PresetTile inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> preset-id;
    in property <bool> active: false;
    callback selected();

    min-height: 88px;
    border-radius: Theme.r-lg;
    background: active ? Theme.primary-container : (area.has-hover ? Theme.surface-high : Theme.surface-container);
    border-width: active ? 2px : 1px;
    border-color: active ? Theme.primary : Theme.outline-variant;
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { root.selected(); }
    animate background { duration: Theme.motion-fast; }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding: 14px;
        spacing: 4px;
        alignment: center;
        HorizontalLayout {
            spacing: 8px;
            Icon {
                glyph: root.active ? Icons.check : Icons.wand;
                font-size: 14px;
                color: root.active ? Theme.on-primary-container : Theme.on-variant;
                width: 18px;
            }
            Text {
                text: root.title;
                color: root.active ? Theme.on-primary-container : Theme.on-surface;
                font-size: Theme.title-sm;
                font-weight: 650;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.description;
            color: root.active ? Theme.on-primary-container : Theme.on-variant;
            font-size: Theme.body-sm;
            wrap: word-wrap;
        }
    }

    tile-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.selected();
                return accept;
            }
            return reject;
        }
        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                tile-focus.focus();
                root.selected();
            }
        }
    }
}

export component FilterPresetGrid inherits VerticalLayout {
    spacing: 10px;
    GridLayout {
        spacing: 10px;
        PresetTile {
            row: 0; col: 0;
            title: "原画";
            description: "不做处理";
            preset-id: "none";
            active: Filters.preset == "none";
            selected => { Filters.set-preset("none"); }
        }
        PresetTile {
            row: 0; col: 1;
            title: "平滑放大";
            description: "按倍率放大画面";
            preset-id: "scale";
            active: Filters.preset == "scale";
            selected => { Filters.set-preset("scale"); }
        }
        PresetTile {
            row: 1; col: 0;
            title: "锐化";
            description: "增强线条边缘";
            preset-id: "sharpen";
            active: Filters.preset == "sharpen";
            selected => { Filters.set-preset("sharpen"); }
        }
        PresetTile {
            row: 1; col: 1;
            title: "Anime4K";
            description: "修复并 2 倍放大";
            preset-id: "anime4k";
            active: Filters.preset == "anime4k";
            selected => { Filters.set-preset("anime4k"); }
        }
    }
    PresetTile {
        title: "外部效果文件";
        description: "从文件加载画面效果";
        preset-id: "external";
        active: Filters.preset == "external";
        selected => { Filters.load-source(); }
    }
}

export component FilterSettingsPage inherits Rectangle {
    background: Theme.surface;

    ScrollView {
        mouse-drag-pan-enabled: true;
        VerticalLayout {
            padding: 24px;
            spacing: 16px;
            alignment: start;
            Text {
                text: "画面滤镜";
                color: Theme.on-surface;
                font-size: Theme.headline;
                font-weight: 700;
            }
            FilterPresetGrid { }
            GenericConfigForm {
                fields: Filters.fields;
                form-title: "效果参数";
                field-changed(key, value) => { Filters.field-changed(key, value); }
                save => { Filters.save(); }
                reset => { Filters.reset(); }
            }
        }
    }
}
