// Filter settings sub-page - extracted from legacy filters overlay.

import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon, Icons } from "../components/icons.slint";
import { SettingsSectionHeader, SettingsDivider } from "../components/settings-card.slint";

component FilterPresetRow inherits Rectangle {
    in property <string> label;
    in property <string> preset-id;
    in property <bool> active: false;
    callback selected(string);

    height: 48px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.primary-muted : (preset-area.has-hover ? Theme.card-hover : transparent);
    border-width: active ? 1px : 0px;
    border-color: Theme.primary;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        Icon {
            glyph: active ? Icons.check : "";
            color: Theme.primary;
            font-size: 16px;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 22px;
        }

        Text {
            text: label;
            color: active ? Theme.primary : Theme.text;
            font-size: 14px;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    preset-area := TouchArea {
        clicked => { root.selected(root.preset-id); }
    }
}

export component FilterSettingsPage inherits Rectangle {
    in-out property <string> filter-preset: "none";
    callback set-filter-preset(string);

    background: Theme.background;

    ScrollView {
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            SettingsSectionHeader { title: "Final-frame filter"; }

            Text {
                text: "FVP does not expose stable layer metadata, so per-layer bindings are blocked and only final-frame presets are available.";
                color: Theme.text-muted;
                wrap: word-wrap;
                font-size: 12px;
            }

            SettingsDivider {}

            FilterPresetRow {
                label: "Off";
                preset-id: "none";
                active: root.filter-preset == "none";
                selected(id) => { root.set-filter-preset(id); }
            }

            FilterPresetRow {
                label: "Grayscale";
                preset-id: "grayscale";
                active: root.filter-preset == "grayscale";
                selected(id) => { root.set-filter-preset(id); }
            }

            FilterPresetRow {
                label: "CRT Soft";
                preset-id: "crt-soft";
                active: root.filter-preset == "crt-soft";
                selected(id) => { root.set-filter-preset(id); }
            }

            FilterPresetRow {
                label: "Warm";
                preset-id: "warm";
                active: root.filter-preset == "warm";
                selected(id) => { root.set-filter-preset(id); }
            }
        }
    }
}
