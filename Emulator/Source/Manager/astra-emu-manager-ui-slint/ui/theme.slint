import { Palette } from "std-widgets.slint";
import { App } from "./globals.slint";

export struct Accent {
    primary: color,
    on-primary: color,
    container: color,
    on-container: color,
    soft: color,
}

export global Theme {
    out property <bool> dark: App.dark;
    out property <color> system-accent: Palette.accent-background;
    out property <float> hue: system-accent.to-oklch().hue;
    out property <bool> compact-density: App.appearance.density == "compact";
    out property <duration> motion-fast: App.appearance.reduce-motion ? 0ms : 120ms;
    out property <duration> motion-medium: App.appearance.reduce-motion ? 0ms : 200ms;

    pure function t(l: float, c: float) -> color {
        return oklch(l, c, hue);
    }

    out property <color> surface: dark ? t(0.165, 0.008) : t(0.985, 0.004);
    out property <color> surface-low: dark ? t(0.195, 0.010) : t(0.966, 0.006);
    out property <color> surface-container: dark ? t(0.225, 0.012) : t(0.948, 0.008);
    out property <color> surface-high: dark ? t(0.262, 0.014) : t(0.928, 0.010);
    out property <color> surface-highest: dark ? t(0.300, 0.016) : t(0.905, 0.012);
    out property <color> on-surface: dark ? t(0.935, 0.008) : t(0.205, 0.010);
    out property <color> on-variant: dark ? t(0.775, 0.018) : t(0.430, 0.018);
    out property <color> outline: dark ? t(0.580, 0.018) : t(0.600, 0.018);
    out property <color> outline-variant: dark ? t(0.340, 0.018) : t(0.870, 0.012);
    out property <color> scrim: #000000a0;

    out property <color> primary: dark ? t(0.810, 0.110) : t(0.480, 0.150);
    out property <color> on-primary: dark ? t(0.300, 0.090) : #ffffff;
    out property <color> primary-container: dark ? t(0.360, 0.090) : t(0.925, 0.045);
    out property <color> on-primary-container: dark ? t(0.925, 0.045) : t(0.290, 0.100);

    out property <color> error: dark ? oklch(0.80, 0.11, 25) : oklch(0.52, 0.19, 27);
    out property <color> error-container: dark ? oklch(0.34, 0.09, 25) : oklch(0.93, 0.04, 25);
    out property <color> on-error-container: dark ? oklch(0.93, 0.04, 25) : oklch(0.32, 0.10, 27);

    public pure function accent(seed: color, is-dark: bool) -> Accent {
        let o = seed.to-oklch();
        let c = max(0.045, min(o.chroma, 0.14));
        return {
            primary: is-dark ? oklch(0.80, c, o.hue) : oklch(0.50, c + 0.01, o.hue),
            on-primary: is-dark ? oklch(0.25, c * 0.7, o.hue) : #ffffff,
            container: is-dark ? oklch(0.34, c * 0.7, o.hue) : oklch(0.92, c * 0.35, o.hue),
            on-container: is-dark ? oklch(0.92, c * 0.35, o.hue) : oklch(0.30, c * 0.8, o.hue),
            soft: is-dark ? oklch(0.26, c * 0.35, o.hue) : oklch(0.955, c * 0.18, o.hue),
        };
    }

    public pure function status-seed(status: string) -> color {
        return status == "perfect" ? oklch(0.6, 0.14, 160)
            : status == "completable" ? oklch(0.6, 0.12, 215)
            : status == "flawed" ? oklch(0.7, 0.14, 85)
            : status == "boot_only" ? oklch(0.65, 0.15, 50)
            : status == "unplayable" ? oklch(0.6, 0.17, 25)
            : oklch(0.6, 0.0, 0);
    }

    public pure function status-label(status: string) -> string {
        return status == "perfect" ? "完美"
            : status == "completable" ? "可通关"
            : status == "flawed" ? "有瑕疵"
            : status == "boot_only" ? "仅能启动"
            : status == "unplayable" ? "无法运行"
            : "未评级";
    }

    out property <length> r-xs: 4px;
    out property <length> r-sm: 8px;
    out property <length> r-md: 12px;
    out property <length> r-lg: 16px;
    out property <length> r-xl: 28px;

    out property <length> display: 32px;
    out property <length> headline: 26px;
    out property <length> title-lg: 20px;
    out property <length> title-md: 16px;
    out property <length> title-sm: 14px;
    out property <length> body: 14px;
    out property <length> body-sm: 13px;
    out property <length> label: 12px;
    out property <length> label-sm: 11px;

    out property <color> shadow: dark ? #00000090 : #1a1a3030;
    out property <color> shadow-strong: dark ? #000000c0 : #1a1a3050;
}
