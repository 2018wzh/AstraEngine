// AstraEMU Manager 重做设计稿：token 与组件。
// 仅供 slint-viewer 渲染静态稿，不参与 build.rs 编译。

import "../assets/fonts/fa-solid-900.ttf";
import { Palette } from "std-widgets.slint";

export struct Accent {
    primary: color,
    on-primary: color,
    container: color,
    on-container: color,
    soft: color,
}

export struct Game {
    title: string,
    studio: string,
    family: string,
    hours: string,
    status: string,
    c1: color,
    c2: color,
}

// 颜色、形状、字号、阴影。中性色与主色都由系统强调色色相派生，
// 与 Slint material 样式的控件保持同一色相。
export global Tok {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> system-accent: Palette.accent-background;
    out property <float> hue: system-accent.to-oklch().hue;

    pure function t(l: float, c: float) -> color {
        return oklch(l, c, hue);
    }

    out property <color> surface: dark ? t(0.165, 0.008) : t(0.985, 0.004);
    out property <color> surface-low: dark ? t(0.195, 0.010) : t(0.966, 0.006);
    out property <color> surface-container: dark ? t(0.225, 0.012) : t(0.948, 0.008);
    out property <color> surface-high: dark ? t(0.262, 0.014) : t(0.928, 0.010);
    out property <color> surface-highest: dark ? t(0.300, 0.016) : t(0.905, 0.012);
    out property <color> on-surface: dark ? t(0.935, 0.008) : t(0.205, 0.010);
    out property <color> on-variant: dark ? t(0.775, 0.018) : t(0.430, 0.018);
    out property <color> outline: dark ? t(0.580, 0.018) : t(0.600, 0.018);
    out property <color> outline-variant: dark ? t(0.340, 0.018) : t(0.870, 0.012);
    out property <color> scrim: #000000a0;

    out property <color> primary: dark ? t(0.810, 0.110) : t(0.480, 0.150);
    out property <color> on-primary: dark ? t(0.300, 0.090) : #ffffff;
    out property <color> primary-container: dark ? t(0.360, 0.090) : t(0.925, 0.045);
    out property <color> on-primary-container: dark ? t(0.925, 0.045) : t(0.290, 0.100);

    out property <color> error: dark ? oklch(0.80, 0.11, 25) : oklch(0.52, 0.19, 27);
    out property <color> error-container: dark ? oklch(0.34, 0.09, 25) : oklch(0.93, 0.04, 25);
    out property <color> on-error-container: dark ? oklch(0.93, 0.04, 25) : oklch(0.32, 0.10, 27);

    // 从任意种子色（封面主色、兼容性分级）生成一组对比度安全的强调色。
    public pure function accent(seed: color, is-dark: bool) -> Accent {
        let o = seed.to-oklch();
        let c = max(0.045, min(o.chroma, 0.14));
        return {
            primary: is-dark ? oklch(0.80, c, o.hue) : oklch(0.50, c + 0.01, o.hue),
            on-primary: is-dark ? oklch(0.25, c * 0.7, o.hue) : #ffffff,
            container: is-dark ? oklch(0.34, c * 0.7, o.hue) : oklch(0.92, c * 0.35, o.hue),
            on-container: is-dark ? oklch(0.92, c * 0.35, o.hue) : oklch(0.30, c * 0.8, o.hue),
            soft: is-dark ? oklch(0.26, c * 0.35, o.hue) : oklch(0.955, c * 0.18, o.hue),
        };
    }

    public pure function status-seed(status: string) -> color {
        return status == "perfect" ? oklch(0.6, 0.14, 160)
            : status == "completable" ? oklch(0.6, 0.12, 215)
            : status == "flawed" ? oklch(0.7, 0.14, 85)
            : status == "boot_only" ? oklch(0.65, 0.15, 50)
            : status == "unplayable" ? oklch(0.6, 0.17, 25)
            : oklch(0.6, 0.0, 0);
    }

    public pure function status-label(status: string) -> string {
        return status == "perfect" ? "完美"
            : status == "completable" ? "可通关"
            : status == "flawed" ? "有瑕疵"
            : status == "boot_only" ? "仅能启动"
            : status == "unplayable" ? "无法运行"
            : "未评级";
    }

    // 形状
    out property <length> r-xs: 4px;
    out property <length> r-sm: 8px;
    out property <length> r-md: 12px;
    out property <length> r-lg: 16px;
    out property <length> r-xl: 28px;

    // 字号
    out property <length> display: 32px;
    out property <length> headline: 26px;
    out property <length> title-lg: 20px;
    out property <length> title-md: 16px;
    out property <length> body: 14px;
    out property <length> body-sm: 13px;
    out property <length> label: 12px;
    out property <length> label-sm: 11px;

    // 阴影
    out property <color> shadow: dark ? #00000090 : #1a1a3030;
    out property <color> shadow-strong: dark ? #000000c0 : #1a1a3050;
}

export global G {
    out property <string> family: "Font Awesome 6 Free";
    out property <string> gamepad: "\u{f11b}";
    out property <string> microchip: "\u{f2db}";
    out property <string> gear: "\u{f013}";
    out property <string> info: "\u{f05a}";
    out property <string> search: "\u{f002}";
    out property <string> plus: "\u{f067}";
    out property <string> refresh: "\u{f021}";
    out property <string> play: "\u{f04b}";
    out property <string> xmark: "\u{f00d}";
    out property <string> check: "\u{f00c}";
    out property <string> more: "\u{f142}";
    out property <string> folder-open: "\u{f07c}";
    out property <string> arrow-left: "\u{f060}";
    out property <string> chevron-down: "\u{f078}";
    out property <string> chevron-right: "\u{f054}";
    out property <string> link: "\u{f0c1}";
    out property <string> clock: "\u{f017}";
    out property <string> calendar: "\u{f133}";
    out property <string> history: "\u{f1da}";
    out property <string> star: "\u{f005}";
    out property <string> wand: "\u{f72b}";
    out property <string> gauge: "\u{f624}";
    out property <string> language: "\u{f1ab}";
    out property <string> expand: "\u{f065}";
    out property <string> triangle: "\u{f071}";
    out property <string> circle-check: "\u{f058}";
    out property <string> circle-xmark: "\u{f057}";
    out property <string> palette: "\u{f53f}";
    out property <string> keyboard: "\u{f11c}";
    out property <string> volume: "\u{f028}";
    out property <string> database: "\u{f1c0}";
    out property <string> shield: "\u{f3ed}";
    out property <string> sort: "\u{f0dc}";
    out property <string> image: "\u{f03e}";
    out property <string> floppy: "\u{f0c7}";
    out property <string> tags: "\u{f02c}";
    out property <string> cube: "\u{f1b2}";
    out property <string> copy: "\u{f0c5}";
    out property <string> trash: "\u{f1f8}";
    out property <string> eye: "\u{f06e}";
}

export component Icon inherits Text {
    in property <string> glyph;
    text: root.glyph;
    font-family: G.family;
    font-weight: 900;
    font-size: 16px;
    color: Tok.on-variant;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// ===== 按钮 =====

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> variant: "filled"; // filled | tonal | outlined | text
    in property <color> fill: Tok.primary;
    in property <color> on-fill: Tok.on-primary;
    in property <bool> hovered: false;
    in property <length> h: 40px;
    in property <length> font: Tok.body-sm;

    height: h;
    min-width: content.preferred-width;
    border-radius: self.height / 2;
    background: variant == "filled" ? (hovered ? fill.mix(on-fill, 0.92) : fill)
        : variant == "tonal" ? (hovered ? Tok.surface-highest : Tok.surface-high)
        : hovered ? Tok.surface-high : transparent;
    border-width: variant == "outlined" ? 1px : 0px;
    border-color: Tok.outline-variant;
    drop-shadow-blur: variant == "filled" && hovered ? 6px : 0px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Tok.shadow;

    content := HorizontalLayout {
        padding-left: root.text == "" ? 12px : (root.glyph == "" ? 20px : 16px);
        padding-right: root.text == "" ? 12px : 20px;
        spacing: 8px;
        alignment: center;
        if root.glyph != "" : Icon {
            glyph: root.glyph;
            font-size: root.font;
            color: root.variant == "filled" ? root.on-fill : root.variant == "text" ? root.fill : Tok.on-surface;
        }
        if root.text != "" : Text {
            text: root.text;
            font-size: root.font;
            font-weight: 600;
            vertical-alignment: center;
            color: root.variant == "filled" ? root.on-fill : root.variant == "text" ? root.fill : Tok.on-surface;
        }
    }
}

export component IconBtn inherits Rectangle {
    in property <string> glyph;
    in property <string> variant: "standard"; // standard | tonal | filled
    in property <length> size: 40px;
    in property <bool> active: false;
    in property <bool> hovered: false;
    in property <color> tint: Tok.on-variant;

    width: size;
    height: size;
    border-radius: size / 2;
    background: variant == "filled" || active ? Tok.primary-container
        : variant == "tonal" ? (hovered ? Tok.surface-highest : Tok.surface-high)
        : hovered ? Tok.surface-high : transparent;
    Icon {
        glyph: root.glyph;
        font-size: root.size * 0.4;
        color: root.variant == "filled" || root.active ? Tok.on-primary-container : root.tint;
    }
}

// ===== 输入 =====

export component SearchBar inherits Rectangle {
    in property <string> placeholder: "搜索";
    in property <string> shortcut: "";
    in property <length> h: 48px;

    height: h;
    border-radius: h / 2;
    background: Tok.surface-high;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 8px;
        spacing: 12px;
        Icon { glyph: G.search; font-size: 15px; width: 18px; }
        Text {
            text: root.placeholder;
            color: Tok.on-variant;
            font-size: Tok.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.shortcut != "" : Rectangle {
            width: key.preferred-width + 14px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            border-width: 1px;
            border-color: Tok.outline-variant;
            key := Text {
                text: root.shortcut;
                color: Tok.on-variant;
                font-size: Tok.label-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle { width: 6px; }
    }
}

export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <string> count: "";
    in property <bool> selected: false;
    in property <string> glyph: "";

    height: 32px;
    width: row.preferred-width;
    border-radius: Tok.r-sm;
    background: selected ? Tok.primary-container : transparent;
    border-width: selected ? 0px : 1px;
    border-color: Tok.outline-variant;

    row := HorizontalLayout {
        padding-left: root.selected || root.glyph != "" ? 10px : 14px;
        padding-right: 14px;
        spacing: 6px;
        if root.selected : Icon { glyph: G.check; font-size: 11px; color: Tok.on-primary-container; }
        if !root.selected && root.glyph != "" : Icon { glyph: root.glyph; font-size: 11px; }
        Text {
            text: root.text;
            font-size: Tok.body-sm;
            font-weight: root.selected ? 600 : 500;
            color: root.selected ? Tok.on-primary-container : Tok.on-surface;
            vertical-alignment: center;
        }
        if root.count != "" : Text {
            text: root.count;
            font-size: Tok.label;
            color: root.selected ? Tok.on-primary-container : Tok.on-variant;
            vertical-alignment: center;
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> current: 0;
    in property <length> segment-width: 96px;

    height: 40px;
    width: segment-width * items.length;
    border-radius: 20px;
    border-width: 1px;
    border-color: Tok.outline;
    clip: true;

    for item[i] in root.items : Rectangle {
        x: i * root.segment-width;
        width: root.segment-width;
        height: root.height;
        background: i == root.current ? Tok.primary-container : transparent;
        if i > 0 : Rectangle { x: 0; width: 1px; height: parent.height; background: Tok.outline; }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            if i == root.current : Icon { glyph: G.check; font-size: 11px; color: Tok.on-primary-container; }
            Text {
                text: item;
                font-size: Tok.body-sm;
                font-weight: i == root.current ? 600 : 500;
                color: i == root.current ? Tok.on-primary-container : Tok.on-surface;
                vertical-alignment: center;
            }
        }
    }
}

export component Tabs inherits Rectangle {
    in property <[string]> items;
    in property <int> current: 0;
    in property <color> accent: Tok.primary;

    height: 48px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Tok.outline-variant; }
    HorizontalLayout {
        for item[i] in root.items : Rectangle {
            horizontal-stretch: 1;
            label := Text {
                text: item;
                font-size: Tok.body;
                font-weight: i == root.current ? 650 : 500;
                color: i == root.current ? root.accent : Tok.on-variant;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if i == root.current : Rectangle {
                width: label.preferred-width + 8px;
                height: 3px;
                x: (parent.width - self.width) / 2;
                y: parent.height - 3px;
                border-top-left-radius: 3px;
                border-top-right-radius: 3px;
                background: root.accent;
            }
        }
    }
}

// ===== 徽章 =====

// 封面上的徽章：深色半透明底 + 色点，任何封面上都清晰。
export component CoverBadge inherits Rectangle {
    in property <string> status;
    height: 22px;
    width: row.preferred-width;
    border-radius: 11px;
    background: #000000a8;
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 9px;
        spacing: 5px;
        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: Tok.accent(Tok.status-seed(root.status), true).primary;
        }
        Text {
            text: Tok.status-label(root.status);
            color: #ffffffee;
            font-size: Tok.label-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// 页面内的徽章：分级色 tonal 底。
export component StatusBadge inherits Rectangle {
    in property <string> status;
    property <Accent> a: Tok.accent(Tok.status-seed(status), Tok.dark);
    height: 26px;
    width: row.preferred-width;
    border-radius: 13px;
    background: a.container;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 11px;
        spacing: 6px;
        Icon {
            glyph: root.status == "unplayable" || root.status == "boot_only" ? G.triangle : G.circle-check;
            font-size: 11px;
            color: root.a.on-container;
        }
        Text {
            text: Tok.status-label(root.status);
            color: root.a.on-container;
            font-size: Tok.label;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component Tag inherits Rectangle {
    in property <string> text;
    in property <color> bg: Tok.surface-high;
    in property <color> fg: Tok.on-surface;
    height: 26px;
    width: t.preferred-width + 20px;
    border-radius: Tok.r-sm;
    background: bg;
    t := Text {
        text: root.text;
        color: root.fg;
        font-size: Tok.label;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ===== 封面 =====

// 占位封面：设计稿不使用商业封面，用渐变和几何形状模拟主色。
export component CoverArt inherits Rectangle {
    in property <Game> game;
    in property <bool> show-title: true;
    clip: true;
    background: @linear-gradient(155deg, game.c1 0%, game.c2 100%);

    Rectangle {
        x: parent.width * 0.38;
        y: -parent.width * 0.18;
        width: parent.width * 0.9;
        height: self.width;
        border-radius: self.width / 2;
        background: #ffffff1f;
    }
    Rectangle {
        x: -parent.width * 0.2;
        y: parent.height * 0.42;
        width: parent.width * 0.55;
        height: self.width;
        border-radius: self.width / 2;
        background: #ffffff12;
    }
    Rectangle {
        x: parent.width * 0.62;
        y: parent.height * 0.3;
        width: parent.width * 0.14;
        height: self.width;
        border-radius: self.width / 2;
        background: #ffffff40;
    }
    if root.show-title : Rectangle {
        y: parent.height * 0.55;
        height: parent.height * 0.45;
        background: @linear-gradient(180deg, #00000000 0%, #00000088 100%);
    }
    if root.show-title : Text {
        x: parent.width * 0.09;
        y: parent.height * 0.70;
        width: parent.width * 0.82;
        text: root.game.title;
        color: #ffffff;
        font-size: max(11px, parent.width * 0.085);
        font-weight: 700;
        wrap: word-wrap;
        letter-spacing: 0.5px;
    }
}

export component GameCard inherits Rectangle {
    in property <Game> game;
    in property <bool> hovered: false;
    in property <bool> selected: false;
    in property <Accent> select-accent: Tok.accent(game.c1, Tok.dark);
    out property <length> cover-h: self.width * 4 / 3;

    height: cover-h + 54px;

    cover-shadow := Rectangle {
        y: root.hovered ? -4px : 0px;
        height: root.cover-h;
        border-radius: Tok.r-md;
        background: root.game.c2;
        drop-shadow-blur: root.hovered ? 22px : 6px;
        drop-shadow-offset-y: root.hovered ? 10px : 2px;
        drop-shadow-color: root.hovered ? Tok.shadow-strong : Tok.shadow;

        Rectangle {
            border-radius: Tok.r-md;
            clip: true;
            CoverArt { game: root.game; width: parent.width; height: parent.height; }
            if root.game.status != "" : CoverBadge {
                x: 8px;
                y: 8px;
                status: root.game.status;
            }
            if root.hovered : Rectangle {
                background: @linear-gradient(180deg, #00000000 55%, #00000066 100%);
            }
            if root.hovered : Rectangle {
                width: 48px;
                height: 48px;
                x: parent.width - self.width - 12px;
                y: parent.height - self.height - 12px;
                border-radius: 16px;
                background: root.select-accent.primary;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 3px;
                drop-shadow-color: #00000070;
                Icon { glyph: G.play; font-size: 16px; color: root.select-accent.on-primary; x: 2px; }
            }
        }
        if root.selected : Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-radius: Tok.r-md + 4px;
            border-width: 3px;
            border-color: root.select-accent.primary;
        }
    }

    Text {
        y: root.cover-h + 10px;
        width: root.width;
        text: root.game.title;
        color: Tok.on-surface;
        font-size: Tok.body;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        y: root.cover-h + 31px;
        width: root.width;
        text: root.game.family + "  ·  " + (root.game.hours == "" ? "未开始" : root.game.hours);
        color: Tok.on-variant;
        font-size: Tok.label;
        overflow: elide;
    }
}

export component CoverGrid inherits Rectangle {
    in property <[Game]> games;
    in property <int> cols: 5;
    in property <length> gap: 20px;
    in property <length> row-gap: 24px;
    in property <int> hover-index: -1;
    in property <int> selected-index: -1;
    property <length> cw: (self.width - (cols - 1) * gap) / cols;
    property <length> rh: cw * 4 / 3 + 54px;

    for g[i] in root.games : GameCard {
        x: Math.mod(i, root.cols) * (root.cw + root.gap);
        y: Math.floor(i / root.cols) * (root.rh + root.row-gap);
        width: root.cw;
        game: g;
        hovered: i == root.hover-index;
        selected: i == root.selected-index;
    }
}

// ===== 导航 =====

component RailItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> active;
    height: 64px;
    Rectangle {
        width: 56px;
        height: 32px;
        x: (parent.width - self.width) / 2;
        y: 6px;
        border-radius: 16px;
        background: root.active ? Tok.primary-container : transparent;
        Icon {
            glyph: root.glyph;
            font-size: 17px;
            color: root.active ? Tok.on-primary-container : Tok.on-variant;
        }
    }
    Text {
        y: 42px;
        width: parent.width;
        text: root.text;
        font-size: Tok.label;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Tok.on-surface : Tok.on-variant;
        horizontal-alignment: center;
    }
}

export component BrandMark inherits Rectangle {
    in property <length> size: 44px;
    width: size;
    height: size;
    border-radius: size * 0.3;
    background: @linear-gradient(140deg, Tok.primary 0%, oklch(0.68, 0.13, Tok.hue + 50) 100%);
    Text {
        text: "A";
        color: Tok.on-primary;
        font-size: root.size * 0.5;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component NavRail inherits Rectangle {
    in property <int> current: 0;
    width: 88px;
    background: Tok.surface-low;

    BrandMark { x: (parent.width - self.width) / 2; y: 20px; }

    for item[i] in [
        { g: G.gamepad, t: "游戏库" },
        { g: G.microchip, t: "核心" },
        { g: G.gear, t: "设置" },
        { g: G.info, t: "关于" },
    ] : RailItem {
        y: 92px + i * 72px;
        width: root.width;
        glyph: item.g;
        text: item.t;
        active: i == root.current;
    }
}

export component BottomNav inherits Rectangle {
    in property <int> current: 0;
    height: 80px;
    background: Tok.surface-container;
    HorizontalLayout {
        padding-top: 8px;
        for item[i] in [
            { g: G.gamepad, t: "游戏库" },
            { g: G.microchip, t: "核心" },
            { g: G.gear, t: "设置" },
            { g: G.info, t: "关于" },
        ] : RailItem {
            horizontal-stretch: 1;
            glyph: item.g;
            text: item.t;
            active: i == root.current;
        }
    }
}

// ===== 内容块 =====

export component SectionTitle inherits Text {
    color: Tok.on-surface;
    font-size: Tok.title-md;
    font-weight: 650;
}

export component Card inherits Rectangle {
    in property <length> pad: 20px;
    border-radius: Tok.r-lg;
    background: Tok.surface-container;
}

export component StatTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> value;
    in property <color> tint: Tok.primary;
    height: 72px;
    border-radius: Tok.r-md;
    background: Tok.surface-container;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Icon { glyph: root.glyph; font-size: 11px; color: root.tint; }
            Text { text: root.label; font-size: Tok.label; color: Tok.on-variant; vertical-alignment: center; }
        }
        Text { text: root.value; font-size: Tok.title-md; font-weight: 700; color: Tok.on-surface; }
    }
}

export component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text { text: root.label; width: 76px; color: Tok.on-variant; font-size: Tok.body-sm; }
    Text { text: root.value; color: Tok.on-surface; font-size: Tok.body-sm; wrap: word-wrap; horizontal-stretch: 1; }
}

export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> divider: true;
    min-height: 72px;
    if root.divider : Rectangle { x: 20px; y: 0; width: parent.width - 40px; height: 1px; background: Tok.outline-variant; }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text { text: root.title; color: Tok.on-surface; font-size: Tok.body; font-weight: 550; }
            if root.desc != "" : Text { text: root.desc; color: Tok.on-variant; font-size: Tok.body-sm; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout { alignment: center; @children }
        }
    }
}
