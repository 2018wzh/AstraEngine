// ---- Game view ----

export component GameLaunching inherits ManagerWindow {
    init => { Mock.session("opening"); }
}

export component GameMenuFocused inherits ManagerWindow {
    init => {
        Mock.session("running");
        Session.menu-page = "main";
        Session.menu-open = true;
    }
}

// ---- Overlays ----

export component FatalDialog inherits ManagerWindow {
    init => {
        Mock.library(false);
        Dialogs.fatal-title = "模拟器核心意外停止";
        Dialogs.fatal-detail = "Astra Musica 在读取 data02.paz 时崩溃。存档不受影响；可以重试，或在 设置→核心 查看日志。";
        Dialogs.fatal-code = "ASTRA_EMU_CORE_PANIC";
        Dialogs.fatal-retryable = true;
        Dialogs.fatal-active = true;
    }
}

export component SnackbarUndo inherits ManagerWindow {
    init => {
        Mock.library(false);
        App.appearance.reduce-motion = true;
        Notices.snackbar-text = "已从资料库移除《魔女的夜宴》";
        Notices.snackbar-action = "撤销";
        Notices.snackbar-serial += 1;
    }
}
