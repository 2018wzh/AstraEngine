export component LibraryDesktopDark inherits ManagerWindow {
    init => {
        App.appearance = { theme-mode: "dark", density: "comfortable", cover-size: "medium", view-mode: "grid", reduce-motion: false, cover-badges: true };
        App.page = "library";
        App.version = "0.1.0";
        App.build = "harness";
        Library.cores-ready = true;
        Library.games = Data.games;
    }
}

export component ListDesktopLight inherits ManagerWindow {
    init => {
        App.appearance = { theme-mode: "light", density: "comfortable", cover-size: "medium", view-mode: "list", reduce-motion: false, cover-badges: true };
        App.page = "library";
        Library.cores-ready = true;
        Library.games = Data.games;
