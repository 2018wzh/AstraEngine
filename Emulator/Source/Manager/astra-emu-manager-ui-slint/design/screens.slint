        Library.detail-open = true;
        Library.detail-tab = 0;
        Selection.tint = #f4a259;
        Selection.game = {
            id: "g1", title: "夏影ノスタルジア", family: "FVP", emulator: "FVP", launchable: true, problem: "",
            play-time: "31 小时", last-played: "昨天", developer: "Natsukage", release-date: "2014 年 7 月 25 日",
            platforms: "Windows", engine: "FVP", description: "海边小镇的夏天，一封寄错的信让四个许久不见的人重新相遇。多视角叙事，共 5 条路线与 2 个结局。",
            tags: "恋爱 · 夏日 · 多结局", aliases: "Natsukage Nostalgia",
        };
        Selection.compat = { status: "perfect", notes: "", updated: "2026 年 10 月 3 日", vndb-id: "v20317" };
        Selection.bangumi-summary = "同步需手动点击，不会自动上传。";
    }
}

