}

export component DetailDesktopLight inherits ManagerWindow {
    init => {
        App.appearance = { theme-mode: "light", density: "comfortable", cover-size: "medium", view-mode: "grid", reduce-motion: false, cover-badges: true };
        App.page = "library";
        Library.cores-ready = true;
        Library.games = Data.games;
