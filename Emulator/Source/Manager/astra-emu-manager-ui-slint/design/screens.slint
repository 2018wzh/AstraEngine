        Session.active = true;
        Session.menu-open = true;
        Session.menu-page = "main";
        Session.actions = Data.actions;
        Session.title = "星尘之誓";
    }
    Timer {
        interval: 16ms;
        running: true;
        triggered => {
            Session.menu-open = true;
            self.running = false;
        }
    }
}

