              "type": "null"
            }
          ]
        },
        "damage": {
          "$ref": "#/definitions/LegacySurfaceDamageV9"
        },
        "filter_graph": {
          "anyOf": [
            {
              "$ref": "#/definitions/LegacyFilterGraphV9"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "$ref": "#/definitions/LegacySurfaceFormatV9"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "layer_id": {
          "type": "string"
        },
        "opacity": {
          "type": "number",
          "format": "float"
        },
        "role": {
          "type": "string"
        },
        "stride": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "surface_id": {
          "type": "string"
        },
        "texture_filter": {
          "$ref": "#/definitions/LegacyLayerFilterV9"
        },
        "transform": {
          "$ref": "#/definitions/LegacyLayerTransformV9"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "z_index": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "LegacyLayerTransformV9": {
      "type": "object",
      "required": [
        "m11",
        "m12",
        "m21",
        "m22",
        "tx",
        "ty"
      ],
      "properties": {
        "m11": {
          "type": "number",
          "format": "float"
        },
        "m12": {
          "type": "number",
          "format": "float"
        },
        "m21": {
          "type": "number",
          "format": "float"
        },
        "m22": {
          "type": "number",
          "format": "float"
        },
        "tx": {
          "type": "number",
          "format": "float"
        },
        "ty": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "LegacySurfaceDamageV9": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unchanged"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "full"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "rects"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "rects"
