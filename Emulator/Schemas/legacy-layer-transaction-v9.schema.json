          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "input": {
          "$ref": "#/definitions/LegacyFilterTargetV9"
        },
        "kind": {
          "type": "string"
        },
        "output": {
          "$ref": "#/definitions/LegacyFilterTargetV9"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LegacyFilterParamEntryV9"
          }
        }
      }
    },
    "LegacyFilterParamEntryV9": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/LegacyFilterParamV9"
        }
      }
    },
    "LegacyFilterParamV9": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "float"
              ]
            },
            "value": {
              "type": "number",
              "format": "float"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "int"
              ]
            },
            "value": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "bool"
              ]
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "LegacyFilterTargetV9": {
      "type": "string",
      "enum": [
        "background",
        "character",
        "ui",
        "text",
        "video",
        "final"
      ]
    },
    "LegacyLayerBlendV9": {
      "type": "string",
      "enum": [
        "opaque",
        "alpha",
        "add",
        "multiply",
        "screen"
      ]
    },
    "LegacyLayerFilterV9": {
      "type": "string",
      "enum": [
        "nearest",
        "linear"
      ]
    },
    "LegacyLayerOperationV9": {
      "oneOf": [
        {
          "type": "object",
