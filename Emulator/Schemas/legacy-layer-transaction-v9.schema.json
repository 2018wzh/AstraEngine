              "$ref": "#/definitions/LegacyLayerStateV9"
            },
            "operation": {
              "type": "string",
              "enum": [
                "create"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "layer",
            "operation"
          ],
          "properties": {
            "layer": {
              "$ref": "#/definitions/LegacyLayerStateV9"
            },
            "operation": {
              "type": "string",
              "enum": [
                "update"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "layer",
            "operation"
          ],
          "properties": {
            "layer": {
              "type": "object",
              "required": [
                "layer_id"
              ],
              "properties": {
                "layer_id": {
                  "type": "string"
                }
              }
            },
            "operation": {
              "type": "string",
              "enum": [
                "destroy"
              ]
            }
          }
        }
      ]
    },
    "LegacyLayerStateV9": {
      "type": "object",
      "required": [
        "blend",
        "damage",
        "format",
        "generation",
        "height",
        "layer_id",
        "opacity",
        "role",
        "stride",
        "surface_id",
        "texture_filter",
        "transform",
        "width",
        "z_index"
      ],
      "properties": {
        "blend": {
          "$ref": "#/definitions/LegacyLayerBlendV9"
        },
        "clip": {
          "anyOf": [
            {
              "$ref": "#/definitions/LegacyDamageRectV9"
            },
