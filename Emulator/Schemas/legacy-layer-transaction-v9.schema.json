{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LegacyLayerTransactionV9",
  "type": "object",
  "required": [
    "operations",
    "sequence",
    "viewport_height",
    "viewport_width"
  ],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LegacyLayerOperationV9"
      }
    },
    "sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "viewport_height": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "viewport_width": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "LegacyDamageRectV9": {
      "type": "object",
      "required": [
        "height",
        "width",
        "x",
        "y"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "LegacyFilterGraphV9": {
      "type": "object",
      "required": [
        "nodes",
        "schema"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LegacyFilterNodeV9"
