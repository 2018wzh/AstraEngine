{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmuPlatformRunEvidenceV1",
  "type": "object",
  "required": [
    "architecture",
    "audio_non_silent",
    "build_identity_hash",
    "coverage_ids",
    "diagnostic_codes",
    "evidence_level",
    "host_kind",
    "input_count",
    "lifecycle_steps",
    "package_hash",
    "platform",
    "presented_frame_count",
    "profile_hash",
    "schema",
    "status",
    "terminal_observed",
    "visual_changed"
  ],
  "properties": {
    "architecture": {
      "type": "string"
    },
    "audio_non_silent": {
      "type": "boolean"
    },
    "build_identity_hash": {
      "$ref": "#/definitions/Hash256"
    },
    "coverage_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_level": {
      "type": "string"
    },
    "host_kind": {
      "type": "string"
    },
    "input_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "lifecycle_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package_hash": {
      "$ref": "#/definitions/Hash256"
    },
    "platform": {
      "type": "string"
    },
    "presented_frame_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "profile_hash": {
      "$ref": "#/definitions/Hash256"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "terminal_observed": {
      "type": "boolean"
    },
    "visual_changed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Hash256": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    }
  }
}
