{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LegacyStepInput",
  "type": "object",
  "required": [
    "await_results",
    "delta_ns",
    "input_edges",
    "mode",
    "provider_results",
    "session_seed",
    "tick_index"
  ],
  "properties": {
    "await_results": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LegacyAwaitResult"
      }
    },
    "confirmation": {
      "description": "Result of one family-owned confirmation published through the Host.\n\nThe Host presents the transaction asynchronously and returns exactly one accepted or cancelled result on a later fixed step. Confirmation text is ephemeral presentation data and must not enter reports, logs, replay or save state.",
      "anyOf": [
        {
          "$ref": "#/definitions/LegacyConfirmationResultV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "delta_ns": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "input_edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LegacyInputEdge"
      }
    },
    "mode": {
      "$ref": "#/definitions/LegacyReplayMode"
    },
    "provider_results": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LegacyProviderResult"
      }
    },
    "session_seed": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "system_command": {
      "description": "Completion of one family-owned system command applied by the Host. The command itself is published through `LegacySystemCommandHostV1`; only the bounded status crosses back into the fixed-step input.",
      "anyOf": [
        {
          "$ref": "#/definitions/LegacySystemCommandResultV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "system_menu": {
      "description": "A host-originated request to open the family-owned system menu.\n\nThis is intentionally separate from the generic input-edge stream: opening a system menu is a semantic family operation, not a keyboard alias.  The request remains optional so families that do not expose a system menu can reject it explicitly instead of guessing from a key.",
      "anyOf": [
        {
          "$ref": "#/definitions/LegacySystemMenuRequestV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "tick_index": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "LegacyAwaitResult": {
      "type": "object",
      "required": [
        "payload_len",
        "sequence",
        "status",
        "token_id"
      ],
      "properties": {
        "payload_len": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "status": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        }
      }
    },
    "LegacyConfirmationChoiceV1": {
      "type": "string",
      "enum": [
        "accepted",
        "cancelled"
      ]
    },
    "LegacyConfirmationResultV1": {
      "type": "object",
      "required": [
        "choice",
        "confirmation_id",
        "sequence"
      ],
      "properties": {
        "choice": {
          "$ref": "#/definitions/LegacyConfirmationChoiceV1"
        },
        "confirmation_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "LegacyInputEdge": {
      "type": "object",
      "required": [
        "control",
        "pressed",
        "sequence",
        "value"
      ],
      "properties": {
        "control": {
          "type": "string"
        },
        "pressed": {
          "type": "boolean"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "value": {
          "type": "number",
          "format": "float"
        }
      }
    },
    "LegacyProviderResult": {
      "type": "object",
      "required": [
        "payload_len",
        "provider_id",
        "request_id",
        "sequence",
        "status"
      ],
      "properties": {
        "payload_len": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "provider_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "status": {
          "type": "string"
        }
      }
    },
    "LegacyReplayMode": {
      "type": "string",
      "enum": [
        "live"
      ]
    },
    "LegacySystemCommandResultV1": {
      "type": "object",
      "required": [
        "command_id",
        "sequence",
        "status"
      ],
      "properties": {
        "command_id": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "status": {
          "$ref": "#/definitions/LegacySystemCommandStatusV1"
        }
      }
    },
    "LegacySystemCommandStatusV1": {
      "type": "string",
      "enum": [
        "applied",
        "rejected",
        "unsupported"
      ]
    },
    "LegacySystemMenuActionV1": {
      "description": "Typed semantic request emitted by a host when the physical secondary pointer button opens the family-owned system menu.",
      "type": "string",
      "enum": [
        "open",
        "select",
        "dismiss"
      ]
    },
    "LegacySystemMenuRequestV1": {
      "type": "object",
      "required": [
        "action",
        "sequence"
      ],
      "properties": {
        "action": {
          "$ref": "#/definitions/LegacySystemMenuActionV1"
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "menu_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pointer_x": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "pointer_y": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
