{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranslationProfile",
  "type": "object",
  "required": [
    "base_url",
    "context_chars",
    "context_segments",
    "custom_prompt",
    "model",
    "openai_api",
    "profile_id",
    "provider",
    "secret_reference",
    "target_language",
    "timeout_ms"
  ],
  "properties": {
    "base_url": {
      "type": "string"
    },
    "context_chars": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "context_segments": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "custom_prompt": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "openai_api": {
      "$ref": "#/definitions/OpenAiApi"
    },
    "profile_id": {
      "type": "string"
    },
    "provider": {
      "$ref": "#/definitions/TranslationProvider"
    },
    "secret_reference": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "timeout_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "OpenAiApi": {
      "type": "string",
      "enum": [
        "responses",
        "chat_completions"
      ]
    },
    "TranslationProvider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "google"
      ]
    }
  }
}
