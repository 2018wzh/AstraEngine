{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FvpSyscallCoverageEvidence",
  "type": "object",
  "required": [
    "covered_syscall_ids",
    "diagnostic_codes",
    "full_flow_completed",
    "missing_syscall_ids",
    "opcode_counts",
    "release_syscall_total",
    "rfvp_revision",
    "schema",
    "status"
  ],
  "properties": {
    "covered_syscall_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "full_flow_completed": {
      "type": "boolean"
    },
    "missing_syscall_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opcode_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      }
    },
    "release_syscall_total": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "rfvp_revision": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
